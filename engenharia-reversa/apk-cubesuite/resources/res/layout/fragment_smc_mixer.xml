<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/smc_header"
            android:background="@color/D7D7D7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="end"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/big_text"
                    android:textColor="@color/white"
                    android:id="@+id/smc_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textSize="@dimen/big_text"
                    android:textColor="@color/white"
                    android:id="@+id/smc_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:layout_marginEnd="35dp"/>
            </LinearLayout>&gt; 
        </LinearLayout>
        <TextView
            android:textSize="@dimen/big_text"
            android:textColor="@color/accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/knob"/>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/knobLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <TextView
            android:textSize="@dimen/big_text"
            android:textColor="@color/accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/slider"/>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/sliderLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <TextView
            android:textSize="@dimen/big_text"
            android:textColor="@color/accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trackButton"/>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <GridLayout
                android:orientation="vertical"
                android:id="@+id/trackButtonLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rowCount="4"
                android:columnCount="8"/>
        </HorizontalScrollView>
        <TextView
            android:textSize="@dimen/big_text"
            android:textColor="@color/accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/globButton"/>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/globButtonLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
