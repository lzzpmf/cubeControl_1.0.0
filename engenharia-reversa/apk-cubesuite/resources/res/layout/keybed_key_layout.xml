<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    style="@style/linearStyle">
    <TextView
        android:id="@+id/index"
        style="@style/midikeyboardItemText"/>
    <EditText
        android:id="@+id/mpcValue"
        android:hint="@string/_0_127"
        android:layout_weight="3"
        style="@style/numInputStyle"/>
    <TextView
        android:id="@+id/mpcText"
        android:layout_weight="3"
        style="@style/midikeyboardItemText"/>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_gravity="center"
        android:id="@+id/mpcSwitch"
        android:layout_weight="3"
        android:paddingEnd="5dp"
        style="@style/switchStyle.external"/>
</LinearLayout>
