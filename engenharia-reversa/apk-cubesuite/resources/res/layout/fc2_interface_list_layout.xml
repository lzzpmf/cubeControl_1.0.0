<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/background"
    android:padding="@dimen/padding_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/dominantHue"
                android:id="@+id/footSwitchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/padInterface"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.cubeSuite.customControl.ButtonIconView
                android:textSize="@dimen/big_text"
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                style="@style/labelButton"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:background="@color/dominantHue"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="end"
            android:padding="@dimen/padding_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.cubeSuite.customControl.ButtonIconView
                android:id="@+id/plusMidiCode"
                android:text="@string/plus"
                android:layout_marginEnd="30dp"
                style="@style/iconBtn"/>
            <com.cubeSuite.customControl.ButtonIconView
                android:id="@+id/deleteList"
                android:text="@string/delete"
                style="@style/iconBtn"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/midiInfoListScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/midiInfoList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </ScrollView>
</LinearLayout>
