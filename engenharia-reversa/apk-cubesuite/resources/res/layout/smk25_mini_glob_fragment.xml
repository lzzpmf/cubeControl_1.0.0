<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/smk25_mini_glob_fragment_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/margin_default">
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/keycurve"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/Arr1234"
            android:id="@+id/keyCurve"
            android:tag="binding_1"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/port"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/ArrPort"
            android:id="@+id/port"
            android:tag="binding_2"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
</LinearLayout>
