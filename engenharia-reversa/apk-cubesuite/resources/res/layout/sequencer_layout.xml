<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/background"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.cubeSuite.customControl.ButtonIconView
                android:textSize="@dimen/big_text"
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/back"
                android:layout_marginEnd="@dimen/margin_default"
                style="@style/labelButton"/>
            <com.cubeSuite.customControl.ButtonIconView
                android:textSize="@dimen/big_text"
                android:id="@+id/share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share"
                style="@style/labelButton"/>
            <com.cubeSuite.customControl.ButtonIconView
                android:textSize="@dimen/big_text"
                android:id="@+id/loadDrum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loadIcon"
                android:layout_marginEnd="@dimen/margin_default"
                style="@style/labelButton"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/pageSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.cubeSuite.customControl.HistogramView
                android:layout_gravity="center"
                android:id="@+id/linkageHistogram"
                android:visibility="invisible"
                android:layout_width="100dp"
                android:layout_height="21dp"
                app:BlockColor="@color/dominantHue"/>
            <com.cubeSuite.customControl.ButtonIconView
                android:textSize="@dimen/big_text"
                android:id="@+id/saveDrumData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/saveAll"
                style="@style/labelButton"/>
            <com.cubeSuite.customControl.ButtonIconView
                android:textSize="@dimen/big_text"
                android:id="@+id/btnLoadDrumList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drum-01"
                style="@style/labelButton"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom"
        android:layout_below="@+id/head">
        <com.cubeSuite.customControl.ScrollViewPlus
            android:id="@+id/toneSV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/toneStrList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.cubeSuite.customControl.ScrollViewPlus>
        <com.cubeSuite.customControl.ScrollViewPlus
            android:id="@+id/blockSV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/blockList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.cubeSuite.customControl.ScrollViewPlus>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textColor="@color/dominantHue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/velocity"
            android:layout_marginStart="@dimen/margin_default"/>
        <com.cubeSuite.customControl.ButtonIconView
            android:id="@+id/velocity"
            android:layout_width="80dp"
            android:text="@string/handUp"
            style="@style/iconBtn"/>
        <com.cubeSuite.customControl.ButtonIconView
            android:id="@+id/subVelocity"
            android:text="@string/minus"
            style="@style/iconBtn"/>
        <Button
            android:id="@+id/velocityText"
            android:layout_width="60dp"
            android:layout_height="35dp"
            android:text="150"
            style="@style/generalBtn"/>
        <com.cubeSuite.customControl.ButtonIconView
            android:id="@+id/addVelocity"
            android:text="@string/plus"
            android:layout_marginEnd="@dimen/margin_default"
            style="@style/iconBtn"/>
        <com.cubeSuite.customControl.ButtonIconView
            android:id="@+id/subBeat"
            android:text="@string/minus"
            style="@style/iconBtn"/>
        <TextView
            android:textColor="@color/accent"
            android:id="@+id/beatText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/undefined"/>
        <com.cubeSuite.customControl.ButtonIconView
            android:id="@+id/addBeat"
            android:text="@string/plus"
            style="@style/iconBtn"/>
        <com.cubeSuite.customControl.ButtonIconView
            android:id="@+id/playBeat"
            android:text="@string/play"
            android:layout_marginStart="@dimen/margin_default"
            android:layout_marginEnd="@dimen/margin_default"
            style="@style/iconBtn"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/powerStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">
            <RadioButton
                android:id="@+id/power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/power"
                style="@style/radioBlockBtn"/>
            <RadioButton
                android:id="@+id/step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"
                android:text="@string/step"
                style="@style/radioBlockBtn"/>
        </RadioGroup>
    </LinearLayout>
</RelativeLayout>
