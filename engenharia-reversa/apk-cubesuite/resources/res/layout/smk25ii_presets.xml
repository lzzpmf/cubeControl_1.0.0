<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/smk25ii_presets_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/margin_default">
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/preset"
            style="@style/midikeyboardItemText"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2">
            <TextView
                android:textColor="@color/white"
                android:layout_gravity="end"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <SeekBar
                android:id="@+id/preset"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="7"
                style="@style/Widget.AppCompat.SeekBar.Discrete"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textColor="@color/dominantHue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/saveConfigExplain"/>
    <Button
        android:layout_gravity="center"
        android:tag="binding_3"
        android:layout_margin="10dp"
        android:text="@string/saveConfig"
        style="@style/btn"/>
    <TextView
        android:textColor="@color/dominantHue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resetConfigExplain"/>
    <Button
        android:layout_gravity="center"
        android:tag="binding_4"
        android:layout_margin="10dp"
        android:text="@string/resetFactory"
        style="@style/btn"/>
    <View
        android:background="@color/dominantHue"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="@dimen/big_text"
        android:textColor="@color/dominantHue"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/usr"/>
    <FrameLayout
        android:id="@+id/usrFragment"
        android:background="@drawable/background_gradual"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        class="androidx.viewpager.widget.ViewPager"/>
</LinearLayout>
