<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/sc_ch_fragment_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/margin_default">
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/type"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/ArrMajorMinor"
            android:id="@+id/type"
            android:tag="binding_1"
            android:layout_height="match_parent"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/scale"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/ArrScale"
            android:id="@+id/keyCurve"
            android:tag="binding_2"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/chord"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/ArrChord"
            android:id="@+id/chord"
            android:tag="binding_3"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
</LinearLayout>
