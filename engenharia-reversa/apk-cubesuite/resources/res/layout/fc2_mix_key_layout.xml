<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/background"
    android:padding="@dimen/padding_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/dominantHue"
                android:id="@+id/footSwitchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/footSwitchA"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.cubeSuite.customControl.ButtonIconView
                android:textSize="@dimen/big_text"
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                style="@style/labelButton"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginBottom="10dp">
        <LinearLayout
            android:background="@color/dominantHue"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatSpinner
                android:entries="@array/comb_csa"
                android:id="@+id/mixKeyTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/mixKeyKeyTuner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp">
        <LinearLayout
            android:background="@color/dominantHue"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatSpinner
                android:entries="@array/comb_csa"
                android:id="@+id/tunerSpinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mixKeyKeyboard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/dominantHue"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/combo1"
                android:layout_marginEnd="5dp"/>
            <LinearLayout
                android:background="@color/dominantHue"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/comb_csa"
                    android:id="@+id/comb1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/dominantHue"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/combo2"
                android:layout_marginEnd="5dp"/>
            <LinearLayout
                android:background="@color/dominantHue"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/comb_csa"
                    android:id="@+id/comb2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/dominantHue"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/combo3"
                android:layout_marginEnd="5dp"/>
            <LinearLayout
                android:background="@color/dominantHue"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/comb_csa"
                    android:id="@+id/comb3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/dominantHue"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:text="@string/KeyCombinationError"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mixKeyMidi"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_default">
            <Button
                android:id="@+id/modeSwitch"
                android:text="@string/singleStepOne"
                style="@style/generalBtn"/>
        </LinearLayout>
        <View
            android:background="@color/dominantHue"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/midiGroup"
                android:padding="@dimen/padding_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/midiA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:button="@null"
                    android:text="@string/midiA"
                    style="@style/radioBlockBtn"/>
                <RadioButton
                    android:id="@+id/midiB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/midiB"
                    style="@style/radioBlockBtn"/>
            </RadioGroup>
            <LinearLayout
                android:gravity="end"
                android:padding="@dimen/padding_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.cubeSuite.customControl.ButtonIconView
                    android:id="@+id/plusMidiCode"
                    android:text="@string/plus"
                    android:layout_marginEnd="30dp"
                    style="@style/iconBtn"/>
                <com.cubeSuite.customControl.ButtonIconView
                    android:id="@+id/deleteList"
                    android:text="@string/delete"
                    style="@style/iconBtn"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:id="@+id/midiInfoListScrollA"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/midiInfoListA"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </ScrollView>
            <ScrollView
                android:id="@+id/midiInfoListScrollB"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/midiInfoListB"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
