<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/glob_fragment_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/margin_default">
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/padcurve"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/Arr1234"
            android:id="@+id/padCurve"
            android:tag="binding_1"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/keycurve"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/Arr1234"
            android:id="@+id/keyCurve"
            android:tag="binding_2"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:layout_gravity="center"
            android:text="@string/pitchStep"
            style="@style/midikeyboardItemText"/>
        <EditText
            android:id="@+id/gate"
            android:tag="binding_3"
            android:hint="@string/_0_255"
            style="@style/numInputStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/padAftertouch"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/padAfterTouch"
            android:tag="binding_4"
            style="@style/switchStyle.external"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/port"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/ArrPort"
            android:id="@+id/port"
            android:tag="binding_5"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
</LinearLayout>
