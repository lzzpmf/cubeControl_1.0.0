<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/background"
    android:padding="@dimen/padding_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/dominantHue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/selectWorkMode"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.cubeSuite.customControl.ButtonIconView
                android:textSize="@dimen/big_text"
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                style="@style/labelButton"/>
        </LinearLayout>
    </FrameLayout>
    <com.cubeSuite.customControl.SelectItem
        android:id="@+id/singleStepOneMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:TvInfo="@string/singleStepOneInfo"
        app:TvTitle="@string/singleStepOne"/>
    <com.cubeSuite.customControl.SelectItem
        android:id="@+id/singleStepTwoMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:TvInfo="@string/singleStepTwoInfo"
        app:TvTitle="@string/singleStepTwo"/>
    <com.cubeSuite.customControl.SelectItem
        android:id="@+id/onTheLooseTwoMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:TvInfo="@string/onTheLooseTwoInfo"
        app:TvTitle="@string/onTheLooseTwo"/>
    <com.cubeSuite.customControl.SelectItem
        android:id="@+id/longOnMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:TvInfo="@string/longOnInfo"
        app:TvTitle="@string/longOn"/>
    <com.cubeSuite.customControl.SelectItem
        android:id="@+id/singleOrLongOnMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:TvInfo="@string/singleOrLongOnInfo"
        app:TvTitle="@string/singleOrLongOn"/>
</LinearLayout>
