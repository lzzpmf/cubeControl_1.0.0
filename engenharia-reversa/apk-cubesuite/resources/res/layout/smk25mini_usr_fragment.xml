<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/smk25mini_usr_fragment_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_default">
        <RadioGroup
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/typeRadio"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:checkedButton="@+id/padBtn">
            <RadioButton
                android:text="@string/keybed"
                style="@style/radioBtn"/>
            <RadioButton
                android:text="@string/knob"
                style="@style/radioBtn"/>
            <RadioButton
                android:text="@string/sus"
                style="@style/radioBtn"/>
            <RadioButton
                android:text="@string/utility"
                style="@style/radioBtn"/>
        </RadioGroup>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/keybed"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/channel"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/channelArray"
                    android:id="@+id/keybedChannel"
                    android:tag="binding_2"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/keycurve"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/Arr1234"
                    android:id="@+id/keyCurve"
                    android:tag="binding_3"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/octive"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/f3_3"
                    android:id="@+id/octive"
                    android:tag="binding_4"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/transpose"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/f12_12"
                    android:id="@+id/transpose"
                    android:tag="binding_5"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/minVel"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/keybedMinVel"
                    android:tag="binding_6"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/maxVel"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/keybedMaxVel"
                    android:tag="binding_7"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/knobs"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/type"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/ArrSmk25MiniKnobType"
                    android:id="@+id/knobType"
                    android:tag="binding_8"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/speed"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/ArrKnobSpeed"
                    android:tag="binding_9"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/channel"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/channelArray"
                    android:tag="binding_10"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/knobCCLayout"
                style="@style/linearStyle">
                <TextView
                    android:text="@string/cc"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:tag="binding_11"
                    android:hint="@string/_0_127"
                    android:layout_weight="4"
                    style="@style/numInputStyle"/>
                <TextView
                    android:id="@+id/knobCCStr"
                    android:tag="binding_12"
                    android:layout_weight="3"
                    style="@style/midikeyboardItemText"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:id="@+id/knobMinText"
                    android:tag="binding_13"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/knobMinVal"
                    android:tag="binding_14"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:id="@+id/knobMaxText"
                    android:tag="binding_15"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/knobMaxVal"
                    android:tag="binding_16"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mps"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/dominantHue"
                android:layout_gravity="center"
                android:padding="@dimen/margin_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modulation"/>
            <View
                android:background="@color/dominantHue"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/channel"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/channelArray"
                    android:tag="binding_17"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/speed"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/ArrModSpeed"
                    android:id="@+id/modSpeed"
                    android:tag="binding_18"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/cc"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/modCCVal"
                    android:tag="binding_19"
                    android:hint="@string/_0_127"
                    android:layout_weight="4"
                    style="@style/numInputStyle"/>
                <TextView
                    android:tag="binding_20"
                    android:layout_weight="3"
                    style="@style/midikeyboardItemText"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/min"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/modMinVal"
                    android:tag="binding_21"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/max"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/modMaxVal"
                    android:tag="binding_22"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/dominantHue"
                android:layout_gravity="center"
                android:padding="@dimen/margin_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pitchBend"/>
            <View
                android:background="@color/dominantHue"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/channel"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/channelArray"
                    android:tag="binding_23"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/speed"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/ArrModSpeed"
                    android:id="@+id/pitchSpeed"
                    android:tag="binding_24"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/dominantHue"
                android:layout_gravity="center"
                android:padding="@dimen/margin_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sustain"/>
            <View
                android:background="@color/dominantHue"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <Button
                android:layout_gravity="center"
                android:tag="binding_25"
                android:layout_margin="10dp"
                android:text="@string/setPedalMode"
                style="@style/btn"/>
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/port"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/ArrPort"
                    android:id="@+id/port"
                    android:tag="binding_26"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pedalType"
                style="@style/linearStyle">
                <TextView
                    android:text="@string/type"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/ArrSustainType"
                    android:tag="binding_27"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pedalCh"
                style="@style/linearStyle">
                <TextView
                    android:text="@string/channel"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/channelArray"
                    android:tag="binding_28"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pedalCC"
                style="@style/linearStyle">
                <TextView
                    android:text="@string/cc"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/sustainCCVal"
                    android:tag="binding_29"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pedalUp"
                style="@style/linearStyle">
                <TextView
                    android:text="@string/upStr"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/sustainUpVal"
                    android:tag="binding_30"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pedalDown"
                style="@style/linearStyle">
                <TextView
                    android:text="@string/downStr"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/sustainDownVal"
                    android:tag="binding_31"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ppr"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout style="@style/linearStyle">
                <TextView
                    android:text="@string/mode"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/ArrSmcSusMode"
                    android:id="@+id/psrMode"
                    android:tag="binding_32"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/psrChannelLayout"
                style="@style/linearStyle">
                <TextView
                    android:text="@string/channel"
                    style="@style/midikeyboardItemText"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/channelArray"
                    android:tag="binding_33"
                    style="@style/meSpinnerStyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/psrCCLayout"
                style="@style/linearStyle">
                <TextView
                    android:tag="binding_34"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:tag="binding_35"
                    android:hint="@string/_0_127"
                    android:layout_weight="4"
                    style="@style/numInputStyle"/>
                <TextView
                    android:id="@+id/psrCCStr"
                    android:tag="binding_36"
                    android:layout_weight="3"
                    style="@style/midikeyboardItemText"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/psrValue1Layout"
                style="@style/linearStyle">
                <TextView
                    android:tag="binding_37"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/psrValue1"
                    android:tag="binding_38"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/psrValue2Layout"
                style="@style/linearStyle">
                <TextView
                    android:tag="binding_39"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:id="@+id/psrValue2"
                    android:tag="binding_40"
                    android:hint="@string/_0_127"
                    style="@style/numInputStyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/sysExLayout"
                style="@style/linearStyle">
                <TextView
                    android:text="@string/sysEx"
                    style="@style/midikeyboardItemText"/>
                <EditText
                    android:textColor="@color/dominantHue"
                    android:id="@+id/sysExValue"
                    android:tag="binding_41"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    style="@style/textBtn"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
