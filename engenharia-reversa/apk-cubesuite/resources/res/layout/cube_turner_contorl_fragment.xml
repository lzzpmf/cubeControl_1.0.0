<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_gradual"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/padding_left"
    android:paddingEnd="@dimen/padding_right">
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="130dp"
        android:src="@drawable/cube_turner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvModelExplain"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:text="@string/tTouchScreenModeExplain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        style="@style/descriptorText"/>
    <com.cubeSuite.customControl.TextIconView
        android:id="@+id/hardware"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/aLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvModelExplain"
        style="@style/makingText"/>
    <com.contrarywind.view.WheelView
        android:id="@+id/modeSelect"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintBottom_toTopOf="@+id/customKeypadContainer"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hardware"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/customKeypadContainer"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="35dp">
            <com.cubeSuite.customControl.ButtonIconView
                android:id="@+id/midiChannelMinus"
                android:text="@string/minus"
                style="@style/iconBtn"/>
            <TextView
                android:textColor="@color/dominantHue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sendMidiChannel"
                android:layout_marginStart="3dp"/>
            <TextView
                android:textColor="@color/dominantHue"
                android:id="@+id/sendMidiChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginEnd="3dp"/>
            <com.cubeSuite.customControl.ButtonIconView
                android:id="@+id/midiChannelPlus"
                android:text="@string/plus"
                style="@style/iconBtn"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="110dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="7dp">
                <Button
                    android:id="@+id/customKeypad1"
                    android:text="@string/undefined"
                    style="@style/customModeBtn"/>
                <com.cubeSuite.customControl.TextIconView
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/left"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="7dp">
                <Button
                    android:id="@+id/customKeypad2"
                    android:text="@string/undefined"
                    style="@style/customModeBtn"/>
                <com.cubeSuite.customControl.TextIconView
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/right"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
