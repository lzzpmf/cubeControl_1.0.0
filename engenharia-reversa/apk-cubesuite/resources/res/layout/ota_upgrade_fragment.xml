<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/background_gradual"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/medium_text"
        android:textColor="@color/accent"
        android:gravity="center"
        android:id="@+id/newVersion"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/newVersion"/>
    <com.cubeSuite.customControl.ButtonIconView
        android:textSize="@dimen/big_text"
        android:textColor="@color/accent"
        android:id="@+id/detect_firmware_upgrade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/otaUpdate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/labelButton"/>
</LinearLayout>
