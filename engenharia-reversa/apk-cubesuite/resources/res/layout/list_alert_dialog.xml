<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/transparency"
    android:layout_width="300dp"
    android:layout_height="520dp"
    android:layout_margin="5dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_hollow_fillet_dominant_hue"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:paddingStart="@dimen/padding_left"
        android:paddingEnd="@dimen/padding_right">
        <com.cubeSuite.customControl.TextIconView
            android:textSize="@dimen/big_text"
            android:textColor="@color/accent"
            android:gravity="center_horizontal"
            android:id="@+id/dialog_title"
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/undefined"/>
        <Switch
            android:textSize="@dimen/medium_text"
            android:textColor="@color/dominantHue"
            android:id="@+id/toggle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:thumb="@drawable/switch_thumb"
            android:text="@string/visualBehavior"
            android:track="@drawable/switch_selector"
            android:paddingStart="@dimen/padding_left"
            android:paddingEnd="@dimen/padding_right"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="410dp"
            android:layout_marginBottom="5dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_alert_recycler"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="430dp"
                android:overScrollMode="never"/>
        </ScrollView>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="10dp">
            <Button
                android:id="@+id/close"
                android:text="@string/close"
                style="@style/dialogButton"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
