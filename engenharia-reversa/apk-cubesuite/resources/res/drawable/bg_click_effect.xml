<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/dominantHueEnable"/>
            <corners android:radius="10dp"/>
            <gradient
                android:startColor="@color/background"
                android:endColor="@color/dominantHueEnable"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="800dp"/>
        </shape>
    </item>
    <item
        android:state_enabled="true"
        android:state_pressed="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/accent"/>
            <corners android:radius="10dp"/>
            <gradient
                android:startColor="@color/background"
                android:endColor="@color/accent"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="800dp"/>
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/dominantHue"/>
            <corners android:radius="10dp"/>
            <gradient
                android:startColor="@color/background"
                android:endColor="@color/dominantHue"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="800dp"/>
        </shape>
    </item>
</selector>
