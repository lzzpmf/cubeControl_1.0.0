<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/accent"/>
            <corners android:radius="4dp"/>
            <gradient
                android:startColor="@color/background"
                android:endColor="@color/background"
                android:angle="0"
                android:type="linear"
                android:centerColor="@color/accent"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/gary"/>
            <corners android:radius="4dp"/>
            <gradient
                android:startColor="@color/background"
                android:endColor="@color/background"
                android:angle="0"
                android:type="linear"
                android:centerColor="@color/gary"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/accent"/>
            <corners android:radius="4dp"/>
            <gradient
                android:startColor="@color/background"
                android:endColor="@color/background"
                android:angle="0"
                android:type="linear"
                android:centerColor="@color/accent"/>
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/dominantHue"/>
            <corners android:radius="4dp"/>
            <gradient
                android:startColor="@color/background"
                android:endColor="@color/background"
                android:angle="0"
                android:type="linear"
                android:centerColor="@color/dominantHueEnable"/>
        </shape>
    </item>
</selector>
