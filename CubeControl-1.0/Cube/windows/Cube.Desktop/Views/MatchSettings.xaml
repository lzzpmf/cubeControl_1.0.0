<UserControl x:Class="Cube.Desktop.Views.MatchSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Cube.Desktop.Localization" xmlns:local="clr-namespace:Cube.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel MaxWidth="600" HorizontalAlignment="Left">
  <TextBlock Text="{loc:Translate Text='A associação acompanha o conteúdo do IR, mesmo se ele mudar de slot. Salvar esta tabela não altera o pedal.'}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" Style="{StaticResource BodyText}"/>
  <ItemsControl ItemsSource="{Binding}"><ItemsControl.ItemTemplate><DataTemplate><local:AdaptivePanel Margin="0,0,0,12" FirstShare="0.42" Breakpoint="460"><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="AmpLabel" Text="{loc:Translate Value={Binding Amp.Name}}" TextWrapping="Wrap" Style="{StaticResource BodyText}"/><TextBlock Text="{loc:Translate Value={Binding Amp.Alias}}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Style="{StaticResource CaptionText}"/><TextBlock Text="{loc:Translate Value={Binding Warning}}" TextWrapping="Wrap" Foreground="{DynamicResource CubeWarning}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Warning}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><ComboBox AutomationProperties.LabeledBy="{Binding ElementName=AmpLabel}" AutomationProperties.Name="{loc:Translate Value={Binding Amp.Name}}" AutomationProperties.HelpText="{loc:Translate Text='Associação de gabinete'}" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected,Mode=TwoWay}" MaxWidth="348"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:Translate Value={Binding Name}}" TextWrapping="Wrap" Style="{StaticResource BodyText}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></local:AdaptivePanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
</UserControl>
