<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cube.PerformanceChecks" />
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="NAudio.Asio" Version="3.1.0" />
  </ItemGroup>
  <Target Name="BuildStudioDsp" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipStudioNativeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/Native/Build.ps1&quot; -OutputDirectory &quot;$(ArtifactsPath)/studio-native&quot;" />
  </Target>
  <ItemGroup>
    <None Include="$(ArtifactsPath)/studio-native/CubeStudioDsp.dll" Link="CubeStudioDsp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native/vendor/stretch/LICENSE.txt" Link="Licenses/Signalsmith-Stretch.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native/vendor/linear/LICENSE.txt" Link="Licenses/Signalsmith-Linear.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
