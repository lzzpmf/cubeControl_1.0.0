<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Cube.Desktop.Controls" xmlns:loc="clr-namespace:Cube.Desktop.Localization" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
<!-- Spacing scale in device-independent pixels. -->
<sys:Double x:Key="CubeSpaceXS">4</sys:Double>
<sys:Double x:Key="CubeSpaceS">8</sys:Double>
<sys:Double x:Key="CubeSpaceM">12</sys:Double>
<sys:Double x:Key="CubeSpaceL">16</sys:Double>
<sys:Double x:Key="CubeSpaceXL">24</sys:Double>
<sys:Double x:Key="CubeSpaceXXL">32</sys:Double>
<Thickness x:Key="CubePageTitleMargin">0,0,0,6</Thickness>
<Thickness x:Key="CubePageDescriptionMargin">0,0,0,16</Thickness>
<!-- Shared density and spacing metrics (DIP). -->
<sys:Double x:Key="CubeControlHeightStandard">40</sys:Double>
<sys:Double x:Key="CubeControlHeightCompact">32</sys:Double>
<Thickness x:Key="CubeCardPadding">24</Thickness>
<Thickness x:Key="CubeButtonPadding">16,8</Thickness>
<sys:Double x:Key="CubeFontSizeCaption">12</sys:Double>
<sys:Double x:Key="CubeFontSizeBody">14</sys:Double>
<sys:Double x:Key="CubeFontSizeSubtitle">20</sys:Double>
<sys:Double x:Key="CubeFontSizeTitle">28</sys:Double>
<sys:Double x:Key="CubeFontSizeTitleLarge">40</sys:Double>
<sys:Double x:Key="CubeFontSizeDisplay">68</sys:Double>
<sys:Double x:Key="CubeLineHeightCaption">16</sys:Double>
<sys:Double x:Key="CubeLineHeightBody">20</sys:Double>
<sys:Double x:Key="CubeLineHeightSubtitle">28</sys:Double>
<sys:Double x:Key="CubeLineHeightTitle">36</sys:Double>
<sys:Double x:Key="CubeLineHeightTitleLarge">52</sys:Double>
<sys:Double x:Key="CubeLineHeightDisplay">92</sys:Double>
<FontFamily x:Key="CubeUiFont">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
<FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
<Style x:Key="CaptionText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource CubeUiFont}"/><Setter Property="FontSize" Value="{DynamicResource CubeFontSizeCaption}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="LineHeight" Value="{DynamicResource CubeLineHeightCaption}"/></Style>
<Style x:Key="BodyText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource CubeUiFont}"/><Setter Property="FontSize" Value="{DynamicResource CubeFontSizeBody}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="LineHeight" Value="{DynamicResource CubeLineHeightBody}"/></Style>
<Style x:Key="BodyStrongText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style x:Key="TitleText" TargetType="TextBlock"><Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/><Setter Property="FontFamily" Value="{DynamicResource CubeUiFont}"/><Setter Property="FontSize" Value="{DynamicResource CubeFontSizeTitle}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LineHeight" Value="{DynamicResource CubeLineHeightTitle}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/><Setter Property="FontFamily" Value="{DynamicResource CubeUiFont}"/><Setter Property="LineHeight" Value="{DynamicResource CubeLineHeightSubtitle}"/><Setter Property="FontSize" Value="{DynamicResource CubeFontSizeSubtitle}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="FontSize" Value="{DynamicResource CubeFontSizeCaption}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="SelectionSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></DataTrigger>
    <DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"><Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></DataTrigger>
   </Style.Triggers>
  </Style>
<Style x:Key="TitleLargeText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource CubeUiFont}"/><Setter Property="FontSize" Value="{DynamicResource CubeFontSizeTitleLarge}"/><Setter Property="LineHeight" Value="{DynamicResource CubeLineHeightTitleLarge}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="DisplayText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource CubeUiFont}"/><Setter Property="FontSize" Value="{DynamicResource CubeFontSizeDisplay}"/><Setter Property="LineHeight" Value="{DynamicResource CubeLineHeightDisplay}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource CubeUiFont}"/><Setter Property="FontSize" Value="{DynamicResource CubeFontSizeBody}"/></Style>
<Style x:Key="CubePageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
 <Setter Property="Margin" Value="{DynamicResource CubePageTitleMargin}"/>
</Style>
<Style x:Key="CubePageDescription" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
 <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
 <Setter Property="TextWrapping" Value="Wrap"/>
 <Setter Property="Margin" Value="{DynamicResource CubePageDescriptionMargin}"/>
</Style>
</ResourceDictionary>
