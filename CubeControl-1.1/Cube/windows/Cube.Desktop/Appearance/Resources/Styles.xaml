<ImageBrush x:Key="OfficialSwitchOn" ImageSource="pack://application:,,,/CubeControl;component/Assets/Images/Controls/Switches/chave_seletora_oficial_01_on.png" Viewbox="0.24,0.37,0.50,0.225" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/>
<ImageBrush x:Key="OfficialSwitchOff" ImageSource="pack://application:,,,/CubeControl;component/Assets/Images/Controls/Switches/chave_seletora_oficial_01_off.png" Viewbox="0.24,0.37,0.50,0.225" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/>
<Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
   <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ui:ToggleSwitch">
     <Border x:Name="SwitchRoot" Background="Transparent" Padding="{TemplateBinding Padding}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="SwitchFace" Width="56" Height="26" VerticalAlignment="Center" Background="{DynamicResource OfficialSwitchOff}" RenderOptions.BitmapScalingMode="HighQuality"/>
       <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource CubeText}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" RecognizesAccessKey="True"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchFace" Property="Background" Value="{DynamicResource OfficialSwitchOn}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchRoot" Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
