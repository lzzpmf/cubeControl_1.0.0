<ControlTemplate x:Key="CubeSearchAutoSuggestBoxTemplate" TargetType="{x:Type ui:AutoSuggestBox}">
    <Grid>
        <ui:TextBox
            x:Name="PART_TextBox"
            Grid.Row="0"
            ClearButtonEnabled="{TemplateBinding ClearButtonEnabled}"
            Icon="{TemplateBinding Icon}"
            IconPlacement="Left"
            Style="{StaticResource CubeSearchTextBoxStyle}"
            Padding="{TemplateBinding Padding}"
            AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
            IsTabStop="{TemplateBinding IsTabStop}"
            PlaceholderText="{TemplateBinding PlaceholderText}"
