<ControlTemplate x:Key="IrLibraryItemTemplate" TargetType="{x:Type TreeViewItem}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="Border" BorderBrush="{DynamicResource CubeSurfaceBorderBrush}" BorderThickness="{DynamicResource CubeSurfaceBorderThickness}" Background="{DynamicResource CubeLibraryItemBackground}" Grid.Row="0" CornerRadius="{TemplateBinding Border.CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="19"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="ActiveRectangle" Grid.Column="0" Width="3" Height="16" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource CubeFocus}" RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
                                <ToggleButton x:Name="Expander" Grid.Column="0" Margin="8,0" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource ExpandCollapseToggleButtonStyle}"/>
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" ContentSource="Header" TextElement.FontSize="{TemplateBinding FontSize}"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="19"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsBrand}" Value="False">
                            <Setter TargetName="Border" Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger SourceName="Border" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource CubeItemHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource CubeSelected}"/>
                            <Setter TargetName="ActiveRectangle" Property="Fill" Value="{DynamicResource CubeSelectionIndicator}"/><Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource CubeSelectedText}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible"/><Setter TargetName="ActiveRectangle" Property="Height" Value="24"/></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActiveRectangle" Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource CubeDisabledText}"/><Setter TargetName="Border" Property="Background" Value="Transparent"/></Trigger>
<MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasHeader" Value="False"/>
                                <Condition Property="Width" Value="Auto"/>
