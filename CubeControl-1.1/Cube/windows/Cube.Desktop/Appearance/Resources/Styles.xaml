<ResourceDictionary.MergedDictionaries>
 <ResourceDictionary Source="Borderless/TextBox.xaml"/>
 <ResourceDictionary Source="Borderless/ComboBox.xaml"/>
 <ResourceDictionary Source="Borderless/NumberBox.xaml"/>
 <ResourceDictionary Source="Borderless/ContextMenu.xaml"/>
 <ResourceDictionary Source="Borderless/MenuItem.xaml"/>
 <ResourceDictionary Source="Borderless/RadioButton.xaml"/>
 <ResourceDictionary Source="Borderless/ListViewItem.xaml"/>
