<!-- Selection is persistent; keyboard focus uses a separate outline. -->
<Style x:Key="CubeSelectionMarker" TargetType="Border">
 <Setter Property="Width" Value="3"/><Setter Property="Height" Value="16"/>
 <Setter Property="CornerRadius" Value="2"/><Setter Property="HorizontalAlignment" Value="Left"/>
 <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsHitTestVisible" Value="False"/>
 <Setter Property="Background" Value="{DynamicResource CubeFocus}"/><Setter Property="Visibility" Value="Collapsed"/>
 <Style.Triggers>
  <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource TemplatedParent}}" Value="True">
   <Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{DynamicResource CubeSelectionIndicator}"/>
  </DataTrigger>
  <DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
 </Style.Triggers>
</Style>
<Style x:Key="CubeToggleMarker" TargetType="Border">
 <Setter Property="Width" Value="3"/><Setter Property="Height" Value="16"/>
 <Setter Property="CornerRadius" Value="2"/><Setter Property="HorizontalAlignment" Value="Left"/>
 <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsHitTestVisible" Value="False"/>
 <Setter Property="Background" Value="{DynamicResource CubeFocus}"/><Setter Property="Visibility" Value="Collapsed"/>
 <Style.Triggers>
  <DataTrigger Binding="{Binding IsChecked,RelativeSource={RelativeSource TemplatedParent}}" Value="True">
   <Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{DynamicResource CubeSelectionIndicator}"/>
  </DataTrigger>
  <DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
 </Style.Triggers>
</Style>
<!-- Menu focus moves between a header and its popup children during hover.
     Keep the header marker stable for the entire time its submenu is open. -->
<Style x:Key="CubeMenuMarker" TargetType="Border" BasedOn="{StaticResource CubeToggleMarker}">
 <Style.Triggers>
  <DataTrigger Binding="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}" Value="True">
   <Setter Property="Visibility" Value="Visible"/><Setter Property="Height" Value="24"/>
  </DataTrigger>
  <DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
 </Style.Triggers>
</Style>
<Style x:Key="CubePreferenceMarker" TargetType="Border">
 <Setter Property="Width" Value="3"/><Setter Property="Height" Value="16"/>
 <Setter Property="CornerRadius" Value="2"/><Setter Property="HorizontalAlignment" Value="Left"/>
 <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsHitTestVisible" Value="False"/>
 <Setter Property="Background" Value="{DynamicResource CubeFocus}"/><Setter Property="Visibility" Value="Collapsed"/>
 <Style.Triggers>
  <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource TemplatedParent}}" Value="True">
   <Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{DynamicResource CubeSelectionIndicator}"/>
  </DataTrigger>
  <DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
 </Style.Triggers>
</Style>

<Style x:Key="CubeFocusMarker" TargetType="Border">
 <Setter Property="Width" Value="3"/><Setter Property="Height" Value="24"/><Setter Property="CornerRadius" Value="2"/>
 <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
 <Setter Property="Background" Value="{DynamicResource CubeFocus}"/><Setter Property="Visibility" Value="Collapsed"/><Setter Property="IsHitTestVisible" Value="False"/>
 <Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin,RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
 <DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
</Style>
<!-- Shared scroll bars: a narrow rounded indicator inside a larger drag target.
     Track sizes the thumb from ViewportSize / (range + ViewportSize), so it
     follows the visible content when a window or an internal pane is resized. -->
<Style x:Key="CubeScrollPageButton" TargetType="RepeatButton">
 <Setter Property="Focusable" Value="False"/>
 <Setter Property="IsTabStop" Value="False"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
  <Border Background="Transparent"/>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="CubeScrollThumb" TargetType="Thumb">
 <Setter Property="Focusable" Value="False"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
  <Grid Background="Transparent">
   <Border x:Name="Indicator" Width="3" HorizontalAlignment="Center" CornerRadius="3"
           Background="{DynamicResource Muted}"/>
  </Grid>
  <ControlTemplate.Triggers>
   <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="Horizontal">
    <Setter TargetName="Indicator" Property="Width" Value="Auto"/>
    <Setter TargetName="Indicator" Property="Height" Value="3"/>
    <Setter TargetName="Indicator" Property="HorizontalAlignment" Value="Stretch"/>
    <Setter TargetName="Indicator" Property="VerticalAlignment" Value="Center"/>
   </DataTrigger>
   <Trigger Property="IsMouseOver" Value="True">
    <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource CubeText}"/>
   </Trigger>
   <Trigger Property="IsDragging" Value="True">
    <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource CubeText}"/>
   </Trigger>
   <Trigger Property="IsEnabled" Value="False">
    <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource CubeDisabledText}"/>
   </Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="DefaultScrollBarStyle" TargetType="ScrollBar">
 <Setter Property="Width" Value="12"/>
 <Setter Property="MinWidth" Value="0"/>
 <Setter Property="MinHeight" Value="0"/>
 <Setter Property="Background" Value="Transparent"/>
 <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
 <Setter Property="Focusable" Value="False"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
  <Grid Background="{TemplateBinding Background}">
   <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
          Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
          Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
          ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
    <Track.DecreaseRepeatButton>
     <RepeatButton x:Name="PageDecrease" Style="{StaticResource CubeScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
    </Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Style="{StaticResource CubeScrollThumb}"/></Track.Thumb>
    <Track.IncreaseRepeatButton>
     <RepeatButton x:Name="PageIncrease" Style="{StaticResource CubeScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
    </Track.IncreaseRepeatButton>
   </Track>
  </Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="Orientation" Value="Horizontal">
    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
    <Setter TargetName="PageDecrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
    <Setter TargetName="PageIncrease" Property="Command" Value="ScrollBar.PageRightCommand"/>
   </Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
 <Style.Triggers>
  <Trigger Property="Orientation" Value="Horizontal">
   <Setter Property="Width" Value="Auto"/>
   <Setter Property="Height" Value="12"/>
  </Trigger>
 </Style.Triggers>
</Style>
<Style TargetType="ScrollBar" BasedOn="{StaticResource DefaultScrollBarStyle}"/>
<!-- Match equipment thumbnails and device images to the official control artwork. -->
<Style TargetType="Image">
 <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
</Style>
<Style x:Key="BackingArtButton" TargetType="Button"><Setter Property="BorderBrush" Value="{DynamicResource CubeBorder}"/><Setter Property="BorderThickness" Value="{DynamicResource CubeSurfaceBorderThickness}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
        <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource CubeText}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
         <Grid Background="Transparent">
          <VisualStateManager.VisualStateGroups>
           <VisualStateGroup x:Name="CommonStates">
            <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.15"/></VisualStateGroup.Transitions>
            <VisualState x:Name="Normal"/>
            <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="FaceContent" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
            <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="FaceContent" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/></Storyboard></VisualState>
            <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="FaceContent" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0"/></Storyboard></VisualState>
           </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <Border Background="{TemplateBinding Background}" CornerRadius="8"/>

          <ContentPresenter x:Name="FaceContent" Opacity="0.85" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          <Border x:Name="FaceBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" IsHitTestVisible="False"/>
         </Grid>

        </ControlTemplate></Setter.Value></Setter>
       </Style>
<Style x:Key="PlayerArtButton" TargetType="Button" BasedOn="{StaticResource BackingArtButton}"><Setter Property="BorderThickness" Value="0"/></Style>
<ControlTemplate x:Key="BackingAccessibleFaderTemplate" TargetType="Slider">
        <Grid MinHeight="32" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
<local:BackingFaderMeter Reading="{Binding MeterReading,RelativeSource={RelativeSource TemplatedParent}}">
 <local:BackingFaderMeter.Style><Style TargetType="local:BackingFaderMeter"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowMeter,RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:BackingFaderMeter.Style>
</local:BackingFaderMeter>
         <Border Height="4" Margin="10,0" Background="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
         <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="20" Height="32"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="2" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
         </Track>
        </Grid>
       </ControlTemplate>
<ControlTemplate x:Key="OfficialVerticalFaderTemplate" TargetType="Slider">
   <Grid x:Name="FaderRoot" Background="Transparent" MinWidth="32">
    <Border Width="4" Margin="0,10" HorizontalAlignment="Center" CornerRadius="2" Background="{DynamicResource CubeKnobTrack}"/>
    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Width="4" Margin="0,0,0,10" HorizontalAlignment="Center" Background="{DynamicResource CubeAccent}" CornerRadius="2"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="32" Height="20" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Image Source="{DynamicResource CubeControlFaderFace}" Stretch="Uniform" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
