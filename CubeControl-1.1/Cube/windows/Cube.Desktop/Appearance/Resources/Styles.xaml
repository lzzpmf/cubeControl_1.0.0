<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Cube.Desktop.Controls" xmlns:loc="clr-namespace:Cube.Desktop.Localization" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
<Style x:Key="BackingArtButton" TargetType="Button"><Setter Property="BorderBrush" Value="{DynamicResource CubeBorder}"/><Setter Property="BorderThickness" Value="{DynamicResource CubeSurfaceBorderThickness}"/>
        <Setter Property="FocusVisualStyle"><Setter.Value><Style TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource CubeFocus}" BorderThickness="2" CornerRadius="8"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
        <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource CubeText}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
         <Grid Background="Transparent">
          <VisualStateManager.VisualStateGroups>
           <VisualStateGroup x:Name="CommonStates">
            <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.15"/></VisualStateGroup.Transitions>
            <VisualState x:Name="Normal"/>
            <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="FaceContent" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
            <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="FaceContent" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/></Storyboard></VisualState>
            <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="FaceContent" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0"/></Storyboard></VisualState>
           </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <Border Background="{TemplateBinding Background}" CornerRadius="8"/>

          <ContentPresenter x:Name="FaceContent" Opacity="0.85" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          <Border x:Name="FaceBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" IsHitTestVisible="False"/>
         </Grid>

        </ControlTemplate></Setter.Value></Setter>
       </Style>
<ControlTemplate x:Key="BackingAccessibleFaderTemplate" TargetType="Slider">
        <Grid Height="32" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
         <Border Height="4" Margin="10,0" Background="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
         <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="20" Height="32"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="2" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
         </Track>
        </Grid>
       </ControlTemplate>
<ControlTemplate x:Key="OfficialVerticalFaderTemplate" TargetType="Slider">
   <Grid x:Name="FaderRoot" Background="Transparent" MinWidth="32">
    <Border Width="4" Margin="0,10" HorizontalAlignment="Center" CornerRadius="2" Background="{DynamicResource CubeKnobTrack}"/>
    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Width="4" Margin="0,0,0,10" HorizontalAlignment="Center" Background="{DynamicResource CubeAccent}" CornerRadius="2"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="32" Height="20" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Image Source="{DynamicResource CubeControlFaderFace}" Stretch="Uniform" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="FaderRoot" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>
<ControlTemplate x:Key="BackingAccessibleVerticalFaderTemplate" TargetType="Slider">
        <Grid Width="32" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
         <Border Width="4" Margin="0,10" HorizontalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
         <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="32" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="2" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
         </Track>
        </Grid>
       </ControlTemplate>
<ControlTemplate x:Key="OfficialHorizontalFaderTemplate" TargetType="Slider">
   <Grid x:Name="FaderRoot" Background="Transparent" MinHeight="32">
    <Border Height="4" Margin="10,0" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource CubeKnobTrack}"/>
    <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
     <Track.DecreaseRepeatButton>
      <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
       <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="4" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource CubeAccent}" CornerRadius="2"/></Grid></ControlTemplate></RepeatButton.Template>
      </RepeatButton>
     </Track.DecreaseRepeatButton>
     <Track.Thumb>
      <Thumb Width="20" Height="32" Focusable="False" RenderOptions.BitmapScalingMode="HighQuality">
       <Thumb.Template><ControlTemplate TargetType="Thumb">
        <Border Background="Transparent">
         <Border Margin="1" Background="{DynamicResource CubeControlHorizontalFader}"/>
        </Border>
       </ControlTemplate></Thumb.Template>
      </Thumb>
     </Track.Thumb>
     <Track.IncreaseRepeatButton>
      <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
       <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
      </RepeatButton>
     </Track.IncreaseRepeatButton>
    </Track>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FaderRoot" Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
<Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Template" Value="{StaticResource OfficialHorizontalFaderTemplate}"/></Trigger></Style.Triggers>
  </Style>
<ImageBrush x:Key="OfficialSwitchOn" ImageSource="pack://application:,,,/CubeControl;component/Assets/Images/Controls/Switches/chave_seletora_oficial_01_on.png" Viewbox="0.24,0.37,0.50,0.225" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/>
<ImageBrush x:Key="OfficialSwitchOff" ImageSource="pack://application:,,,/CubeControl;component/Assets/Images/Controls/Switches/chave_seletora_oficial_01_off.png" Viewbox="0.24,0.37,0.50,0.225" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/>
<Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ui:ToggleSwitch">
     <Border x:Name="SwitchRoot" Background="Transparent" Padding="{TemplateBinding Padding}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="SwitchFace" Width="56" Height="26" VerticalAlignment="Center" Background="{DynamicResource OfficialSwitchOff}" RenderOptions.BitmapScalingMode="HighQuality"/>
       <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource CubeText}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" RecognizesAccessKey="True"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchFace" Property="Background" Value="{DynamicResource OfficialSwitchOn}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchRoot" Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
<ControlTemplate x:Key="DownUpExpanderHeader" TargetType="ToggleButton">
   <Grid Background="Transparent">
   <Border x:Name="HeaderHover" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Opacity="0"/>
   <Border Padding="{TemplateBinding Padding}" Background="Transparent">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
     <ui:SymbolIcon x:Name="ControlChevronIcon" Grid.Column="1" FontSize="{DynamicResource CubeIconSizeAction}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Symbol="{StaticResource CubeIconChevronDown24}"/>
    </Grid>
   </Border>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderHover" Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HeaderHover" Property="Opacity" Value="0"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ControlChevronIcon" Property="Symbol" Value="ChevronUp24"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
<ControlTemplate x:Key="GearCarouselImageTemplate" TargetType="local:GearImageButton">
   <Grid Background="Transparent">
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
    <StackPanel x:Name="CarouselHint" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.65" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
     <ui:SymbolIcon x:Name="CarouselUpChevron" Symbol="{StaticResource CubeIconChevronUp24}" FontSize="{DynamicResource CubeIconSizeNavigation}" Foreground="{DynamicResource CubeText}" Margin="0,0,0,12"/>
     <ui:SymbolIcon x:Name="CarouselDownChevron" Symbol="{StaticResource CubeIconChevronDown24}" FontSize="{DynamicResource CubeIconSizeNavigation}" Foreground="{DynamicResource CubeText}"/>
    </StackPanel>
   </Grid>
   <ControlTemplate.Triggers>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsInteractive" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="CarouselHint" Property="Visibility" Value="Visible"/></MultiTrigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CarouselHint" Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CarouselHint" Property="Opacity" Value="1"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
<Style x:Key="InfiniteProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
   <Setter Property="IsIndeterminate" Value="True"/>
   <Setter Property="Orientation" Value="Horizontal"/>
   <Setter Property="Height" Value="4"/>
   <Style.Triggers><Trigger Property="IsVisible" Value="False"><Setter Property="IsIndeterminate" Value="False"/></Trigger></Style.Triggers>
  </Style>
<Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
   <Setter Property="MaxWidth" Value="360"/>
   <Setter Property="FontSize" Value="{DynamicResource CubeFontSizeBody}"/>
   <Setter Property="TextBlock.LineHeight" Value="{DynamicResource CubeLineHeightBody}"/>
   <Setter Property="TextBlock.TextAlignment" Value="Left"/>
  </Style>
<Style x:Key="DefaultControlFocusVisualStyle" TargetType="Control">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.22" CornerRadius="4" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter>
  </Style>
<Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control" BasedOn="{StaticResource DefaultControlFocusVisualStyle}"/>
<Style x:Key="ParameterNumberStyle" TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}"><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="{DynamicResource CubeFontSizeBody}"/><Setter Property="Width" Value="108"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="ClearButtonEnabled" Value="False"/></Style>
<ControlTemplate x:Key="IrLibraryItemTemplate" TargetType="{x:Type TreeViewItem}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="Border" Background="Transparent" Grid.Row="0" CornerRadius="{TemplateBinding Border.CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="19"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="ActiveRectangle" Grid.Column="0" Width="3" Height="16" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource TreeViewItemSelectionIndicatorForeground}" RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
                                <ToggleButton x:Name="Expander" Grid.Column="0" Margin="8,0" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource ExpandCollapseToggleButtonStyle}"/>
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" ContentSource="Header" TextElement.FontSize="{TemplateBinding FontSize}"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="19"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger SourceName="Border" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource TreeViewItemBackgroundPointerOver}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource TreeViewItemBackgroundSelected}"/>
                            <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasHeader" Value="False"/>
                                <Condition Property="Width" Value="Auto"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Header" Property="MinWidth" Value="75"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasHeader" Value="False"/>
                                <Condition Property="Height" Value="Auto"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Header" Property="MinHeight" Value="19"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
<BooleanToVisibilityConverter x:Key="Visible"/>
<Style x:Key="SettingsAction" TargetType="ui:CardAction" BasedOn="{StaticResource {x:Type ui:CardAction}}">
   <Setter Property="Padding" Value="16,12"/><Setter Property="MinHeight" Value="64"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/>
  <Setter Property="BorderThickness" Value="{DynamicResource CubeSurfaceBorderThickness}"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource CubeSelected}"/><Setter Property="Foreground" Value="{DynamicResource CubeSelectedText}"/></Trigger></Style.Triggers>
  </Style>
<Style x:Key="SettingsExpander" TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
   <Setter Property="local:ExpanderChevron.Enabled" Value="True"/>
   <Setter Property="Padding" Value="16,12"/><Setter Property="ContentPadding" Value="16"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/>
  <Setter Property="BorderThickness" Value="{DynamicResource CubeSurfaceBorderThickness}"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource CubeSelected}"/><Setter Property="Foreground" Value="{DynamicResource CubeSelectedText}"/></Trigger></Style.Triggers>
  </Style>
<Style x:Key="QuickAction" TargetType="ui:CardAction" BasedOn="{StaticResource SettingsAction}">
   <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="MaxWidth" Value="440"/>
   <Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="64"/>
   <Setter Property="Margin" Value="0,0,12,8"/><Setter Property="Foreground" Value="{DynamicResource CubeText}"/>
   <Setter Property="IsChevronVisible" Value="False"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Border.CornerRadius" Value="6"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Style.Resources>
    <Thickness x:Key="CardActionIconMargin">0,0,16,0</Thickness>
    <SolidColorBrush x:Key="CardBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="Transparent"/>
   </Style.Resources>
  </Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CubeCard}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="24"/><Setter Property="BorderBrush" Value="{DynamicResource CubeBorder}"/><Setter Property="BorderThickness" Value="{DynamicResource CubeSurfaceBorderThickness}"/></Style>
<Style x:Key="CubeButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
   <Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="MinWidth" Value="0"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FontSize" Value="{DynamicResource CubeFontSizeBody}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
<Style x:Key="CubeIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource CubeButtonStyle}">
   <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,8,8"/>
  </Style>
<Style TargetType="ui:Button" BasedOn="{StaticResource CubeButtonStyle}"><Setter Property="Margin" Value="0,0,8,8"/></Style>
<Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="MinWidth" Value="160"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
<Style x:Key="SelectionTile" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Foreground" Value="{DynamicResource CubeText}"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid><Border x:Name="Surface" Background="{DynamicResource CubeCard}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="{DynamicResource CubeSurfaceBorderThickness}" CornerRadius="10" Padding="12"><ContentPresenter/></Border>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CubeInset}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CubeSelected}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CubeAccent}"/><Setter Property="Foreground" Value="{DynamicResource CubeSelectedText}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CubeCard}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CubeBorder}"/><Setter Property="Foreground" Value="{DynamicResource CubeDisabledText}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
<Style x:Key="HiddenTabs" TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
