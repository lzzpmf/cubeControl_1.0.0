<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Icons/desktopIcon.ico</ApplicationIcon>
    <AssemblyName>CubeControl</AssemblyName>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CubeSimulation)' == 'true'">
    <DefineConstants>$(DefineConstants);CUBE_SIMULATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CubeSimulation)' == 'true'">
    <Compile Include="../Cube.Tests/FakeConnection.cs" Link="Simulation/FakeConnection.cs" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../Cube.Usb/Cube.Usb.csproj" /><PackageReference Include="WPF-UI" Version="4.3.0" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <None Include="$(ArtifactsPath)/native/CubeBackingDsp.dll" Link="CubeBackingDsp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(ArtifactsPath)/native/CubeBackingDsp.dll')" />
  </ItemGroup>
  <Target Name="BuildBackingDsp" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipBackingNativeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/Native/Build.ps1&quot; -OutputDirectory &quot;$(ArtifactsPath)/native&quot;" />
    <ItemGroup>
      <None Remove="$(ArtifactsPath)/native/CubeBackingDsp.dll" />
      <None Include="$(ArtifactsPath)/native/CubeBackingDsp.dll" Link="CubeBackingDsp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Update="Assets/Firmwares/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/ImpulseResponses/**/*.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/Icons/*.png" />
    <Resource Include="Assets/imagens/Knobs/knob_oficial_01.png;Assets/imagens/Faders/fader_oficial_01.png" />
    <Resource Include="Assets/imagens/Faders/fader_horizontal_oficial_01.png" />
    <Resource Include="Assets/imagens/Interruptores/footswitch_oficial_01.png" />
    <Resource Include="Assets/imagens/Interruptores/chave_seletora_oficial_01_on.png;Assets/imagens/Interruptores/chave_seletora_oficial_01_off.png" />
    <EmbeddedResource Include="Assets/FactoryAmps.bin" LogicalName="Cube.FactoryAmps" />
    <None Update="Assets/Cube-Baby-M-Vave-Guitar-Pedal-User-Manual.pdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Localization/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Localization/README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Equipment/*.png" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <None Update="Assets/imagens/Gabinetes/*.png;Assets/imagens/Dispositivos/SINCO-CubeBaby.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../README.md" Link="LEIA-ME.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
