        <Border Style="{StaticResource CubeSelectionMarker}"/></Grid><ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource CubeItemHover}"/></Trigger>
