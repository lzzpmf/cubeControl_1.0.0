      </StackPanel></ListBoxItem>
      <ListBoxItem ToolTip="{loc:Translate Text='Crie seu timbre e ouça os ajustes automaticamente.'}" AutomationProperties.Name="{loc:Translate Text='Criador de amps'}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="{StaticResource CubeIconAdd24}" Style="{StaticResource NavigationIcon}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Translate Text='Criador de amps'}" Style="{StaticResource BodyStrongText}"/><TextBlock Text="{loc:Translate Text='Seu amplificador'}" Style="{StaticResource SelectionSecondaryText}" Margin="0,4,0,0"/></StackPanel></StackPanel></ListBoxItem>
