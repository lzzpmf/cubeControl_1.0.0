       <ui:Button Content="{loc:Translate Text='Reinstalar / atualizar'}" Command="{Binding InstallFirmware}" ToolTip="{loc:Translate Text='Disponível após desconectar o modo normal do pedal. Requer modo flash e permissão de administrador.'}"/>
      </WrapPanel>
      </StackPanel>
     </ui:CardExpander>
     <ui:CardExpander Style="{StaticResource SettingsExpander}" Expanded="HelpSectionExpanded">
      <ui:CardExpander.Header><StackPanel><TextBlock Text="{loc:Translate Text='Últimas operações'}" Style="{StaticResource BodyStrongText}"/><TextBlock Text="{loc:Translate Text='Até 20 operações desta sessão. Duplo clique para retornar a um ajuste.'}" Style="{StaticResource HelpText}" Margin="0,4,0,0"/></StackPanel></ui:CardExpander.Header><ui:CardExpander.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconInfo24}" FontSize="{DynamicResource CubeIconSizeNavigation}"/></ui:CardExpander.Icon><ListBox ItemsSource="{Binding Operations}" MaxHeight="320" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><EventSetter Event="MouseDoubleClick" Handler="OperationDoubleClick"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4" ToolTip="{loc:Translate Value={Binding Hint}}"><TextBlock Text="{Binding Time,StringFormat=HH:mm:ss}" Style="{StaticResource CaptionText}"/><TextBlock Text="{loc:Translate Value={Binding Description}}" TextWrapping="Wrap" Style="{StaticResource HelpText}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox></ui:CardExpander>
     <ui:CardExpander Style="{StaticResource SettingsExpander}" Expanded="HelpSectionExpanded">
      <ui:CardExpander.Header><StackPanel><TextBlock Text="{loc:Translate Text='Registro de comunicação USB'}" Style="{StaticResource BodyStrongText}"/><TextBlock Text="{loc:Translate Text='Veja os detalhes da comunicação entre o aplicativo e o pedal.'}" Style="{StaticResource HelpText}" Margin="0,4,0,0"/></StackPanel></ui:CardExpander.Header><ui:CardExpander.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconPlugConnected24}" FontSize="{DynamicResource CubeIconSizeNavigation}"/></ui:CardExpander.Icon><TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" Height="210" Background="{DynamicResource CubeWell}" Foreground="{DynamicResource Muted}" BorderThickness="0" FontFamily="Consolas" FontSize="{DynamicResource CubeFontSizeCaption}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="10"/></ui:CardExpander>
    </StackPanel></ScrollViewer>
   </TabItem>
</TabControl>
   </Grid>
   <StackPanel x:Name="FooterActions" Grid.Row="1" Margin="0,8,0,0">
    <ui:InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error" Title="{loc:Translate Text='Operação não concluída'}" Message="{loc:Translate Value={Binding ErrorMessage}}" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,8"/>

   </StackPanel>
  </Grid>
  </ScrollViewer>
  </Grid>
  <ScrollBar x:Name="WindowPageScrollBar" Orientation="Vertical" HorizontalAlignment="Right" Width="12" Visibility="Collapsed" Scroll="WindowPageScroll" AutomationProperties.Name="{loc:Translate Text='Rolagem da página'}"/>
  <Border x:Name="AuditionMiniPlayer" DataContext="{Binding IrAudition}" Visibility="{Binding ShowMiniPlayer,Converter={StaticResource Visible}}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24" Padding="12" CornerRadius="{DynamicResource CubeCardCornerRadius}" Background="{DynamicResource CubeFloatingSurface}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="{DynamicResource CubeSurfaceBorderThickness}">
   <WrapPanel>
    <TextBlock Text="{loc:Translate Text='Pré-escuta'}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ui:Button Content="{loc:Translate Value={Binding PlayLabel}}" Command="{Binding PlayPause}" Margin="0,0,8,0"/>
    <ui:Button Content="{loc:Translate Text='Parar'}" Command="{Binding Stop}"/>
   </WrapPanel>
  </Border>
  <Border x:Name="BackingMiniPlayer" DataContext="{Binding BackingTracks,RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowMiniPlayer,Converter={StaticResource Visible}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Padding="12" CornerRadius="{DynamicResource CubeCardCornerRadius}" Background="{DynamicResource CubeFloatingSurface}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="{DynamicResource CubeSurfaceBorderThickness}" local:SurfaceMotion.Enabled="True">
   <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15"/></Border.Effect>
   <StackPanel>
    <TextBlock MouseLeftButtonUp="BackingReturnClick" Cursor="Hand" Text="{Binding SelectedTrack.Title}" ToolTip="{Binding SelectedTrack.Title}" MaxWidth="210" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource CubeFontSizeCaption}" Margin="4,0,4,8" Foreground="{DynamicResource CubeText}"/>
    <ProgressBar Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}" Height="3" Margin="4,0,4,6" IsHitTestVisible="False"/><TextBlock Text="{loc:Translate Value={Binding Status}}" Visibility="{Binding HasError,Converter={StaticResource Visible}}" TextWrapping="Wrap" MaxWidth="220"/>
    <StackPanel Orientation="Horizontal">
     <StackPanel.Resources><Style TargetType="ui:Button" BasedOn="{StaticResource CubeIconButtonStyle}"><Setter Property="Margin" Value="2,0"/><Setter Property="Appearance" Value="Transparent"/></Style></StackPanel.Resources>
     <ui:Button Command="{Binding Previous}" ToolTip="{loc:Translate Text='Faixa anterior'}" AutomationProperties.Name="{loc:Translate Text='Faixa anterior'}"><ui:SymbolIcon Symbol="{StaticResource CubeIconPrevious24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button>
     <ui:Button Command="{Binding PlayPause}" Appearance="Primary" ToolTip="{loc:Translate Value={Binding PlayLabel}}" AutomationProperties.Name="{loc:Translate Value={Binding PlayLabel}}"><ui:SymbolIcon Symbol="{Binding PlayIcon}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button>
     <ui:Button Command="{Binding Stop}" ToolTip="{loc:Translate Text='Parar'}" AutomationProperties.Name="{loc:Translate Text='Parar'}"><ui:SymbolIcon Symbol="{StaticResource CubeIconStop24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button>
     <ui:Button Command="{Binding Next}" ToolTip="{loc:Translate Text='Próxima faixa'}" AutomationProperties.Name="{loc:Translate Text='Próxima faixa'}"><ui:SymbolIcon Symbol="{StaticResource CubeIconNext24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button>
    </StackPanel>
   </StackPanel>
  </Border>
  <Border x:Name="BusyOverlay" local:SurfaceMotion.Enabled="True" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" MaxWidth="420" Margin="20" SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False" Visibility="{Binding ShowBusyPanel,Converter={StaticResource Visible}}">
   <Grid>
    <Border x:Name="BusyShadow" Background="{DynamicResource CubeFloatingSurface}" CornerRadius="{DynamicResource CubeCardCornerRadius}" IsHitTestVisible="False">
     <Border.Effect><DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="{DynamicResource CubeFloatingShadowOpacity}" RenderingBias="Quality"/></Border.Effect>
    </Border>
    <Border Padding="28,24" CornerRadius="{DynamicResource CubeCardCornerRadius}" Background="{DynamicResource CubeFloatingSurface}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="0">
   <StackPanel>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
     <TextBlock x:Name="BusyMessage" AutomationProperties.LiveSetting="Off" Text="{loc:Translate Text='Preparando o palco…'}" TextAlignment="Center" TextWrapping="NoWrap" Style="{StaticResource SectionTitle}"/>
    </Viewbox>
    <local:LiveStatusText AutomationProperties.LiveSetting="Polite" Text="{loc:Translate Value={Binding BusyDetail}}" Style="{StaticResource HelpText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <ProgressBar Style="{StaticResource InfiniteProgressBar}" x:Name="OperationProgress" AutomationProperties.Name="{loc:Translate Value={Binding BusyDetail}}" Margin="0,12,0,0"/>
    <TextBlock Text="{loc:Translate Value={Binding Ir.State}}" Visibility="{Binding Ir.TransferActive,Converter={StaticResource Visible}}" Style="{StaticResource HelpText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel>
    </Border>
   </Grid>
  </Border>
  <ui:SnackbarPresenter x:Name="Notifications" VerticalAlignment="Bottom" Margin="24,0,24,20"/>
  <ui:ContentDialogHost x:Name="DialogHost"/>
  </Grid>
 </Grid>
</ui:FluentWindow>
