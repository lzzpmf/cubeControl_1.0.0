    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{loc:Translate Text='Criador de amps'}"><ContentControl x:Name="AmpEditorHost"><ui:CardAction Style="{StaticResource QuickAction}" Click="CreateAmpClick" HorizontalAlignment="Left" VerticalAlignment="Top"><ui:CardAction.Icon><ui:SymbolIcon Symbol="Add24" Style="{StaticResource QuickActionIcon}"/></ui:CardAction.Icon><TextBlock Text="{loc:Translate Text='Escolha um amp base'}" Style="{StaticResource BodyStrongText}"/></ui:CardAction></ContentControl></TabItem>
    </TabControl>
   </Grid>
   <StackPanel x:Name="FooterActions" Grid.Row="1" Margin="0,8,0,0">
    <ui:InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error" Title="{loc:Translate Text='Operação não concluída'}" Message="{loc:Translate Value={Binding ErrorMessage}}" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,8"/>

   </StackPanel>
  </Grid>
  </ScrollViewer>
  </Grid>
  <Border x:Name="BackingMiniPlayer" DataContext="{Binding BackingTracks,RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowMiniPlayer,Converter={StaticResource Visible}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Padding="10" CornerRadius="10" Background="{DynamicResource CubeFloatingSurface}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="1" local:SurfaceMotion.Enabled="True">
   <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15"/></Border.Effect>
   <StackPanel>
    <TextBlock MouseLeftButtonUp="BackingReturnClick" Cursor="Hand" Text="{Binding SelectedTrack.Title}" ToolTip="{Binding SelectedTrack.Title}" MaxWidth="210" TextTrimming="CharacterEllipsis" FontSize="12" Margin="4,0,4,8" Foreground="{DynamicResource CubeText}"/>
    <ProgressBar Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}" Height="3" Margin="4,0,4,6" IsHitTestVisible="False"/><TextBlock Text="{loc:Translate Value={Binding Status}}" Visibility="{Binding HasError,Converter={StaticResource Visible}}" TextWrapping="Wrap" MaxWidth="220"/>
    <StackPanel Orientation="Horizontal">
     <StackPanel.Resources><Style TargetType="ui:Button" BasedOn="{StaticResource CubeButtonStyle}"><Setter Property="Width" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="Appearance" Value="Transparent"/></Style></StackPanel.Resources>
     <ui:Button Command="{Binding Previous}" ToolTip="{loc:Translate Text='Faixa anterior'}" AutomationProperties.Name="{loc:Translate Text='Faixa anterior'}"><ui:Button.Icon><ui:SymbolIcon Symbol="Previous24" FontSize="20"/></ui:Button.Icon></ui:Button>
     <ui:Button Command="{Binding PlayPause}" Appearance="Primary" ToolTip="{loc:Translate Value={Binding PlayLabel}}" AutomationProperties.Name="{loc:Translate Value={Binding PlayLabel}}"><ui:Button.Icon><ui:SymbolIcon Symbol="{Binding PlayIcon}" FontSize="20"/></ui:Button.Icon></ui:Button>
     <ui:Button Command="{Binding Stop}" ToolTip="{loc:Translate Text='Parar'}" AutomationProperties.Name="{loc:Translate Text='Parar'}"><ui:Button.Icon><ui:SymbolIcon Symbol="Stop24" FontSize="20"/></ui:Button.Icon></ui:Button>
     <ui:Button Command="{Binding Next}" ToolTip="{loc:Translate Text='Próxima faixa'}" AutomationProperties.Name="{loc:Translate Text='Próxima faixa'}"><ui:Button.Icon><ui:SymbolIcon Symbol="Next24" FontSize="20"/></ui:Button.Icon></ui:Button>
    </StackPanel>
   </StackPanel>
  </Border>
  <Border x:Name="BusyOverlay" local:SurfaceMotion.Enabled="True" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" Margin="20" SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False" Visibility="{Binding ShowBusyPanel,Converter={StaticResource Visible}}">
   <Grid>
    <Border x:Name="BusyShadow" Background="{DynamicResource CubeFloatingSurface}" CornerRadius="16" IsHitTestVisible="False">
     <Border.Effect><DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="{DynamicResource CubeFloatingShadowOpacity}" RenderingBias="Quality"/></Border.Effect>
    </Border>
    <Border Padding="28,24" CornerRadius="16" Background="{DynamicResource CubeFloatingSurface}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="1">
   <StackPanel>
    <TextBlock x:Name="BusyMessage" AutomationProperties.LiveSetting="Off" Text="{loc:Translate Text='Preparando o palco…'}" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SectionTitle}"/>
    <local:LiveStatusText AutomationProperties.LiveSetting="Polite" Text="{loc:Translate Value={Binding BusyDetail}}" Style="{StaticResource HelpText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <ProgressBar Style="{StaticResource InfiniteProgressBar}" x:Name="OperationProgress" AutomationProperties.Name="{loc:Translate Value={Binding BusyDetail}}" Margin="0,12,0,0"/>
    <TextBlock Text="{loc:Translate Value={Binding Ir.State}}" Visibility="{Binding Ir.TransferActive,Converter={StaticResource Visible}}" Style="{StaticResource HelpText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel>
    </Border>
   </Grid>
  </Border>
  <ui:SnackbarPresenter x:Name="Notifications" VerticalAlignment="Bottom" Margin="24,0,24,20"/>
  <ui:ContentDialogHost x:Name="DialogHost"/>
  </Grid>
 </Grid>
</ui:FluentWindow>
