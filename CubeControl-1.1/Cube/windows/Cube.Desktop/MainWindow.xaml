 xmlns:views="clr-namespace:Cube.Desktop.Views"
 Icon="{DynamicResource CubeWindowIcon}" Title="CubeControl" Width="1280" Height="720" MinWidth="640" MinHeight="480" Background="{DynamicResource CubeWindowBackground}" Foreground="{DynamicResource CubeText}" FontFamily="{DynamicResource CubeUiFont}" FontSize="14" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" UseLayoutRounding="True">
 <ui:FluentWindow.Resources>
  <!-- Adapted from WPF UI InfoBar (MIT, WPF UI Contributors): expose the action content. -->
  <ControlTemplate x:Key="ActionInfoBarTemplate" TargetType="{x:Type ui:InfoBar}">
                    <Grid x:Name="InfoBarRoot">
                        <Border
                            x:Name="ContentBorder"
                            Padding="16,12"
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalAlignment}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding Border.CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,0,14,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon
                                        x:Name="SymbolIcon"
                                        VerticalAlignment="Top"
                                        Filled="True"
                                        FontSize="16" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><WrapPanel VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="TitleText"
                                        Margin="0,0,14,0"
                                        ScrollViewer.CanContentScroll="False"
                                        Text="{TemplateBinding Title}"
                                        TextElement.FontSize="{TemplateBinding FontSize}"
                                        TextElement.FontWeight="SemiBold"
                                        TextWrapping="Wrap"  Style="{StaticResource BodyStrongText}"/>

                                    <TextBlock
                                        Margin="0"
                                        ScrollViewer.CanContentScroll="False"
                                        Text="{TemplateBinding Message}"
                                        TextElement.FontSize="{TemplateBinding FontSize}"
                                        TextWrapping="Wrap"  Style="{StaticResource BodyText}"/>
                                </WrapPanel></StackPanel>
                                <ContentPresenter Grid.Column="2" ContentSource="Content" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>

                                <Border
                                    x:Name="CloseContainer" Grid.Column="3"
                                    Margin="12,-2,0,0"
                                    VerticalAlignment="Top">
                                    <ui:Button
                                        x:Name="CloseButton"
                                        Width="40" Height="40" Margin="0" Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding Path=TemplateButtonCommand, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        IsEnabled="True">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Dismiss24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="CloseContainer" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsOpen" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Collapse TitleText when Title is null or empty to release layout space -->
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Severity" Value="Informational">
                            <Setter TargetName="SymbolIcon" Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="Info24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarInformationalSeverityBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarSuccessSeverityIconBackground}" />
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="CheckmarkCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarSuccessSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarSuccessSeverityBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarWarningSeverityIconBackground}" />
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="ErrorCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarWarningSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarWarningSeverityBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarErrorSeverityIconBackground}" />
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="DismissCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarErrorSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarErrorSeverityBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
  <ControlTemplate x:Key="PreferenceMenuItemTemplate" TargetType="MenuItem">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="2">
     <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CubeSelected}"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="PreferenceMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
   <Setter Property="IsCheckable" Value="False"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>

   <Style.Triggers><DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="True">
    <Setter Property="Background" Value="{DynamicResource CubeSelected}"/>
    <Setter Property="Foreground" Value="{DynamicResource CubeSelectedText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CubeAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
   </DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="PresetTile" TargetType="ListBoxItem" BasedOn="{StaticResource SelectionTile}">
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
   <Setter Property="Height" Value="116"/><Setter Property="Margin" Value="18,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid>
     <Border x:Name="Surface" Background="{DynamicResource CubeInset}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="{DynamicResource CubeSurfaceBorderThickness}" CornerRadius="8">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <Border x:Name="SelectedMark" Background="{DynamicResource CubeAccent}" Width="28" Height="3" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CubeSelected}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource CubeSelectedText}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CubeSelected}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CubeAccent}"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CubeSelected}"/><Setter Property="Foreground" Value="{DynamicResource CubeSelectedText}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource CubeDisabledText}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CubeCard}"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Collapsed"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <DataTemplate x:Key="DialTemplate"><StackPanel Width="132" Margin="0,6,20,12" ToolTip="{loc:Translate Value={Binding Description}}">
   <TextBlock Text="{loc:Translate Value={Binding Name}}" HorizontalAlignment="Center" Margin="0,0,0,12" Style="{StaticResource BodyText}"/>
   <local:Knob Accent="{Binding DataContext.Stage.Color,RelativeSource={RelativeSource AncestorType=Window}}" Width="94" Height="94" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value,Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Value={Binding Name}}" ToolTip="{Binding Value}">
    <local:Knob.Style><Style TargetType="local:Knob"><Style.Triggers>
     <DataTrigger Binding="{Binding Name}" Value="Repetições"><Setter Property="WheelSpeedMultiplier" Value="1.3"/></DataTrigger>
     <DataTrigger Binding="{Binding Name}" Value="Mistura"><Setter Property="WheelSpeedMultiplier" Value="1.3"/></DataTrigger>
    </Style.Triggers></Style></local:Knob.Style>
   </local:Knob>

  </StackPanel></DataTemplate>
 </ui:FluentWindow.Resources>
