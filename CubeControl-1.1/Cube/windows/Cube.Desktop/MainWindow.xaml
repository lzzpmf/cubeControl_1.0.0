       <ui:SymbolIcon Symbol="SoundWaveCircle24" Style="{StaticResource NavigationIcon}"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Translate Text='IRs'}" Style="{StaticResource BodyStrongText}"/><TextBlock Text="{loc:Translate Text='Seus gabinetes'}" Style="{StaticResource SelectionSecondaryText}" Margin="0,4,0,0"/></StackPanel>
      </StackPanel></ListBoxItem>

      <ListBoxItem AutomationProperties.Name="{loc:Translate Text='Backing tracks'}"><StackPanel Orientation="Horizontal">
       <ui:SymbolIcon Symbol="MusicNote224" Style="{StaticResource NavigationIcon}"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Translate Text='Backing tracks'}" Style="{StaticResource BodyStrongText}"/><TextBlock Text="{loc:Translate Text='Toque com acompanhamento'}" Style="{StaticResource SelectionSecondaryText}" Margin="0,4,0,0"/></StackPanel>
      </StackPanel></ListBoxItem>
      <ListBoxItem ToolTip="{loc:Translate Text='Crie seu timbre e ouça os ajustes automaticamente.'}" AutomationProperties.Name="{loc:Translate Text='Criador de amps'}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" Style="{StaticResource NavigationIcon}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Translate Text='Criador de amps'}" Style="{StaticResource BodyStrongText}"/><TextBlock Text="{loc:Translate Text='Seu amplificador'}" Style="{StaticResource SelectionSecondaryText}" Margin="0,4,0,0"/></StackPanel></StackPanel></ListBoxItem>
      <ListBoxItem AutomationProperties.Name="{loc:Translate Text='Dispositivo e ajuda'}" ToolTip="{loc:Translate Text='Consulte a conexão USB, o manual e os atalhos do pedal. Acesse também a recuperação de fábrica e os registros de comunicação.'}" ToolTipService.InitialShowDelay="1200" AutomationProperties.HelpText="{loc:Translate Text='Consulte a conexão USB, o manual e os atalhos do pedal. Acesse também a recuperação de fábrica e os registros de comunicação.'}"><StackPanel Orientation="Horizontal">
