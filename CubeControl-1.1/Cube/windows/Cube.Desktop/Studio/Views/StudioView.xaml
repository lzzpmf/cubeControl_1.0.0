<UserControl x:Class="Cube.Desktop.Studio.Views.StudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Cube.Desktop.Studio"
    xmlns:controls="clr-namespace:Cube.Desktop.Studio.Controls"
    xmlns:cube="clr-namespace:Cube.Desktop.Controls"
    xmlns:views="clr-namespace:Cube.Desktop.Studio.Views"
    xmlns:loc="clr-namespace:Cube.Desktop.Localization"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
    Background="{DynamicResource CubeCanvas}" Foreground="{DynamicResource CubeText}"
    FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
    PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" Focusable="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../StudioTheme.xaml" /></ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
      <local:DecibelTextConverter x:Key="DbText" />
      <local:InverseBooleanConverter x:Key="InverseBool" />
      <local:PulseOpacityConverter x:Key="PulseOpacity" />
      <local:PlayArtConverter x:Key="PlayArt" />
      <local:PlayGlyphConverter x:Key="PlayGlyph" />
      <DataTemplate x:Key="TranslatedChoice"><TextBlock Text="{loc:Translate Value={Binding}}" /></DataTemplate>
      <DataTemplate x:Key="AttemptChoice"><TextBlock Text="{loc:Translate Value={Binding Name}}" TextTrimming="CharacterEllipsis" /></DataTemplate>
      <DataTemplate x:Key="TrackHeaderTemplate">
        <Border Background="{DynamicResource CubeCard}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="0,0,1,1" Padding="9,6">
          <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{loc:Translate Value={Binding Name}}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ToggleButton Style="{StaticResource StudioToggle}" Width="28" Height="28" IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="{loc:Translate Text='Silenciar faixa'}" AutomationProperties.Name="{loc:Translate Text='Silenciar faixa'}" AutomationProperties.HelpText="{loc:Translate Value={Binding Name}}"><ui:SymbolIcon Symbol="SpeakerMute24" FontSize="15" /></ToggleButton>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:KnobControl Width="29" Height="29" Value="{Binding VolumeDb, Mode=TwoWay}" Minimum="-61" Maximum="6" DefaultValue="0" ToolTip="{loc:Translate Text='Volume da faixa'}" AutomationProperties.Name="{loc:Translate Text='Volume da faixa'}" AutomationProperties.HelpText="{loc:Translate Value={Binding Name}}" />
                <TextBlock Text="{Binding VolumeDb, Converter={StaticResource DbText}}" Width="35" FontSize="9" TextAlignment="Right" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="PlaybackTemplate">
        <Border Background="{DynamicResource CubeCanvas}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,0,0,7" MouseEnter="Playback_MouseEnter" MouseLeave="Playback_MouseLeave">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Title}" />
            <DockPanel Grid.Row="1" Margin="0,3,0,3">
              <Button DockPanel.Dock="Right" Style="{StaticResource StudioButton}" Content="ⓘ" Padding="1,0" Width="18" MinWidth="18" Height="17" MinHeight="17" FontSize="12" Click="PlaybackDetails_Click" ToolTip="{Binding Details}" ToolTipService.ShowDuration="15000" AutomationProperties.Name="{loc:Translate Text='Autoria e origem'}" AutomationProperties.HelpText="{Binding Details}"/>
              <TextBlock Text="{Binding Metadata}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Grid Grid.Row="2" Background="{DynamicResource CubeInset}">
              <controls:WaveformPreviewControl Peaks="{Binding Peaks}" IsPlaying="{Binding IsPreviewing}" Progress="{Binding PreviewProgress}" Height="36" />
              <TextBlock Text="{Binding WaveformStatus}" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
              <ProgressBar Height="2" IsIndeterminate="True" VerticalAlignment="Bottom" Visibility="{Binding IsPreparingWaveform, Converter={StaticResource VisibleWhenTrue}}" />
            </Grid>
            <Grid Grid.Row="3" Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button Style="{StaticResource StudioButton}" Content="{Binding PreviewActionText}" FontSize="10" Padding="1,2" Command="{Binding DataContext.TogglePreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type views:StudioView}}}" CommandParameter="{Binding}" ToolTip="{loc:Translate Text='Ouvir prévia de até 30 segundos'}" />
              <Button Grid.Column="1" Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Baixar'}" FontSize="10" Padding="1,2" Command="{Binding DataContext.DownloadPlaybackCommand, RelativeSource={RelativeSource AncestorType={x:Type views:StudioView}}}" CommandParameter="{Binding}" />
              <Button Grid.Column="2" Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Usar backing'}" FontSize="10" Padding="1,2" BorderBrush="{DynamicResource CubeBorder}" Command="{Binding DataContext.UseBackingCommand, RelativeSource={RelativeSource AncestorType={x:Type views:StudioView}}}" CommandParameter="{Binding}" />
            </Grid>
            <StackPanel Grid.Row="4"><TextBlock Text="{Binding DownloadStatus}" FontSize="9" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/><ProgressBar Height="2" Minimum="0" Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay}" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhenTrue}}" /></StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <controls:StudioFitPanel>
    <Grid x:Name="RootLayout" ClipToBounds="True">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
      <Grid x:Name="StudyArea">
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="44"/><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
        <Grid Margin="9,0,7,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ui:SymbolIcon Symbol="MusicNote224" Foreground="{DynamicResource CubeAccent}" FontSize="16"/><TextBlock Text="CUBE STUDIO" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="7,0,0,0"/></StackPanel>
          <Button Grid.Column="1" Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Importar áudio'}" FontSize="11" Command="{Binding ImportCommand}" ToolTip="{loc:Translate Text='Carregar um arquivo de acompanhamento'}"/>
          <Button Grid.Column="2" Style="{StaticResource StudioIconButton}" Command="{Binding ClearStudyCommand}" ToolTip="{loc:Translate Text='Limpar estudo'}" AutomationProperties.Name="{loc:Translate Text='Limpar estudo'}"><ui:SymbolIcon Symbol="Delete24" FontSize="15"/></Button>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="0,1" Background="{DynamicResource CubeCard}" Padding="8,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource TransportButton}" Width="32" Height="32" Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayToolTip}" AutomationProperties.Name="{loc:Translate Text='Reproduzir ou pausar'}"><cube:BackingButtonFace Art="{Binding IsPlaying, Converter={StaticResource PlayArt}}" Glyph="{Binding IsPlaying, Converter={StaticResource PlayGlyph}}"/></Button>
              <Button Style="{StaticResource TransportButton}" Width="28" Height="28" Margin="5,0" Command="{Binding StopCommand}" ToolTip="{loc:Translate Text='Parar reprodução, gravação e metrônomo'}" AutomationProperties.Name="{loc:Translate Text='Parar'}"><cube:BackingButtonFace Art="stop" Glyph="■"/></Button>
              <Border Padding="1" CornerRadius="18"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Background" Value="{DynamicResource CubeWarning}"/></DataTrigger></Style.Triggers></Style></Border.Style><Button Style="{StaticResource TransportButton}" Width="30" Height="30" Command="{Binding RecordCommand}" ToolTip="{loc:Translate Text='Gravar ou concluir tentativa · R'}" AutomationProperties.Name="{loc:Translate Text='Gravar minha guitarra'}"><controls:RecordButtonFace/></Button></Border>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding TimeDisplay}" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding TransportStatus}" FontSize="9" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="125" HorizontalAlignment="Center"/></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource StudioButton}" Content="A" Width="27" Command="{Binding SetLoopStartCommand}" ToolTip="{loc:Translate Text='Marcar início A no cursor'}" AutomationProperties.Name="{loc:Translate Text='Marcar início A no cursor'}"/>
              <Button Style="{StaticResource StudioButton}" Content="B" Width="27" Command="{Binding SetLoopEndCommand}" ToolTip="{loc:Translate Text='Marcar fim B no cursor'}" AutomationProperties.Name="{loc:Translate Text='Marcar fim B no cursor'}"/>
              <ToggleButton Style="{StaticResource StudioToggle}" Width="42" Height="27" Margin="4,0,0,0" Content="A/B" IsChecked="{Binding Project.LoopEnabled, Mode=OneWay}" Command="{Binding ToggleLoopCommand}" ToolTip="{loc:Translate Text='Repetir trecho A/B · L'}" AutomationProperties.Name="{loc:Translate Text='Repetir trecho A/B'}"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="0,0,0,1" Padding="8,2">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="36"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="177"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsTempoEditable}">
                <TextBlock Text="{loc:Translate Text='Tom'}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Style="{StaticResource StudioButton}" Content="−" FontSize="18" Width="25" Command="{Binding PitchDownCommand}" ToolTip="{loc:Translate Text='Diminuir um semitom'}" AutomationProperties.Name="{loc:Translate Text='Diminuir um semitom'}"/>
                <Button Style="{StaticResource StudioButton}" Content="{Binding TransposeText}" FontSize="14" Width="62" Padding="0" Command="{Binding ResetPitchCommand}" ToolTip="{loc:Translate Text='Retornar a zero semitons'}" AutomationProperties.Name="{loc:Translate Text='Transposição em semitons'}"/>
                <Button Style="{StaticResource StudioButton}" Content="+" FontSize="18" Width="25" Command="{Binding PitchUpCommand}" ToolTip="{loc:Translate Text='Aumentar um semitom'}" AutomationProperties.Name="{loc:Translate Text='Aumentar um semitom'}"/>
              </StackPanel>
              <Grid Grid.Column="1" IsEnabled="{Binding IsTempoEditable}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="13"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Translate Text='Velocidade'}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider Grid.Column="1" Minimum="25" Maximum="200" SmallChange="1" LargeChange="5" Value="{Binding SpeedPercent, Mode=TwoWay}" Margin="0,0,5,0" VerticalAlignment="Center" AutomationProperties.Name="{loc:Translate Text='Velocidade em porcentagem'}"/>
                <TextBox x:Name="SpeedBox" Grid.Column="2" Style="{StaticResource StudioTextBox}" Height="26" Text="{Binding SpeedPercent, Mode=OneWay, StringFormat={}{0:0.#}}" TextAlignment="Center" Padding="2,0" LostKeyboardFocus="Speed_LostKeyboardFocus" KeyDown="Speed_KeyDown" AutomationProperties.Name="{loc:Translate Text='Velocidade em porcentagem'}" AutomationProperties.HelpText="25–200%" ToolTip="25–200%"/>
                <TextBlock Grid.Column="3" Text="%" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Button Grid.Column="4" Style="{StaticResource StudioButton}" Content="↺" FontSize="15" Command="{Binding ResetSpeedCommand}" ToolTip="{loc:Translate Text='Restaurar velocidade para 100%'}" AutomationProperties.Name="{loc:Translate Text='Restaurar velocidade para 100%'}"/>
              </Grid>
            </Grid>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="46"/><ColumnDefinition Width="28"/><ColumnDefinition Width="39"/><ColumnDefinition Width="58"/><ColumnDefinition Width="30"/><ColumnDefinition Width="45"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ToggleButton x:Name="MetronomeTrigger" Style="{StaticResource StudioToggle}" IsChecked="{Binding MetronomeEnabled, Mode=OneWay}" Command="{Binding ToggleMetronomeCommand}" Height="27" Margin="0,0,8,0" Padding="5,0" ToolTip="{loc:Translate Text='Metrônomo independente · M'}" AutomationProperties.Name="{loc:Translate Text='Metrônomo'}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{DynamicResource CubeAccent}" Opacity="{Binding MetronomePulse, Converter={StaticResource PulseOpacity}}" Margin="0,0,6,0"/><TextBlock Text="{loc:Translate Text='Metrônomo'}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
              </ToggleButton>
              <TextBox x:Name="TempoBox" Grid.Column="1" Style="{StaticResource StudioTextBox}" Height="26" Text="{Binding MetronomeBpm, Mode=OneWay, StringFormat={}{0:0.#}}" TextAlignment="Center" Padding="2,0" LostKeyboardFocus="Tempo_LostKeyboardFocus" KeyDown="Tempo_KeyDown" ToolTip="{loc:Translate Text='BPM do metrônomo · não altera a velocidade'}" AutomationProperties.Name="{loc:Translate Text='BPM do metrônomo'}" AutomationProperties.HelpText="30–300 BPM"/>
              <TextBlock Grid.Column="2" Text="BPM" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Button Grid.Column="3" Style="{StaticResource StudioButton}" Content="TAP" FontSize="10" Command="{Binding TapTempoCommand}" ToolTip="{Binding TapStatus}" AutomationProperties.Name="{loc:Translate Text='Tap Tempo'}"/>
              <TextBlock Grid.Column="4" Text="{loc:Translate Text='Volume'}" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <controls:KnobControl Grid.Column="5" Width="28" Height="28" Minimum="-61" Maximum="6" DefaultValue="-12" Value="{Binding MetronomeVolumeDb, Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Volume do metrônomo'}"/>
              <TextBlock Grid.Column="6" Text="{Binding MetronomeVolumeDb, Converter={StaticResource DbText}}" FontSize="9" TextAlignment="Center" VerticalAlignment="Center"/>
              <Button x:Name="MetronomeOptionsTrigger" Grid.Column="7" Style="{StaticResource StudioIconButton}" Click="MetronomeOptions_Click" ToolTip="{loc:Translate Text='Opções do metrônomo'}" AutomationProperties.Name="{loc:Translate Text='Opções do metrônomo'}"><ui:SymbolIcon Symbol="Settings24" FontSize="13"/></Button>
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource CubeCard}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="0,0,1,1"><TextBlock Text="{loc:Translate Text='ÁUDIO'}" Foreground="{DynamicResource Muted}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0"/></Border>
            <Grid x:Name="TrackHeaders" Grid.Row="1" ClipToBounds="True"/>
          </Grid>
          <controls:TimelineControl x:Name="Timeline" Grid.Column="1" Project="{Binding Project}" PracticeMode="True" SnapEnabled="False" CanEdit="{Binding CanEditTimeline}" CanSeek="{Binding CanEditTimeline}" PeakProvider="{Binding PeakProvider}" SeekRequested="Timeline_SeekRequested" EditRequested="Timeline_EditRequested" FilesDropped="Timeline_FilesDropped" AutomationProperties.Name="{loc:Translate Text='Acompanhamento e minha guitarra'}"/>
        </Grid>
        <Border Grid.Row="4" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="0,1,0,0" Background="{DynamicResource CubeCard}" Padding="7,5">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="AttemptSelector" Style="{StaticResource StudioCombo}" ItemsSource="{Binding Attempts}" SelectedItem="{Binding SelectedAttempt, Mode=TwoWay}" ItemTemplate="{StaticResource AttemptChoice}" IsEnabled="{Binding CanEditTimeline}" Margin="0,0,5,0" ToolTip="{loc:Translate Text='Tentativas de guitarra · arraste as bordas para aparar'}" AutomationProperties.Name="{loc:Translate Text='Tentativa selecionada'}"/>
            <Button Grid.Column="1" Style="{StaticResource StudioIconButton}" Command="{Binding ListenAttemptCommand}" ToolTip="{loc:Translate Text='Ouvir tentativa'}" AutomationProperties.Name="{loc:Translate Text='Ouvir tentativa'}"><ui:SymbolIcon Symbol="Play24" FontSize="14"/></Button>
            <Button Grid.Column="2" Style="{StaticResource StudioIconButton}" Command="{Binding DeleteAttemptCommand}" ToolTip="{loc:Translate Text='Excluir tentativa'}" AutomationProperties.Name="{loc:Translate Text='Excluir tentativa'}"><ui:SymbolIcon Symbol="Delete24" FontSize="14"/></Button>
            <Button Grid.Column="3" Style="{StaticResource StudioIconButton}" Content="↶" FontSize="18" Command="{Binding UndoCommand}" ToolTip="{loc:Translate Text='Desfazer · Ctrl+Z'}" AutomationProperties.Name="{loc:Translate Text='Desfazer'}"/>
            <Button Grid.Column="4" Style="{StaticResource StudioIconButton}" Content="↷" FontSize="18" Command="{Binding RedoCommand}" ToolTip="{loc:Translate Text='Refazer · Ctrl+Y'}" AutomationProperties.Name="{loc:Translate Text='Refazer'}"/>
            <Button Grid.Column="5" Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Salvar áudio'}" FontSize="11" Command="{Binding SaveAudioCommand}" BorderBrush="{DynamicResource CubeBorder}" Margin="5,0,0,0"/>
          </Grid>
        </Border>
      </Grid>
      <Border x:Name="PlaybackDrawer" Grid.Column="1" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="1,0,0,0" Background="{DynamicResource CubeCard}" Padding="9,7">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="31"/><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{loc:Translate Text='Buscar backing'}" FontWeight="SemiBold" FontSize="13"/>
          <TextBox x:Name="PlaybackQuery" Grid.Row="1" Style="{StaticResource StudioTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Translate Text='Procure por estilo, título, BPM ou tom'}" AutomationProperties.Name="{loc:Translate Text='Buscar backing'}"/>
          <DockPanel Grid.Row="2" Margin="0,3,0,3">
            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Downloader.AppendBackingTrack, Mode=TwoWay}" Content="{loc:Translate Text='Acompanhamentos'}" FontSize="9" VerticalAlignment="Center" ToolTip="{loc:Translate Text='Desmarque para busca livre'}"/>
            <TextBlock Text="{Binding ResultSummary}" Foreground="{DynamicResource Muted}" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,5,0"/>
          </DockPanel>
          <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0"><ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource PlaybackTemplate}"/></ScrollViewer>
            <TextBlock Text="{Binding NoResultsMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="3,15" IsHitTestVisible="False"/>
          </Grid>
          <StackPanel Grid.Row="4" Margin="0,4,0,0">
            <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
              <ComboBox Style="{StaticResource StudioCombo}" ItemsSource="{Binding Downloader.Outputs}" SelectedItem="{Binding Downloader.SelectedOutput, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,5,0" IsEnabled="{Binding CanPreviewPlayback}" ToolTip="{loc:Translate Text='Saída da prévia'}" AutomationProperties.Name="{loc:Translate Text='Saída da prévia'}"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Downloader.Volume, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{loc:Translate Text='Volume da prévia'}" AutomationProperties.Name="{loc:Translate Text='Volume da prévia'}"/>
            </Grid>
            <Button Style="{StaticResource StudioButton}" Command="{Binding Downloader.ChangeYouTubeDownloadFolder}" HorizontalContentAlignment="Left" MinHeight="22" Height="22" Padding="2,0" ToolTip="{loc:Translate Text='Pasta de downloads'}"><TextBlock Text="{loc:Translate Value={Binding Downloader.YouTubeDownloadFolderLabel}, PreserveFileNames=True}" FontSize="9" TextTrimming="CharacterEllipsis"/></Button>
            <TextBlock Text="{Binding DownloadStatusText}" FontSize="9" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
            <Button Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Cancelar download'}" Command="{Binding Downloader.CancelYouTubeDownload}" Visibility="{Binding Downloader.YouTubeDownloading, Converter={StaticResource VisibleWhenTrue}}" MinHeight="23" Height="23" FontSize="10"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="0,1,0,0" Background="{DynamicResource CubeCard}">
        <DockPanel Margin="6,0">
          <Button x:Name="AudioTrigger" DockPanel.Dock="Left" Style="{StaticResource StudioButton}" MinHeight="24" Height="24" Padding="3,0" Click="Audio_Click" ToolTip="{loc:Translate Text='Configurações de áudio'}" AutomationProperties.Name="{loc:Translate Text='Configurar dispositivo de áudio'}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Speaker224" FontSize="12" Foreground="{DynamicResource CubeAccent}"/><TextBlock Text="{Binding AudioSummary}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" MaxWidth="310" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
          <TextBlock Text="{Binding StatusMessage}" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0"/>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource CubeCard}" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}"><DockPanel Margin="8,0"><Button DockPanel.Dock="Right" Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Cancelar'}" Command="{Binding CancelOperationCommand}" Height="24" MinHeight="24"/><ProgressBar DockPanel.Dock="Right" Width="110" Height="4" Minimum="0" Maximum="100" Value="{Binding OperationProgress, Mode=OneWay}" Margin="8,0"/><TextBlock Text="{Binding StatusMessage}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
      <Border x:Name="MetronomeCard" Style="{StaticResource PopupSurface}" Width="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,154,8,0" Visibility="{Binding IsMetronomeOptionsOpen, Converter={StaticResource VisibleWhenTrue}}">
        <StackPanel><TextBlock Text="{loc:Translate Text='Opções do metrônomo'}" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="{loc:Translate Text='Compasso'}" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource StudioCombo}" ItemsSource="{Binding Meters}" SelectedItem="{Binding Meter, Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Compasso'}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Translate Text='Som'}" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource StudioCombo}" ItemTemplate="{StaticResource TranslatedChoice}" ItemsSource="{Binding MetronomeSounds}" SelectedItem="{Binding MetronomeSound, Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Som do metrônomo'}"/></StackPanel></Grid></StackPanel>
      </Border>
      <Border x:Name="AudioCard" Grid.RowSpan="2" Style="{StaticResource PopupSurface}" Width="350" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,26" Visibility="{Binding IsAudioOptionsOpen, Converter={StaticResource VisibleWhenTrue}}">
        <StackPanel><TextBlock Text="{loc:Translate Text='Dispositivo de áudio'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <Grid IsEnabled="{Binding CanChangeAudioSettings}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,9,6"><TextBlock Text="{loc:Translate Text='Driver'}" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource StudioCombo}" ItemsSource="{Binding Drivers}" SelectedItem="{Binding Driver, Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Driver de áudio'}"/></StackPanel>
            <Button Grid.Column="1" Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Atualizar dispositivos'}" Command="{Binding RefreshAudioDevicesCommand}" FontSize="10" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,6"><TextBlock Text="{loc:Translate Text='Saída / dispositivo ASIO'}" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource StudioCombo}" ItemsSource="{Binding Devices}" SelectedItem="{Binding Device, Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Dispositivo de saída'}"/></StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,6" IsEnabled="{Binding IsAsio, Converter={StaticResource InverseBool}}"><TextBlock Text="{loc:Translate Text='Entrada WASAPI'}" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource StudioCombo}" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding AudioInputDevice, Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Dispositivo de entrada'}"/></StackPanel>
            <StackPanel Grid.Row="3" Margin="0,0,9,6"><TextBlock Text="{loc:Translate Text='Sample rate'}" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource StudioCombo}" ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate, Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Sample rate'}"/></StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"><TextBlock Text="{loc:Translate Text='Buffer · samples'}" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource StudioCombo}" ItemsSource="{Binding BufferSizes}" SelectedItem="{Binding BufferSize, Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Buffer de áudio'}"/></StackPanel>
            <StackPanel Grid.Row="4" Grid.ColumnSpan="2"><TextBlock Text="{loc:Translate Text='Entrada da guitarra'}" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource StudioCombo}" ItemTemplate="{StaticResource TranslatedChoice}" ItemsSource="{Binding InputChannels}" SelectedItem="{Binding InputChannel, Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Entrada da guitarra'}"/></StackPanel>
          </Grid>
          <CheckBox Content="{loc:Translate Text='Retorno por software'}" IsChecked="{Binding Monitoring, Mode=TwoWay}" IsEnabled="{Binding CanChangeAudioSettings}" Margin="0,8,0,4"/>
          <DockPanel><Button DockPanel.Dock="Left" Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Painel ASIO'}" Command="{Binding AsioControlPanelCommand}" Visibility="{Binding IsAsio, Converter={StaticResource VisibleWhenTrue}}"/><Button Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Aplicar'}" Command="{Binding ApplyAudioSettingsCommand}" IsEnabled="{Binding CanChangeAudioSettings}" HorizontalAlignment="Right"/></DockPanel>
          <Button Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Recuperar gravações…'}" Command="{Binding RecoverRecordingsCommand}" HorizontalAlignment="Left" FontSize="10" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </controls:StudioFitPanel>
</UserControl>
