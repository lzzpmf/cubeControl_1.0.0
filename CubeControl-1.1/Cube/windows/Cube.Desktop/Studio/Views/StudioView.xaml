<UserControl xmlns:loc="clr-namespace:Cube.Desktop.Localization" xmlns:views="clr-namespace:Cube.Desktop.Studio.Views" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:Cube.Desktop.Studio.Controls" xmlns:cube="clr-namespace:Cube.Desktop.Controls" xmlns:local="clr-namespace:Cube.Desktop.Studio" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Cube.Desktop.Studio.Views.StudioView" Background="{DynamicResource CubeCanvas}" Foreground="{DynamicResource CubeText}" FontFamily="{DynamicResource CubeUiFont}" FontSize="{DynamicResource CubeFontSizeBody}" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" SizeChanged="Workspace_SizeChanged" Focusable="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../StudioTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
      <local:DecibelTextConverter x:Key="DbText" />
      <local:PanTextConverter x:Key="PanText" />
      <local:SampleRateTextConverter x:Key="RateText" />
      <DataTemplate x:Key="RateChoice">
        <TextBlock Text="{Binding Converter={StaticResource RateText}}" />
      </DataTemplate>
      <DataTemplate x:Key="BufferChoice">
        <TextBlock Text="{Binding StringFormat={}{0} samples}" />
      </DataTemplate>
      <Style x:Key="StudyCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12" />
      </Style>
      <DataTemplate x:Key="TranslatedChoice">
        <TextBlock Text="{loc:Translate Value={Binding}}" />
      </DataTemplate>
      <DataTemplate x:Key="AttemptChoice">
        <TextBlock Text="{loc:Translate Value={Binding Name}}" />
      </DataTemplate>
      <DataTemplate x:Key="TrackHeaderTemplate">
        <Border BorderBrush="{DynamicResource CubeBorder}" BorderThickness="1,0,0,0" Padding="16,0,0,0" Margin="12,4,0,0">
          <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{loc:Translate Text='Volume'}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
              <cube:Knob Width="42" Height="42" Minimum="-61" Maximum="6" Value="{Binding VolumeDb, Mode=TwoWay}" FineAdjustment="True" Accent="{DynamicResource CubeAccent}" AutomationProperties.Name="Volume"/>
              <TextBlock Text="{Binding VolumeDb, Converter={StaticResource DbText}}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,2,0,6"/>
              <ToggleButton Content="M" Style="{StaticResource StudioToggle}" Width="44" Height="26" IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="{loc:Translate Text='Silenciar faixa'}" AutomationProperties.Name="{loc:Translate Text='Silenciar faixa'}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <TextBlock Text="Pan" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
              <cube:Knob Width="42" Height="42" Minimum="-100" Maximum="100" Value="{Binding Pan, Mode=TwoWay}" FineAdjustment="True" Accent="{DynamicResource CubeAccent}" AutomationProperties.Name="Pan"/>
              <TextBlock Text="{Binding Pan, Converter={StaticResource PanText}}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,2,0,6"/>
              <ToggleButton Content="S" Style="{StaticResource SoloToggle}" Width="44" Height="26" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo" AutomationProperties.Name="Solo"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="PlaybackTemplate">
        <Border Margin="0,0,0,8" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource CubeBorder}" CornerRadius="6" MouseEnter="Playback_MouseEnter" MouseLeave="Playback_MouseLeave" ToolTip="{Binding Details}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource StudyCard}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource CubeSelected}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Video.DurationLabel}" Style="{StaticResource CaptionText}" Margin="8,0,0,0"/>
              <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap"/>
            </DockPanel>
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Style="{StaticResource StudioButton}" ToolTip="{Binding PreviewActionText}" AutomationProperties.Name="{Binding PreviewActionText}" Width="36" Height="34" Command="{Binding DataContext.TogglePreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type views:StudioView}}}" CommandParameter="{Binding}" Padding="4" MinHeight="28" BorderBrush="{DynamicResource CubeBorder}"><ui:SymbolIcon Symbol="Headphones24" FontSize="18"/></Button>
                <Button Style="{StaticResource StudioButton}" ToolTip="{loc:Translate Text='Adicionar à sessão'}" AutomationProperties.Name="{loc:Translate Text='Adicionar à sessão'}" Width="36" Height="34" Command="{Binding DataContext.UseBackingCommand, RelativeSource={RelativeSource AncestorType={x:Type views:StudioView}}}" CommandParameter="{Binding}" Background="{DynamicResource CubeAccent}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Padding="4" MinHeight="28" Margin="6,0,0,0"><ui:SymbolIcon Symbol="Add24" FontSize="20"/></Button>
              </StackPanel>
              <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Genre}" Style="{StaticResource HelpText}" TextWrapping="Wrap" Margin="0,0,6,0"/>
                <TextBlock Text="•" Foreground="{DynamicResource CubeAccent}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding DownloadStatus}" Style="{StaticResource HelpText}" TextWrapping="Wrap"/>
              </WrapPanel>
            </DockPanel>
            <ProgressBar Height="2" Value="{Binding DownloadProgress, Mode=OneWay}" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhenTrue}}"/>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="RootLayout" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,8">
      <Grid x:Name="WorkspaceLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0.46*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="ControlsRow" Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border x:Name="MetronomePanel" Style="{StaticResource StudyCard}" Margin="0,0,6,0" Grid.RowSpan="2" MinHeight="270">
            <StackPanel>
              <TextBlock Text="{loc:Translate Text='Metrônomo'}" Style="{StaticResource BodyStrongText}" Margin="0,0,0,16" FontSize="22" />
              <ui:ToggleSwitch x:Name="MetronomeTrigger" Content="{loc:Translate Text='Ligar / desligar'}" IsChecked="{Binding MetronomeEnabled, Mode=TwoWay}" Padding="8,0" Height="32" Margin="0,0,0,16" HorizontalAlignment="Left" />
              <Border Height="1" Background="{DynamicResource CubeBorder}" Margin="0,0,0,4"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Column="1" Grid.RowSpan="2" Width="1" HorizontalAlignment="Left" Background="{DynamicResource CubeBorder}" Margin="0,8,0,0"/>
                <StackPanel Margin="0,12,16,18">
                  <TextBlock Text="BPM" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TempoBox" Style="{StaticResource StudioTextBox}" Width="86" Height="40" Text="{Binding MetronomeBpm, Mode=OneWay, StringFormat={}{0:0.#}}" TextAlignment="Center" LostKeyboardFocus="Tempo_LostKeyboardFocus" KeyDown="Tempo_KeyDown" PreviewMouseWheel="Tempo_MouseWheel" AutomationProperties.Name="{loc:Translate Text='BPM do metrônomo'}" />
                    <Button Style="{StaticResource StudioButton}" Content="{loc:Translate Text='TAP'}" Command="{Binding TapTempoCommand}" Height="40" Margin="12,0,0,0" ToolTip="{Binding TapStatus}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,12,0,18">
                  <TextBlock Text="{loc:Translate Text='Volume do clique'}" Margin="0,0,0,6" />
                  <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                    <cube:Knob Width="64" Height="64" Minimum="-61" Maximum="6" Value="{Binding MetronomeVolumeDb, Mode=TwoWay}" FineAdjustment="True" Accent="{DynamicResource CubeAccent}" AutomationProperties.Name="Volume do metrônomo" />
                    <TextBlock Text="{Binding MetronomeVolumeDb, Converter={StaticResource DbText}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="{loc:Translate Text='Compasso'}" Margin="0,0,0,8" />
                  <ComboBox Style="{StaticResource StudioCombo}" Height="38" ItemsSource="{Binding Meters}" SelectedItem="{Binding Meter, Mode=TwoWay}" Margin="0" AutomationProperties.Name="{loc:Translate Text='Compasso'}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
                  <TextBlock Text="{loc:Translate Text='Som do metrônomo'}" Margin="0,0,0,8" />
                  <ComboBox Style="{StaticResource StudioCombo}" Height="38" ItemsSource="{Binding MetronomeSounds}" SelectedItem="{Binding MetronomeSound, Mode=TwoWay}" ItemTemplate="{StaticResource TranslatedChoice}" Margin="0" AutomationProperties.Name="{loc:Translate Text='Som do metrônomo'}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="PitchSpeedPanel" Grid.Column="1" Style="{StaticResource StudyCard}" Margin="6,0,0,0" MinHeight="190">
            <StackPanel>
              <TextBlock Text="{loc:Translate Text='Tom e velocidade'}" Style="{StaticResource BodyStrongText}" Margin="0,0,0,18" FontSize="22" />
              <StackPanel IsEnabled="{Binding IsTempoEditable}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
                  <TextBlock Text="{loc:Translate Text='Transposição'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Style="{StaticResource TransportButton}" Width="34" Height="34" Margin="0,0,6,0" Command="{Binding PitchDownCommand}" AutomationProperties.Name="{loc:Translate Text='Diminuir um semitom'}">
                    <cube:BackingButtonFace Art="pitch-down" Glyph="−" />
                  </Button>
                  <TextBlock Text="{Binding TransposeSemitonesText}" Width="90" TextAlignment="Center" VerticalAlignment="Center" />
                  <Button Style="{StaticResource TransportButton}" Width="34" Height="34" Margin="0,0,6,0" Command="{Binding PitchUpCommand}" AutomationProperties.Name="{loc:Translate Text='Aumentar um semitom'}">
                    <cube:BackingButtonFace Art="pitch-up" Glyph="+" />
                  </Button>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource CubeBorder}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="{loc:Translate Text='Velocidade'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <cube:Knob Width="60" Height="60" Minimum="25" Maximum="200" Value="{Binding SpeedPercent, Mode=TwoWay}" FineAdjustment="True" Accent="{DynamicResource CubeAccent}" AutomationProperties.Name="Velocidade em porcentagem" />
                  <TextBlock Text="{Binding SpeedText}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" Width="50" Margin="4,0,0,0" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="TransportBar" Style="{StaticResource StudyCard}" Grid.Column="1" Grid.Row="1" Margin="6,8,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Button Style="{StaticResource TransportButton}" Width="48" Height="44" Margin="8,0" Command="{Binding PlayCommand}" AutomationProperties.Name="{loc:Translate Text='Reproduzir'}">
                <cube:BackingButtonFace Art="play" Glyph="▶" />
              </Button>
              <Button Style="{StaticResource TransportButton}" Width="48" Height="44" Margin="8,0" Command="{Binding PauseCommand}" AutomationProperties.Name="{loc:Translate Text='Pausar'}">
                <cube:BackingButtonFace Art="pause" Glyph="Ⅱ" />
              </Button>
              <Button Style="{StaticResource TransportButton}" Width="48" Height="44" Margin="8,0" Command="{Binding StopCommand}" AutomationProperties.Name="{loc:Translate Text='Parar'}">
                <cube:BackingButtonFace Art="stop" Glyph="■" />
              </Button>
              <Button Style="{StaticResource TransportButton}" Width="48" Height="44" Command="{Binding RecordCommand}" AutomationProperties.Name="{loc:Translate Text='Gravar minha guitarra'}" Margin="8,0">
                <controls:RecordButtonFace IsRecording="{Binding IsRecording}" />
              </Button>
            </StackPanel>
          </Border>
        </Grid>
        <StackPanel x:Name="StudyArea" Grid.Row="1">
          <Border x:Name="BackingCard" Style="{StaticResource StudyCard}" Padding="12,4,12,8" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="158"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="94" />
              </Grid.RowDefinitions>
              <ContentControl x:Name="BackingHeader" Grid.Column="1" Grid.RowSpan="2" ContentTemplate="{StaticResource TrackHeaderTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
              <TextBlock Text="{loc:Translate Value={Binding Content.Name, ElementName=BackingHeader}}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" Margin="4,0,8,0" TextWrapping="Wrap"/>
              <controls:TimelineControl x:Name="Timeline" Grid.Row="1" VisibleTrackIndex="0" Project="{Binding Project}" PracticeMode="True" SnapEnabled="False" CanEdit="{Binding CanEditTimeline}" CanSeek="{Binding CanEditTimeline}" PeakProvider="{Binding PeakProvider}" SeekRequested="Timeline_SeekRequested" EditRequested="Timeline_EditRequested" FilesDropped="Timeline_FilesDropped" ViewChanged="Timeline_ViewChanged" AutomationProperties.Name="{loc:Translate Text='Acompanhamento'}" />
            </Grid>
          </Border>
          <Border x:Name="GuitarCard" Style="{StaticResource StudyCard}" Padding="12,4,12,8" Margin="0,0,0,8">
            <Border.ContextMenu>
              <ContextMenu Opened="ContextMenu_Opened" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem StaysOpenOnClick="True">
                  <MenuItem.Header>
                    <ComboBox x:Name="AttemptSelector" Width="250" ItemsSource="{Binding Attempts}" SelectedItem="{Binding SelectedAttempt, Mode=TwoWay}" ItemTemplate="{StaticResource AttemptChoice}" />
                  </MenuItem.Header>
                </MenuItem>
                <MenuItem Header="{loc:Translate Text='Ouvir tentativa'}" Command="{Binding ListenAttemptCommand}" />
                <MenuItem Header="{loc:Translate Text='Excluir tentativa'}" Command="{Binding DeleteAttemptCommand}" />
                <MenuItem Header="{loc:Translate Text='Desfazer'}" Command="{Binding UndoCommand}" />
                <MenuItem Header="{loc:Translate Text='Refazer'}" Command="{Binding RedoCommand}" />
              </ContextMenu>
            </Border.ContextMenu>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="158"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="94" />
              </Grid.RowDefinitions>
              <ContentControl x:Name="GuitarHeader" Grid.Column="1" Grid.RowSpan="2" ContentTemplate="{StaticResource TrackHeaderTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
              <TextBlock Text="{loc:Translate Value={Binding Content.Name, ElementName=GuitarHeader}}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" Margin="4,0,8,0" TextWrapping="Wrap"/>
              <controls:TimelineControl x:Name="GuitarTimeline" Grid.Row="1" VisibleTrackIndex="1" Project="{Binding Project}" PracticeMode="True" SnapEnabled="False" CanEdit="{Binding CanEditTimeline}" CanSeek="{Binding CanEditTimeline}" PeakProvider="{Binding PeakProvider}" SeekRequested="Timeline_SeekRequested" EditRequested="Timeline_EditRequested" FilesDropped="Timeline_FilesDropped" ViewChanged="Timeline_ViewChanged" AutomationProperties.Name="{loc:Translate Text='Minha guitarra'}" />
            </Grid>
          </Border>
          <Border x:Name="StudyActions" Style="{StaticResource StudyCard}" Padding="8">
            <WrapPanel>
              <ToggleButton Style="{StaticResource StudioToggle}" Content="Loop A/B" IsChecked="{Binding Project.LoopEnabled, Mode=OneWay}" Command="{Binding ToggleLoopCommand}" Height="32" Padding="8,0" Margin="0,0,8,0" />
              <Button Style="{StaticResource StudioButton}" Content="{loc:Translate Text='A'}" Command="{Binding SetLoopStartCommand}" Width="32" />
              <Button Style="{StaticResource StudioButton}" Content="{loc:Translate Text='B'}" Command="{Binding SetLoopEndCommand}" Width="32" Margin="0,0,8,0" />
              <Border Width="1" Height="28" Background="{DynamicResource CubeBorder}" Margin="8,0,16,0"/>
              <Button Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Importar áudio'}" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Salvar áudio'}" Command="{Binding SaveAudioCommand}" />
                <Button Style="{StaticResource StudioIconButton}" Command="{Binding ClearStudyCommand}" Margin="8,0,0,0" ToolTip="{loc:Translate Text='Limpar estudo'}" AutomationProperties.Name="{loc:Translate Text='Limpar estudo'}"><ui:SymbolIcon Symbol="Delete24" FontSize="18" /></Button>
            </WrapPanel>
          </Border>
        </StackPanel>
        <Border x:Name="PlaybackDrawer" Grid.Column="1" Style="{StaticResource StudyCard}" Margin="12,0,0,0" MinHeight="350" Grid.RowSpan="2">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource StudioIconButton}" Command="{Binding Downloader.ChangeYouTubeDownloadFolder}" ToolTip="{loc:Translate Text='Pasta de downloads'}">
                <ui:SymbolIcon Symbol="Folder24" FontSize="18" />
              </Button>
              <TextBlock Text="{loc:Translate Text='Buscar músicas'}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" />
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,8,0,8">
              <TextBox x:Name="PlaybackQuery" Style="{StaticResource StudioTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,4,8,4" ToolTip="{loc:Translate Text='Buscar por artista, faixa ou estilo...'}" Height="38" Margin="0,0,44,0" />
              <ui:SymbolIcon Symbol="Search24" FontSize="18" HorizontalAlignment="Left" Margin="8,0" IsHitTestVisible="False" />
            </Grid>
            <Grid Grid.Row="2">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="460">
                <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource PlaybackTemplate}" />
              </ScrollViewer>
              <TextBlock Text="{Binding NoResultsMessage}" Style="{StaticResource HelpText}" Margin="0,12" IsHitTestVisible="False" />
            </Grid>
            <ToggleButton Grid.Row="1" Style="{StaticResource StudioToggle}" IsChecked="{Binding Downloader.AppendBackingTrack, Mode=TwoWay}" Width="36" Height="38" Margin="0,8,0,8" ToolTip="{loc:Translate Text='Acompanhamentos'}" AutomationProperties.Name="{loc:Translate Text='Acompanhamentos'}" HorizontalAlignment="Right" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Guitar20" FontSize="20"/>
            </ToggleButton>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
    <Border x:Name="AudioFooter" Grid.Row="1" Background="{DynamicResource CubeCard}" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="0,1,0,0" Padding="8,0">
      <DockPanel>
        <Button x:Name="AudioTrigger" DockPanel.Dock="Left" Style="{StaticResource StudioButton}" Click="Audio_Click" ToolTip="{Binding AudioSummary}" AutomationProperties.Name="{loc:Translate Text='Configurar dispositivo de áudio'}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Speaker224" FontSize="16" Margin="0,0,8,0" />
            <TextBlock Text="{Binding AudioDeviceLabel}" TextTrimming="CharacterEllipsis" MaxWidth="400" VerticalAlignment="Center" />
            <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Cancelar download'}" Command="{Binding Downloader.CancelYouTubeDownload}" Visibility="{Binding Downloader.YouTubeDownloading, Converter={StaticResource VisibleWhenTrue}}" />
        <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasActionableStatus, Converter={StaticResource VisibleWhenTrue}}" Style="{StaticResource HelpText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0" />
      </DockPanel>
    </Border>
    <Border x:Name="AudioCard" Grid.RowSpan="2" Style="{StaticResource PopupSurface}" Width="440" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,42" Visibility="{Binding IsAudioOptionsOpen, Converter={StaticResource VisibleWhenTrue}}" Panel.ZIndex="20">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource StudioButton}" Width="24" Height="24" MinHeight="24" Padding="0" Click="Audio_Click" AutomationProperties.Name="{loc:Translate Text='Fechar'}" />
          <TextBlock Text="{loc:Translate Text='Configurações de áudio'}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" />
        </DockPanel>
        <Grid IsEnabled="{Binding CanChangeAudioSettings}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="108" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="108" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Translate Text='Driver'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource StudioCombo}" ItemsSource="{Binding Drivers}" SelectedValue="{Binding Driver, Mode=TwoWay}" MinHeight="34" AutomationProperties.Name="{loc:Translate Text='Driver'}" />
          </Grid>
          <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="108" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding AudioDeviceFieldLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource StudioCombo}" ItemsSource="{Binding Devices}" SelectedValue="{Binding Device, Mode=TwoWay}" MinHeight="34" AutomationProperties.Name="{Binding AudioDeviceFieldLabel}" />
          </Grid>
          <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.Style>
              <Style TargetType="Grid">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsAsio}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="108" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Translate Text='Entrada WASAPI'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource StudioCombo}" ItemsSource="{Binding InputDevices}" SelectedValue="{Binding AudioInputDevice, Mode=TwoWay}" MinHeight="34" AutomationProperties.Name="{loc:Translate Text='Entrada WASAPI'}" />
          </Grid>
          <Grid Grid.Row="3" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="108" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Translate Text='Canal de entrada'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource StudioCombo}" ItemsSource="{Binding InputChannels}" SelectedValue="{Binding InputChannel, Mode=TwoWay}" MinHeight="34" AutomationProperties.Name="{loc:Translate Text='Canal de entrada'}" />
          </Grid>
          <Grid Grid.Row="4" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="108" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Translate Text='Canais de saída'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource StudioCombo}" ItemsSource="{Binding OutputPairs}" SelectedValue="{Binding OutputPair, Mode=TwoWay}" MinHeight="34" AutomationProperties.Name="{loc:Translate Text='Canais de saída'}" />
          </Grid>
        </Grid>
        <Grid Margin="0,2,0,8" IsEnabled="{Binding CanChangeAudioSettings}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{loc:Translate Text='Taxa'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" Style="{StaticResource StudioCombo}" ItemTemplate="{StaticResource RateChoice}" ItemsSource="{Binding SampleRates}" SelectedValue="{Binding SampleRate, Mode=TwoWay}" MinHeight="34" />
          <TextBlock Grid.Column="2" Text="Buffer" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,0,0" />
          <ComboBox Grid.Column="3" Style="{StaticResource StudioCombo}" ItemTemplate="{StaticResource BufferChoice}" ItemsSource="{Binding BufferSizes}" SelectedValue="{Binding BufferSize, Mode=TwoWay}" MinHeight="34" />
        </Grid>
        <ui:ToggleSwitch Content="{loc:Translate Text='Retorno por software'}" IsChecked="{Binding Monitoring, Mode=TwoWay}" IsEnabled="{Binding CanChangeAudioSettings}" FontSize="{DynamicResource CubeFontSizeCaption}" Margin="0,0,0,10" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Painel ASIO'}" Command="{Binding AsioControlPanelCommand}" IsEnabled="{Binding IsAsio}" BorderBrush="{DynamicResource CubeBorder}" Height="32" Margin="0,0,8,0" />
          <Button Style="{StaticResource StudioButton}" Content="{loc:Translate Text='Aplicar'}" Command="{Binding ApplyAudioSettingsCommand}" Grid.Column="1" IsEnabled="{Binding CanApplyAudioSettings}" BorderBrush="{DynamicResource CubeBorder}" Height="32" />
        </Grid>
        <TextBlock Text="{loc:Translate Text='WASAPI permite selecionar entrada e saída separadamente.'}" Style="{StaticResource HelpText}" Margin="0,10,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
