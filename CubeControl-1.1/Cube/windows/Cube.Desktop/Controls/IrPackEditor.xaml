<UserControl x:Class="Cube.Desktop.Controls.IrPackEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Cube.Desktop.Controls"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization">
 <UserControl.Resources>
  <Style x:Key="PackNotice" TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="{loc:Translate Text='Packs de IRs'}" Style="{StaticResource SectionTitle}"/>
  <TextBlock Text="{loc:Translate Text='Escolha um pack ou monte até oito IRs. Revise a seleção e a distância antes de aplicar.'}" Style="{StaticResource HelpText}" Margin="0,4,0,8"/>
  <TextBlock Text="{loc:Translate Text='1 · Escolher pack'}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
  <WrapPanel Margin="0,0,0,4">
   <Grid Width="220" Margin="0,0,8,8">
   <ComboBox x:Name="PackSelector" ItemsSource="{Binding Owner.IrPackGroups}" SelectedItem="{Binding SelectedCatalogPack, Mode=OneWay}" SelectionChanged="PackSelectionChanged" IsEnabled="{Binding Owner.CanChooseIr}" MinWidth="0" AutomationProperties.Name="{loc:Translate Text='Pack de IRs'}">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
    <ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Translate Value={Binding Name}}" Style="{StaticResource BodyStrongText}" Margin="8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle>
   </ComboBox>
   <TextBlock Text="{loc:Translate Text='Montagem atual'}" Style="{StaticResource BodyText}" Margin="14,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IsDraftSelection,Converter={StaticResource Visible}}"/>
   </Grid>
   <ui:Button Content="{loc:Translate Text='Importar'}" Click="ImportClick" IsEnabled="{Binding Owner.CanChooseIr}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Exportar'}" Click="ExportClick" IsEnabled="{Binding CanExport}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Ações do pack'}" Click="OpenMenuClick" Appearance="Transparent" Margin="0,0,0,8" Visibility="{Binding CanDelete,Converter={StaticResource Visible}}" IsEnabled="{Binding Owner.CanChooseIr}">
    <ui:Button.Icon><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16"/></ui:Button.Icon>
    <ui:Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
     <MenuItem Header="{loc:Translate Text='Excluir pack'}" Command="{Binding DeletePack}"/>
    </ContextMenu></ui:Button.ContextMenu>
   </ui:Button>
  </WrapPanel>
  <TextBlock Text="{loc:Translate Value={Binding DisplayTitle}}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding PackSummary}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
  <TextBlock Text="{Binding Description}" Style="{StaticResource PackNotice}" MaxHeight="32" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Margin="0,4,0,8"/>
  <StackPanel Visibility="{Binding HasBasis,Converter={StaticResource Visible}}" Margin="0,0,0,8">
   <TextBlock Text="{loc:Translate Text='Baseado em:'}" Style="{StaticResource CaptionText}"/>
   <TextBlock Text="{Binding BasedOnName}" Style="{StaticResource PackNotice}"/>
  </StackPanel>
  <ui:InfoBar x:Name="PackCreationNotice" Severity="Warning" IsClosable="False" IsOpen="{Binding HasDraftNotice}" Visibility="{Binding HasDraftNotice,Converter={StaticResource Visible}}" Title="{loc:Translate Value={Binding DraftNoticeTitle}}" Message="{loc:Translate Value={Binding DraftNotice}}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
  <WrapPanel x:Name="PackActions" Margin="0,0,0,4">
   <WrapPanel Margin="0,0,16,8">
    <ui:Button x:Name="ReviewPackButton" Content="{loc:Translate Text='Revisar e aplicar'}" Command="{Binding Owner.ApplyIrPack}" Appearance="Primary" Margin="0,0,8,8" ToolTip="{loc:Translate Text='Compara os oito slots com o pack escolhido e aplica somente os selecionados.'}"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" FontSize="16"/></ui:Button.Icon></ui:Button>
    <ui:Button x:Name="RestorePackButton" Content="{loc:Translate Text='Restaurar IRs originais'}" Command="{Binding Owner.RestoreOriginalIrs}" Margin="0,0,0,8" ToolTip="{loc:Translate Text='Disponível quando os arquivos originais BFI/BFIN estão instalados.'}" ToolTipService.ShowOnDisabled="True"/>
   </WrapPanel>
   <WrapPanel Margin="0,0,0,8">
    <ui:Button Content="{loc:Translate Text='Salvar pack'}" Command="{Binding SavePack}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="Save24" FontSize="16"/></ui:Button.Icon></ui:Button>
    <ui:Button Content="{loc:Translate Text='Descartar alterações'}" Command="{Binding DiscardChanges}" Visibility="{Binding Dirty,Converter={StaticResource Visible}}" Margin="0,0,0,8"/>
   </WrapPanel>
  </WrapPanel>
  <TextBlock Text="{loc:Translate Text='2 · Montar ou visualizar'}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
  <local:AdaptivePanel FirstShare="0.3" Breakpoint="1040">
   <StackPanel Margin="0,0,16,16">
    <TextBlock Text="{loc:Translate Text='Biblioteca'}" Style="{StaticResource BodyStrongText}" Margin="0,0,0,8"/>
    <local:IrLibraryBrowser x:Name="PackLibrary" DataContext="{Binding PackLibrary}" IsEnabled="{Binding Owner.CanChooseIr}" PreviewMouseLeftButtonDown="LibraryMouseDown" PreviewMouseMove="LibraryMouseMove"/>
    <TextBlock Text="{loc:Translate Text='IR selecionado'}" Style="{StaticResource CaptionText}" Margin="0,12,0,4"/>
    <TextBlock Text="{loc:Translate Value={Binding SelectedIrName}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="{loc:Translate Text='Arraste um IR para um slot. Arraste os cartões para trocar suas posições.'}" Style="{StaticResource HelpText}" Margin="0,12,0,0"/>
   </StackPanel>
   <StackPanel>
    <ItemsControl ItemsSource="{Binding Slots}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:IrPackGridPanel MinimumCardWidth="180"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border x:Name="SlotCard" CornerRadius="10" Padding="12" Focusable="True" AllowDrop="True"
       PreviewMouseLeftButtonDown="SlotMouseDown" PreviewMouseMove="SlotMouseMove" PreviewKeyDown="SlotKeyDown"
       DragOver="SlotDragOver" DragLeave="SlotDragLeave" Drop="SlotDrop"
       AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Name}">
       <Border.Style><Style TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CubeInset}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CubeBorder}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CubeSurfaceBorderThickness}"/>
        <Style.Triggers>
         <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource CubeFocus}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
         <Trigger Property="Tag" Value="Drop"><Setter Property="Background" Value="{DynamicResource CubeSelected}"/><Setter Property="BorderBrush" Value="{DynamicResource CubeFocus}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
        </Style.Triggers>
       </Style></Border.Style>
       <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
        <MenuItem Header="{loc:Translate Text='Usar neste slot'}" Command="{Binding UseIr}"/>
        <MenuItem Header="{loc:Translate Text='Remover IR'}" Command="{Binding Remove}" InputGestureText="Delete"/>
        <Separator/>
        <MenuItem Header="{loc:Translate Text='Mover para o slot anterior'}" Command="{Binding MoveUp}"/>
        <MenuItem Header="{loc:Translate Text='Mover para o próximo slot'}" Command="{Binding MoveDown}"/>
       </ContextMenu></Border.ContextMenu>
       <Grid>
        <StackPanel>
         <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionText}" Height="24" VerticalAlignment="Center"/>
         <local:GearArt Kind="cab" Image="{Binding Image}" Accent="{DynamicResource CubeAccent}" Height="88" Margin="0,4,0,8" ToolTip="{loc:Translate Value={Binding ImageHint}}" AutomationProperties.HelpText="{loc:Translate Value={Binding ImageHint}}"/>
         <TextBlock Text="{loc:Translate Value={Binding Name}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="40" ToolTip="{Binding Name}"/>
         <TextBlock Text="{loc:Translate Value={Binding Problem}}" Style="{StaticResource PackNotice}" MaxHeight="32" TextTrimming="CharacterEllipsis" ToolTip="{Binding Problem}"/>
        </StackPanel>
        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding Remove}" Appearance="Transparent" Width="40" Height="40" Padding="0" AutomationProperties.Name="{loc:Translate Text='Remover IR'}" AutomationProperties.HelpText="{Binding Title}" ToolTip="{loc:Translate Text='Remover IR'}">
         <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource CubeIconButtonStyle}">
          <Setter Property="Visibility" Value="Hidden"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsMouseOver,ElementName=SlotCard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
           <DataTrigger Binding="{Binding IsKeyboardFocusWithin,ElementName=SlotCard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
           <DataTrigger Binding="{Binding ShowRemove}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
          </Style.Triggers>
         </Style></ui:Button.Style>
         <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" FontSize="16"/></ui:Button.Icon>
        </ui:Button>
        <Border Background="{DynamicResource CubeSelected}" CornerRadius="8" VerticalAlignment="Center" Padding="8" IsHitTestVisible="False">
         <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag,ElementName=SlotCard}" Value="Drop"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
         <TextBlock Text="{loc:Translate Text='Usar neste slot'}" Foreground="{DynamicResource CubeSelectedText}" HorizontalAlignment="Center"/>
        </Border>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{loc:Translate Text='A distância de cada IR será ajustada na revisão antes de aplicar.'}" Style="{StaticResource HelpText}" Margin="0,12,0,16"/>
   </StackPanel>
  </local:AdaptivePanel>
  <TextBlock Text="{loc:Translate Value={Binding Owner.PackCatalogProblems}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{loc:Translate Value={Binding Problems}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{loc:Translate Value={Binding Message}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,12"/>

 </StackPanel></Border>
</UserControl>
