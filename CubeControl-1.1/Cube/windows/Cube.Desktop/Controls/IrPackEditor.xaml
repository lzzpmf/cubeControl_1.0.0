<UserControl x:Class="Cube.Desktop.Controls.IrPackEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Cube.Desktop.Controls"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization">
 <UserControl.Resources>
  <Style x:Key="PackNotice" TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="{loc:Translate Text='Packs de IRs'}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
  <TextBlock Text="{loc:Translate Text='Organize seus IRs em packs e escolha quais slots aplicar ao pedal.'}" Style="{StaticResource HelpText}" Margin="0,6,0,12"/>
  <ComboBox x:Name="PackSelector" ItemsSource="{Binding Owner.IrPackGroups}" SelectedItem="{Binding Current, Mode=OneWay}" SelectionChanged="PackSelectionChanged" IsEnabled="{Binding Owner.CanChooseIr}" HorizontalContentAlignment="Stretch" MinWidth="0" AutomationProperties.Name="{loc:Translate Text='Pack de IRs'}">
   <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
   <ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Translate Value={Binding Name}}" Style="{StaticResource BodyStrongText}" Margin="8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle>
  </ComboBox>
  <WrapPanel Margin="0,12,0,4">
   <ui:Button Content="{loc:Translate Text='Novo pack'}" Command="{Binding NewPack}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Duplicar pack'}" Command="{Binding DuplicatePack}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Excluir pack'}" Command="{Binding DeletePack}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Importar pack…'}" Click="ImportClick" IsEnabled="{Binding Owner.CanChooseIr}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Exportar pack…'}" Click="ExportClick" IsEnabled="{Binding Owner.CanChooseIr}" Margin="0,0,8,8"/>
  </WrapPanel>
  <TextBlock Text="{loc:Translate Value={Binding DraftNotice}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{loc:Translate Text='Nome do pack'}" Style="{StaticResource BodyStrongText}" Margin="0,12,0,8"/>
  <TextBox x:Name="PackName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly}" IsEnabled="{Binding Owner.CanChooseIr}" AutomationProperties.Name="{loc:Translate Text='Nome do pack'}"/>
  <TextBlock Text="{loc:Translate Text='Descrição do pack'}" Style="{StaticResource BodyStrongText}" Margin="0,12,0,8"/>
  <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly}" IsEnabled="{Binding Owner.CanChooseIr}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="{loc:Translate Text='Descrição do pack'}"/>
  <TextBlock Text="{loc:Translate Text='Buscar IR na biblioteca'}" Style="{StaticResource BodyStrongText}" Margin="0,16,0,8"/>
  <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Translate Text='Buscar IR na biblioteca'}"/>
  <ListBox x:Name="PackLibrary" ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedIr}" Height="160" Margin="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{loc:Translate Text='Biblioteca'}">
   <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}"/></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <TextBlock Text="{loc:Translate Text='Selecione um IR da biblioteca e use-o no slot desejado. Slots vazios serão preservados.'}" Style="{StaticResource HelpText}" Margin="0,12,0,4"/>
  <TextBlock Text="{loc:Translate Text='Distância no pedal (%), independente da posição de captura do WAV.'}" Style="{StaticResource HelpText}" Margin="0,0,0,12"/>
  <ItemsControl ItemsSource="{Binding Slots}"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="{DynamicResource CubeInset}" CornerRadius="10" Padding="12" Margin="0,0,0,8" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="{DynamicResource CubeSurfaceBorderThickness}">
    <local:AdaptivePanel Breakpoint="880" FirstShare="0.4">
     <StackPanel Margin="0,0,12,8" VerticalAlignment="Center">
      <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionText}"/>
      <TextBlock Text="{loc:Translate Value={Binding Name}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel>
     <WrapPanel VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
       <TextBlock Text="{loc:Translate Text='Distância (%)'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBox Text="{Binding Distance, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanSetDistance}" MinWidth="56" MinHeight="40" VerticalContentAlignment="Center" AutomationProperties.Name="{loc:Translate Text='Distância no pedal (%)'}" AutomationProperties.HelpText="{Binding Title}"/>
      </StackPanel>
      <ui:Button Content="{loc:Translate Text='Usar IR'}" Command="{Binding UseIr}" Margin="0,0,8,8" AutomationProperties.HelpText="{Binding Title}"/>
      <ui:Button Content="{loc:Translate Text='Remover'}" Command="{Binding Remove}" Margin="0,0,8,8" AutomationProperties.HelpText="{Binding Title}"/>
      <ui:Button Command="{Binding MoveUp}" Style="{StaticResource CubeIconButtonStyle}" ToolTip="{loc:Translate Text='Mover para cima'}" AutomationProperties.Name="{loc:Translate Text='Mover para cima'}" AutomationProperties.HelpText="{Binding Title}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUp24" FontSize="16"/></ui:Button.Icon></ui:Button>
      <ui:Button Command="{Binding MoveDown}" Style="{StaticResource CubeIconButtonStyle}" ToolTip="{loc:Translate Text='Mover para baixo'}" AutomationProperties.Name="{loc:Translate Text='Mover para baixo'}" AutomationProperties.HelpText="{Binding Title}" Margin="0,0,0,8"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDown24" FontSize="16"/></ui:Button.Icon></ui:Button>
     </WrapPanel>
    </local:AdaptivePanel>
   </Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="{loc:Translate Value={Binding Owner.PackCatalogProblems}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{loc:Translate Value={Binding Problems}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{loc:Translate Value={Binding Message}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,12"/>
  <WrapPanel>
   <ui:Button Content="{loc:Translate Text='Salvar pack'}" Command="{Binding SavePack}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="Save24" FontSize="16"/></ui:Button.Icon></ui:Button>
   <ui:Button Content="{loc:Translate Text='Descartar alterações'}" Command="{Binding DiscardChanges}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Aplicar pack de IRs…'}" Command="{Binding Owner.ApplyIrPack}" Appearance="Primary" Margin="0,0,0,8" ToolTip="{loc:Translate Text='Compara os oito slots com o pack escolhido e aplica somente os selecionados.'}"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" FontSize="16"/></ui:Button.Icon></ui:Button>
  </WrapPanel>
 </StackPanel></Border>
</UserControl>
