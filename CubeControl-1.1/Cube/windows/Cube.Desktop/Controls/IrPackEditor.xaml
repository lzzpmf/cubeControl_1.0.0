<UserControl x:Class="Cube.Desktop.Controls.IrPackEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Cube.Desktop.Controls"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization">
 <UserControl.Resources>
  <Style x:Key="PackNotice" TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="{loc:Translate Text='Packs de IRs'}" Style="{StaticResource SectionTitle}"/>
  <TextBlock Text="{loc:Translate Text='Escolha um pack ou monte até oito IRs. Revise a seleção e a distância antes de aplicar.'}" Style="{StaticResource HelpText}" Margin="0,6,0,12"/>
  <TextBlock Text="{loc:Translate Text='1 · Escolher pack'}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
  <WrapPanel Margin="0,0,0,12">
   <Grid Width="220" Margin="0,0,8,8">
   <ComboBox x:Name="PackSelector" ItemsSource="{Binding Owner.IrPackGroups}" SelectedItem="{Binding Current, Mode=OneWay}" SelectionChanged="PackSelectionChanged" IsEnabled="{Binding Owner.CanChooseIr}" MinWidth="0" AutomationProperties.Name="{loc:Translate Text='Pack de IRs'}">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
    <ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Translate Value={Binding Name}}" Style="{StaticResource BodyStrongText}" Margin="8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle>
   </ComboBox>
   <TextBlock Text="{loc:Translate Text='Montagem atual'}" Style="{StaticResource BodyText}" Margin="14,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IsDraftSelection,Converter={StaticResource Visible}}"/>
   </Grid>
   <ui:Button Content="{loc:Translate Text='Criar pack'}" Command="{Binding NewPack}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Importar'}" Click="ImportClick" IsEnabled="{Binding Owner.CanChooseIr}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Exportar'}" Click="ExportClick" IsEnabled="{Binding CanExport}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Ações do pack'}" Click="OpenMenuClick" Appearance="Transparent" Margin="0,0,0,8" Visibility="{Binding CanDelete,Converter={StaticResource Visible}}" IsEnabled="{Binding Owner.CanChooseIr}">
    <ui:Button.Icon><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16"/></ui:Button.Icon>
    <ui:Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
     <MenuItem Header="{loc:Translate Text='Excluir pack'}" Command="{Binding DeletePack}"/>
    </ContextMenu></ui:Button.ContextMenu>
   </ui:Button>
  </WrapPanel>
  <TextBlock Text="{loc:Translate Value={Binding DisplayTitle}}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding PackSummary}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
  <TextBlock Text="{Binding Description}" Style="{StaticResource HelpText}" Margin="0,6,0,12"/>
  <TextBlock Text="{loc:Translate Value={Binding DraftNotice}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
  <ui:Button Content="{loc:Translate Text='Criar cópia'}" Command="{Binding DuplicatePack}" Visibility="{Binding ReadOnly,Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
  <Expander x:Name="PackDetails" Header="{loc:Translate Text='Editar detalhes'}" IsExpanded="{Binding DetailsExpanded,Mode=TwoWay}" Visibility="{Binding EditablePack,Converter={StaticResource Visible}}" Margin="0,0,0,16">
   <StackPanel IsEnabled="{Binding CanEdit}" Margin="0,12,0,0">
    <TextBlock Text="{loc:Translate Text='Nome do pack'}" Style="{StaticResource BodyStrongText}" Margin="0,0,0,8"/>
    <TextBox x:Name="PackName" MaxLength="120" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Translate Text='Nome do pack'}"/>
    <TextBlock Text="{loc:Translate Text='Descrição do pack'}" Style="{StaticResource BodyStrongText}" Margin="0,12,0,8"/>
    <TextBox MaxLength="4000" Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="{loc:Translate Text='Descrição do pack'}"/>
   </StackPanel>
  </Expander>
  <TextBlock Text="{loc:Translate Text='2 · Montar ou visualizar'}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
  <local:AdaptivePanel FirstShare="0.3" Breakpoint="1040">
   <StackPanel Margin="0,0,16,16">
    <TextBlock Text="{loc:Translate Text='Biblioteca'}" Style="{StaticResource BodyStrongText}" Margin="0,0,0,8"/>
    <local:IrLibraryBrowser x:Name="PackLibrary" DataContext="{Binding PackLibrary}" IsEnabled="{Binding Owner.CanChooseIr}"/>
    <TextBlock Text="{loc:Translate Text='IR selecionado'}" Style="{StaticResource CaptionText}" Margin="0,12,0,4"/>
    <TextBlock Text="{loc:Translate Value={Binding SelectedIrName}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="{loc:Translate Text='Selecione um IR da biblioteca e use-o no slot desejado. Slots vazios serão preservados.'}" Style="{StaticResource HelpText}" Margin="0,12,0,0"/>
   </StackPanel>
   <StackPanel>
    <ItemsControl ItemsSource="{Binding Slots}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:IrPackGridPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource CubeInset}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="{DynamicResource CubeSurfaceBorderThickness}">
       <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
         <ui:Button Grid.Column="1" Visibility="{Binding Editable,Converter={StaticResource Visible}}" Click="OpenMenuClick" Style="{StaticResource CubeIconButtonStyle}" Appearance="Transparent" AutomationProperties.Name="{loc:Translate Text='Ações do slot'}" AutomationProperties.HelpText="{Binding Title}" ToolTip="{loc:Translate Text='Ações do slot'}">
          <ui:Button.Icon><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16"/></ui:Button.Icon>
          <ui:Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
           <MenuItem Header="{loc:Translate Text='Remover'}" Command="{Binding Remove}"/>
           <Separator/>
           <MenuItem Header="{loc:Translate Text='Mover para o slot anterior'}" Command="{Binding MoveUp}"/>
           <MenuItem Header="{loc:Translate Text='Mover para o próximo slot'}" Command="{Binding MoveDown}"/>
          </ContextMenu></ui:Button.ContextMenu>
         </ui:Button>
        </Grid>
        <local:GearArt Kind="cab" Image="{Binding Image}" Accent="{DynamicResource CubeAccent}" Height="144" Margin="0,8,0,12" ToolTip="{loc:Translate Value={Binding ImageHint}}" AutomationProperties.HelpText="{loc:Translate Value={Binding ImageHint}}"/>
        <TextBlock Text="{loc:Translate Value={Binding Name}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="60" ToolTip="{Binding Name}"/>
        <TextBlock Text="{loc:Translate Value={Binding Problem}}" Style="{StaticResource PackNotice}" Margin="0,8,0,8"/>
        <ui:Button Content="{loc:Translate Text='Usar neste slot'}" Command="{Binding UseIr}" Visibility="{Binding Editable,Converter={StaticResource Visible}}" HorizontalAlignment="Stretch" AutomationProperties.HelpText="{Binding Title}" Margin="0,8,0,0"/>
        <ui:Button Content="{loc:Translate Text='Remover IR'}" Command="{Binding Remove}" Visibility="{Binding ShowRemove,Converter={StaticResource Visible}}" Appearance="Transparent" HorizontalAlignment="Stretch" AutomationProperties.HelpText="{Binding Title}"/>

       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{loc:Translate Text='A distância de cada IR será ajustada na revisão antes de aplicar.'}" Style="{StaticResource HelpText}" Margin="0,12,0,16"/>
   </StackPanel>
  </local:AdaptivePanel>
  <TextBlock Text="{loc:Translate Value={Binding Owner.PackCatalogProblems}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{loc:Translate Value={Binding Problems}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{loc:Translate Value={Binding Message}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,12"/>
  <WrapPanel>
   <ui:Button Content="{loc:Translate Text='Salvar pack'}" Command="{Binding SavePack}" Visibility="{Binding EditablePack,Converter={StaticResource Visible}}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="Save24" FontSize="16"/></ui:Button.Icon></ui:Button>
   <ui:Button Content="{loc:Translate Text='Descartar alterações'}" Command="{Binding DiscardChanges}" Visibility="{Binding Dirty,Converter={StaticResource Visible}}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='3 · Revisar e aplicar'}" Command="{Binding Owner.ApplyIrPack}" Appearance="Primary" Margin="0,0,0,8" ToolTip="{loc:Translate Text='Compara os oito slots com o pack escolhido e aplica somente os selecionados.'}"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" FontSize="16"/></ui:Button.Icon></ui:Button>
  </WrapPanel>
  <ui:Button Content="{loc:Translate Text='Restaurar IRs originais'}" Command="{Binding Owner.RestoreOriginalIrs}" Appearance="Transparent" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="{loc:Translate Text='Disponível quando os arquivos originais BFI/BFIN estão instalados.'}" ToolTipService.ShowOnDisabled="True"/>
 </StackPanel></Border>
</UserControl>
