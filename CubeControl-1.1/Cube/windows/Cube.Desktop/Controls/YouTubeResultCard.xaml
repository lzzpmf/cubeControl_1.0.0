<UserControl x:Class="Cube.Desktop.Controls.YouTubeResultCard" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization"
 MouseEnter="CardMouseEnter" MouseLeave="CardMouseLeave" Loaded="CardLoaded" Unloaded="CardUnloaded"
 IsVisibleChanged="CardVisibilityChanged" Focusable="False" AutomationProperties.Name="{Binding Title}" Margin="0,0,0,8">
 <Border CornerRadius="10" Padding="12" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="{DynamicResource CubeSurfaceBorderThickness}">
  <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource CubeInset}"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CubeSelected}"/></Trigger>
    <DataTrigger Binding="{Binding IsPreviewActive,ElementName=Root}" Value="True"><Setter Property="Background" Value="{DynamicResource CubeSelected}"/></DataTrigger>
   </Style.Triggers>
  </Style></Border.Style>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
   <ui:Button x:Name="PreviewButton" Style="{StaticResource CubeIconButtonStyle}" VerticalAlignment="Center"
    Click="PreviewClick" ToolTip="{loc:Translate Value={Binding PreviewLabel,ElementName=Root}}" AutomationProperties.Name="{loc:Translate Value={Binding PreviewLabel,ElementName=Root}}">
    <ui:SymbolIcon Symbol="{Binding PreviewIcon,ElementName=Root}" FontSize="16"/>
   </ui:Button>
   <StackPanel Grid.Column="1" Margin="12,0">
    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Channel}" Style="{StaticResource HelpText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Channel}" Margin="0,0,8,0"/>
     <TextBlock Grid.Column="1" Text="{Binding DurationLabel}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource Muted}"/>
    </Grid>
    <TextBlock Text="{loc:Translate Value={Binding StatusText,ElementName=Root}}" Style="{StaticResource HelpText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
     ToolTip="{loc:Translate Value={Binding StatusText,ElementName=Root}}" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
   <ui:Button x:Name="DownloadButton" Grid.Column="2" Style="{StaticResource CubeIconButtonStyle}" VerticalAlignment="Center"
    IsEnabled="{Binding CanDownload,ElementName=Root}" Click="DownloadClick" ToolTip="{loc:Translate Text='Baixar MP3'}" AutomationProperties.Name="{loc:Translate Text='Baixar MP3'}">
    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16"/>
   </ui:Button>
  </Grid>
 </Border>
</UserControl>
