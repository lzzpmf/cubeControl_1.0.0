<UserControl x:Class="Cube.Desktop.Controls.IrPackReview"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Cube.Desktop.Controls"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization">
 <StackPanel>
  <TextBlock Text="{loc:Translate Text='Selecione os IRs e ajuste a distância para esta aplicação. O pack salvo não será alterado.'}" Style="{StaticResource HelpText}" Margin="0,0,0,12"/>
  <WrapPanel Margin="0,0,0,12">
   <ui:Button Content="{loc:Translate Text='Selecionar todos'}" Command="{Binding SelectAll}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Desmarcar todos'}" Command="{Binding SelectNone}" Margin="0,0,0,8"/>
  </WrapPanel>
  <ItemsControl ItemsSource="{Binding Slots}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:IrPackGridPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="{DynamicResource CubeInset}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource CubeBorder}" BorderThickness="{DynamicResource CubeSurfaceBorderThickness}">
     <StackPanel>
      <CheckBox Content="{Binding Title}" IsChecked="{Binding Selected}" IsEnabled="{Binding Available}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Name}"/>
      <local:GearArt Kind="cab" Image="{Binding Image}" Accent="{DynamicResource CubeAccent}" Height="144" Margin="0,8,0,12"/>
      <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" Height="60" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
      <TextBlock Text="{loc:Translate Text='Distância (%)'}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
      <local:Knob Value="{Binding Distance,Mode=TwoWay}" Minimum="0" Maximum="99" StepSize="1" Width="94" Height="94" Accent="{DynamicResource CubeAccent}" IsEnabled="{Binding Available}" ToolTip="{Binding Distance}" AutomationProperties.Name="{loc:Translate Text='Distância no pedal (%)'}" AutomationProperties.HelpText="{Binding Title}"/>
      <TextBlock Text="{loc:Translate Value={Binding Comparison}}" Style="{StaticResource HelpText}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{loc:Translate Text='Slots preservados:'}" Style="{StaticResource CaptionText}" Margin="0,12,0,4"/>
  <TextBlock Text="{loc:Translate Value={Binding Summary}}" Style="{StaticResource HelpText}"/>
  <TextBlock Text="{loc:Translate Text='Distância no pedal (%), independente da posição de captura do WAV.'}" Style="{StaticResource HelpText}" Margin="0,12,0,0"/>
 </StackPanel>
</UserControl>
