<UserControl x:Class="Cube.Desktop.Views.GearGallery" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Cube.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Cube.Desktop.Controls">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="{loc:Translate Text='Dê um clique duplo no equipamento para aplicar ao preset em edição, ou selecione e use Aplicar seleção.'}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Style="{StaticResource BodyText}"/>
   <ListBox x:Name="Filter" SelectionChanged="FilterChanged" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,12,0,0" HorizontalAlignment="Left" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Translate Text='Categoria'}">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
      <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,4"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="72"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource CubeText}"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid>
       <Border x:Name="FilterSurface" Background="{DynamicResource CubeItemRest}" CornerRadius="{DynamicResource CubeControlCornerRadius}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
       </Border>
       <Border x:Name="FilterFocus" BorderBrush="{DynamicResource CubeFocus}" BorderThickness="1" CornerRadius="{DynamicResource CubeControlCornerRadius}" Visibility="Collapsed" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FilterSurface" Property="Background" Value="{DynamicResource CubeItemHover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="FilterSurface" Property="Background" Value="{DynamicResource CubeSelected}"/><Setter Property="Foreground" Value="{DynamicResource CubeSelectedText}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FilterFocus" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FilterSurface" Property="Background" Value="{DynamicResource CubeItemRest}"/><Setter Property="Foreground" Value="{DynamicResource CubeDisabledText}"/><Setter TargetName="FilterFocus" Property="Visibility" Value="Collapsed"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style>
    </ListBox.ItemContainerStyle>
   </ListBox>
  </StackPanel>
  <ListBox x:Name="Items" Grid.IsSharedSizeScope="True" AutomationProperties.Name="{loc:Translate Text='Equipamentos'}" MouseDoubleClick="ApplyDoubleClick" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectionTile}"><Setter Property="AutomationProperties.Name" Value="{loc:Translate Value={Binding Name}}"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Width="190" Margin="0,0,0,10" ToolTip="{loc:Translate Value={Binding Description}}"><local:GearArt Kind="{Binding Kind}" Accent="{Binding Color}" Image="{Binding Image}" Height="135" Margin="6,6,6,4"/><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="EquipmentName"/></Grid.RowDefinitions><TextBlock Text="{loc:Translate Value={Binding Name}}" TextWrapping="Wrap" Margin="0,10,0,6" Style="{StaticResource BodyText}"/></Grid><TextBlock Text="{loc:Translate Value={Binding Subtitle}}" Style="{StaticResource SelectionSecondaryText}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </Grid>
</UserControl>
