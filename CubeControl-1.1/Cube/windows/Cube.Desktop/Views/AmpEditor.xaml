<UserControl x:Class="Cube.Desktop.Views.AmpEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization"
 xmlns:controls="clr-namespace:Cube.Desktop.Controls"
 Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <UserControl.Resources>
  <SolidColorBrush x:Key="AmpAccent" Color="#8DB9AC"/>
  <SolidColorBrush x:Key="AmpBandA" Color="#FFA293"/>
  <SolidColorBrush x:Key="AmpBandB" Color="#73C6DE"/>
  <Style x:Key="AmpPanel" TargetType="Border">
   <Setter Property="Padding" Value="0,16,0,0"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="AmpScroll" TargetType="ScrollViewer">
   <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="AmpReset" TargetType="ui:Button" BasedOn="{StaticResource CubeButtonStyle}">
   <Setter Property="Appearance" Value="Transparent"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
   <Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/>
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="ToolTip" Value="{loc:Translate Text='Restaurar ajuste inicial'}"/>
   <Setter Property="AutomationProperties.Name" Value="{loc:Translate Text='Restaurar ajuste inicial'}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsModified}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AmpAccent}"/></DataTrigger>
    <DataTrigger Binding="{Binding CanRestoreIndividually}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="AmpValue">
   <StackPanel>
    <Grid>
     <ui:Button x:Name="ValueButton" Click="EditValueClick" Appearance="Transparent" Padding="4,2" MinHeight="32" HorizontalAlignment="Center" ToolTip="{loc:Translate Text='Clique ou pressione Enter para digitar. Enter confirma; Escape cancela.'}" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" AutomationProperties.ItemStatus="{loc:Translate Value={Binding ModificationState}}">
      <StackPanel Orientation="Horizontal">
       <TextBlock x:Name="ModifiedDot" Text="●" Visibility="Hidden" Margin="0,0,4,0" Foreground="{DynamicResource AmpAccent}"/>
       <TextBlock x:Name="NumberText" Text="{Binding Display}"/>
      </StackPanel>
     </ui:Button>
     <TextBox x:Name="ValueEditor" Visibility="Collapsed" MinWidth="72" MinHeight="32" Padding="4,2" HorizontalContentAlignment="Center" KeyDown="ValueEditorKeyDown" LostKeyboardFocus="ValueEditorLostFocus" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" ToolTip="{Binding RangeText}"/>
    </Grid>
    <TextBlock x:Name="ValueError" Visibility="Collapsed" Text="{loc:Translate Text='Valor inválido ou fora da faixa.'}" Foreground="{DynamicResource CubeWarning}" TextWrapping="Wrap" FontSize="12"/>
   </StackPanel>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding IsModified}" Value="True"><Setter TargetName="ModifiedDot" Property="Visibility" Value="Visible"/><Setter TargetName="NumberText" Property="FontWeight" Value="SemiBold"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="AmpDial">
   <StackPanel Width="148" Margin="0,4,12,12" ToolTip="{loc:Translate Value={Binding Detail}}" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <TextBlock Text="{loc:Translate Value={Binding Label}}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <controls:Knob Value="{Binding Position,Mode=TwoWay}" Accent="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ItemsControl}}" Minimum="0" Maximum="1000" FineAdjustment="True" WheelSpeedMultiplier="10" Width="94" Height="94" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" AutomationProperties.ItemStatus="{loc:Translate Value={Binding ModificationState}}" ToolTip="{loc:Translate Text='Arraste ou role para ajustar. Shift permite ajuste fino.'}"/>
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AmpValue}"/>
    <TextBlock Text="{loc:Translate Value={Binding Caption}}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"/>
    <ui:Button Click="ResetControlClick" Style="{StaticResource AmpReset}"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" FontSize="16"/></ui:Button.Icon></ui:Button>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="AmpEqDial">
   <Grid Width="216" Margin="0,4,12,8" ToolTip="{loc:Translate Value={Binding Detail}}" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <controls:Knob Value="{Binding Position,Mode=TwoWay}" Accent="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ItemsControl}}" Minimum="0" Maximum="1000" FineAdjustment="True" WheelSpeedMultiplier="10" Width="78" Height="78" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" AutomationProperties.ItemStatus="{loc:Translate Value={Binding ModificationState}}" ToolTip="{loc:Translate Text='Arraste ou role para ajustar. Shift permite ajuste fino.'}"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="{loc:Translate Value={Binding Label}}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
     <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AmpValue}"/>
    </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="AmpFader">
   <StackPanel Width="144" Margin="4,4,4,12" ToolTip="{loc:Translate Value={Binding Detail}}">
    <TextBlock Text="{Binding Code}" TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12"/>
    <TextBlock Text="{loc:Translate Value={Binding Label}}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" MinHeight="40"/>
    <controls:Knob Value="{Binding Position,Mode=TwoWay}" Accent="{DynamicResource AmpAccent}" Minimum="0" Maximum="1000" FineAdjustment="True" WheelSpeedMultiplier="11.5" IsFader="True" Width="64" Height="164" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" AutomationProperties.ItemStatus="{loc:Translate Value={Binding ModificationState}}" ToolTip="{loc:Translate Text='Arraste ou role para ajustar. Shift permite ajuste fino.'}"/>
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AmpValue}"/>
    <ui:Button Click="ResetControlClick" Style="{StaticResource AmpReset}"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" FontSize="16"/></ui:Button.Icon></ui:Button>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="AmpSegment">
   <StackPanel Width="88" Margin="4,4,4,12">
    <TextBlock Text="{loc:Translate Value={Binding Label}}" TextAlignment="Center" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding IndexRange}" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" ToolTip="{loc:Translate Text='Índices na tabela interna'}"/>
    <controls:Knob Value="{Binding Position,Mode=TwoWay}" Accent="{DynamicResource AmpAccent}" Minimum="0" Maximum="1000" FineAdjustment="True" WheelSpeedMultiplier="11.5" IsFader="True" Width="64" Height="164" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" AutomationProperties.ItemStatus="{loc:Translate Value={Binding ModificationState}}" ToolTip="{loc:Translate Text='Arraste ou role para ajustar. Shift permite ajuste fino.'}"/>
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AmpValue}"/>
    <ui:Button Click="ResetControlClick" Style="{StaticResource AmpReset}"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowReset24" FontSize="16"/></ui:Button.Icon></ui:Button>
   </StackPanel>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="AmpWrap"><WrapPanel/></ItemsPanelTemplate>
 </UserControl.Resources>
 <DockPanel Margin="0,0,0,16">
  <StackPanel DockPanel.Dock="Top">
   <Grid x:Name="AmpHeader">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="{loc:Translate Text='Criador de amps'}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="{loc:Translate Value={Binding Amp.Name}}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,4,0,12">
      <TextBlock Text="{loc:Translate Value={Binding Amp.LocalState}}" Foreground="{DynamicResource AmpAccent}" Margin="0,0,12,0"/>
      <TextBlock Text="{loc:Translate Value={Binding AmpSource}}" Foreground="{DynamicResource Muted}"/>
     </WrapPanel>
     <TextBlock Text="{loc:Translate Text='Modelo base'}" Foreground="{DynamicResource Muted}" FontSize="12"/>
     <ComboBox x:Name="BaseSelector" IsEnabled="{Binding CanEditAmpLocally}" SelectionChanged="BaseSelected" SelectedIndex="-1" HorizontalAlignment="Left" MinWidth="240" MaxWidth="360" Margin="0,4,0,8" AutomationProperties.Name="{loc:Translate Text='Escolha um amp base'}" ToolTip="{loc:Translate Text='Carrega um modelo para edição. Não indica o amp fisicamente ativo.'}"/>
     <WrapPanel IsEnabled="{Binding CanEditAmpLocally}">
      <ui:Button Content="{loc:Translate Text='Importar preset'}" Click="ImportClick" Margin="0,0,8,8" ToolTip="{loc:Translate Text='Carrega um preset do computador e aplica ao som atual.'}"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16"/></ui:Button.Icon></ui:Button>
      <ui:Button Content="{loc:Translate Text='Exportar preset'}" Click="ExportClick" IsEnabled="{Binding Amp.Loaded}" Margin="0,0,8,8" ToolTip="{loc:Translate Text='Salva os ajustes atuais em um preset no computador.'}"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUpload24" FontSize="16"/></ui:Button.Icon></ui:Button>
     </WrapPanel>
    </StackPanel>
    <StackPanel x:Name="GlobalControls" Grid.Column="1" IsEnabled="{Binding CanAdjustAmp}">
     <ItemsControl ItemsSource="{Binding Amp.MainControls}" Foreground="{DynamicResource AmpAccent}" ItemTemplate="{StaticResource AmpDial}" ItemsPanel="{StaticResource AmpWrap}"/>
     <TextBlock Text="{loc:Translate Text='Referência carregada: 1×'}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
    </StackPanel>
   </Grid>
   <ListBox x:Name="AmpSections" SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Translate Text='Seções do amp'}">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectionTile}">
     <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,4"/>
     <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}"/>
     <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AmpAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
    </Style></ListBox.ItemContainerStyle>
    <ListBoxItem Content="{loc:Translate Text='Equalização'}"/>
    <ListBoxItem Content="{loc:Translate Text='Corpo e textura'}"/>
    <ListBoxItem Content="{loc:Translate Text='Caráter e definição'}"/>
    <ListBoxItem Content="{loc:Translate Text='Resposta'}" ToolTip="{loc:Translate Text='Ajustes por trecho'}"/>
   </ListBox>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock Text="{loc:Translate Value={Binding AmpSavedMessage}}" Foreground="{DynamicResource AmpAccent}"/>
   <WrapPanel Margin="0,0,0,8"><TextBlock Text="{loc:Translate Text='Destino ao salvar:'}" Margin="0,0,8,0" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Amp.Destination}" TextWrapping="Wrap"/></WrapPanel>
   <TextBlock x:Name="AmpFeedback" Text="{loc:Translate Value={Binding AmpPreviewMessage}}" TextWrapping="Wrap" Margin="0,0,0,6"/>
   <WrapPanel>
    <ui:Button Content="{loc:Translate Text='Restaurar som anterior'}" Click="RestoreClick" ToolTip="{loc:Translate Text='Volta ao som anterior à edição, sem apagar presets.'}" IsEnabled="{Binding CanRestoreAmp}" Margin="0,0,8,8"/>
    <ui:Button Content="{loc:Translate Text='Salvar no pedal'}" Click="WriteClick" ToolTip="{loc:Translate Text='Grava no slot do amp selecionado após confirmação.'}" IsEnabled="{Binding CanSaveAmp}" Appearance="Primary" Margin="0,0,0,8"/>
   </WrapPanel>
  </StackPanel>
  <Grid IsEnabled="{Binding CanAdjustAmp}">
   <TabControl SelectedIndex="{Binding SelectedIndex,ElementName=AmpSections}" Style="{StaticResource HiddenTabs}" IsEnabled="{Binding Amp.Loaded}">
    <TabItem><ScrollViewer Style="{StaticResource AmpScroll}"><Border Style="{StaticResource AmpPanel}"><StackPanel>
     <DockPanel Margin="0,12,0,12">
      <TextBlock Text="{loc:Translate Text='Equalização'}" FontSize="18" FontWeight="SemiBold"/>
      <ComboBox x:Name="EqPresentation" ToolTip="{loc:Translate Text='Alterne entre gráfico e controles clássicos.'}" SelectedIndex="1" Width="150" HorizontalAlignment="Right" AutomationProperties.Name="{loc:Translate Text='Apresentação do EQ'}">
       <ComboBoxItem Content="{loc:Translate Text='Clássico'}"/><ComboBoxItem Content="{loc:Translate Text='Moderno'}"/>
      </ComboBox>
     </DockPanel>
     <WrapPanel>
      <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=EqPresentation}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
      <StackPanel Margin="0,0,24,12">
       <TextBlock Text="EQ A" Foreground="{DynamicResource AmpBandA}" FontWeight="SemiBold"/>
       <ItemsControl ItemsSource="{Binding Amp.EqAControls}" Foreground="{DynamicResource AmpBandA}" ItemTemplate="{StaticResource AmpDial}" ItemsPanel="{StaticResource AmpWrap}"/>
       <ui:Button Content="{loc:Translate Text='Restaurar banda'}" Click="ResetBandClick" Tag="0" Appearance="Transparent" HorizontalAlignment="Left" IsEnabled="{Binding Amp.ChangeEqA}"/>
      </StackPanel>
      <StackPanel Margin="0,0,0,12">
       <TextBlock Text="EQ B" Foreground="{DynamicResource AmpBandB}" FontWeight="SemiBold"/>
       <ItemsControl ItemsSource="{Binding Amp.EqBControls}" Foreground="{DynamicResource AmpBandB}" ItemTemplate="{StaticResource AmpDial}" ItemsPanel="{StaticResource AmpWrap}"/>
       <ui:Button Content="{loc:Translate Text='Restaurar banda'}" Click="ResetBandClick" Tag="1" Appearance="Transparent" HorizontalAlignment="Left" IsEnabled="{Binding Amp.ChangeEqB}"/>
      </StackPanel>
     </WrapPanel>
     <Grid x:Name="ModernEq">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=EqPresentation}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="EqPlot">
       <WrapPanel Margin="0,0,0,8">
        <TextBlock Text="A ━" Foreground="{DynamicResource AmpBandA}" FontWeight="SemiBold" Margin="0,0,16,0"/>
        <TextBlock Text="B ┄" Foreground="{DynamicResource AmpBandB}" FontWeight="SemiBold" Margin="0,0,16,0"/>
        <TextBlock Text="{loc:Translate Text='Combinada'}" Foreground="{DynamicResource Muted}"/>
       </WrapPanel>
       <controls:AmpEqGraph x:Name="EqGraph" ToolTip="{loc:Translate Text='Arraste A ou B: horizontal altera frequência; vertical altera reforço/corte.'}" Model="{Binding Amp}" BandABrush="{DynamicResource AmpBandA}" BandBBrush="{DynamicResource AmpBandB}" SelectedFilter="{Binding SelectedIndex,ElementName=EqFilter,Mode=TwoWay}" Height="320" AutomationProperties.Name="{loc:Translate Text='Equalização'}"/>
       <TextBlock Text="{loc:Translate Text='Resposta calculada dos dois filtros; não é uma medição do amp.'}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,12,8"/>
      </StackPanel>
      <StackPanel x:Name="EqControlsPanel" Grid.Column="1" Margin="12,0,0,0">
       <ComboBox x:Name="EqFilter" ToolTip="{loc:Translate Text='Escolha a banda que deseja ajustar.'}" AutomationProperties.Name="{loc:Translate Text='Banda do equalizador'}" SelectedIndex="0" Width="110" HorizontalAlignment="Left"><ComboBoxItem Content="EQ A"/><ComboBoxItem Content="EQ B"/></ComboBox>
       <TextBlock x:Name="EqSelectionStatus" Foreground="{DynamicResource Muted}" Margin="0,4,0,8">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Translate Text='Referência carregada'}"/><Style.Triggers>
         <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex,ElementName=EqFilter}" Value="0"/><Condition Binding="{Binding Amp.ChangeEqA}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="{loc:Translate Text='Banda alterada'}"/></MultiDataTrigger>
         <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex,ElementName=EqFilter}" Value="1"/><Condition Binding="{Binding Amp.ChangeEqB}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="{loc:Translate Text='Banda alterada'}"/></MultiDataTrigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <ItemsControl x:Name="SelectedEqControls" ItemTemplate="{StaticResource AmpEqDial}" ItemsPanel="{StaticResource AmpWrap}">
        <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="ItemsSource" Value="{Binding Amp.EqAControls}"/><Setter Property="Foreground" Value="{DynamicResource AmpBandA}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=EqFilter}" Value="1"><Setter Property="ItemsSource" Value="{Binding Amp.EqBControls}"/><Setter Property="Foreground" Value="{DynamicResource AmpBandB}"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
       </ItemsControl>
       <ui:Button Content="{loc:Translate Text='Restaurar banda'}" Click="ResetBandClick" Tag="{Binding SelectedIndex,ElementName=EqFilter}" Appearance="Transparent" HorizontalAlignment="Left">
        <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource CubeButtonStyle}"><Setter Property="IsEnabled" Value="{Binding Amp.ChangeEqA}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=EqFilter}" Value="1"><Setter Property="IsEnabled" Value="{Binding Amp.ChangeEqB}"/></DataTrigger></Style.Triggers></Style></ui:Button.Style>
       </ui:Button>
      </StackPanel>
     </Grid>

    </StackPanel></Border></ScrollViewer></TabItem>
    <TabItem><ScrollViewer Style="{StaticResource AmpScroll}"><Border Style="{StaticResource AmpPanel}"><StackPanel>
     <TextBlock Text="{loc:Translate Text='Descrições baseadas em escuta'}" Foreground="{DynamicResource Muted}"/>
     <TextBlock Text="{loc:Translate Text='100% mantém a referência carregada.'}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,12"/>
     <WrapPanel>
      <StackPanel x:Name="AFirstGroup" MaxWidth="760" Margin="0,0,24,12">
       <TextBlock Text="A01–A05" Foreground="{DynamicResource Muted}" Margin="4,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Amp.CoefficientASections[0]}" ItemTemplate="{StaticResource AmpFader}" ItemsPanel="{StaticResource AmpWrap}"/>
      </StackPanel>
      <StackPanel x:Name="ASecondGroup" MaxWidth="456" Margin="0,0,0,12">
       <TextBlock Text="{loc:Translate Text='Suavidade · A06–A08'}" FontWeight="SemiBold" Margin="4,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Amp.CoefficientASections[1]}" ItemTemplate="{StaticResource AmpFader}" ItemsPanel="{StaticResource AmpWrap}"/>
      </StackPanel>
     </WrapPanel>
    </StackPanel></Border></ScrollViewer></TabItem>
    <TabItem><ScrollViewer Style="{StaticResource AmpScroll}"><Border Style="{StaticResource AmpPanel}"><StackPanel>
     <TextBlock Text="{loc:Translate Text='Descrições baseadas em escuta'}" Foreground="{DynamicResource Muted}"/>
     <TextBlock Text="{loc:Translate Text='100% mantém a referência carregada.'}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,12"/>
     <WrapPanel>
      <StackPanel x:Name="BFirstGroup" MaxWidth="456" Margin="0,0,24,12">
       <TextBlock Text="B01–B03" Foreground="{DynamicResource Muted}" Margin="4,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Amp.CoefficientBSections[0]}" ItemTemplate="{StaticResource AmpFader}" ItemsPanel="{StaticResource AmpWrap}"/>
      </StackPanel>
      <StackPanel x:Name="BSecondGroup" MaxWidth="456" Margin="0,0,24,12">
       <TextBlock Text="{loc:Translate Text='Corpo grave · B04–B06'}" FontWeight="SemiBold" Margin="4,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Amp.CoefficientBSections[1]}" ItemTemplate="{StaticResource AmpFader}" ItemsPanel="{StaticResource AmpWrap}"/>
      </StackPanel>
      <StackPanel x:Name="BThirdGroup" MaxWidth="304" Margin="0,0,0,12">
       <TextBlock Text="{loc:Translate Text='Definição · B07–B08'}" FontWeight="SemiBold" Margin="4,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Amp.CoefficientBSections[2]}" ItemTemplate="{StaticResource AmpFader}" ItemsPanel="{StaticResource AmpWrap}"/>
      </StackPanel>
     </WrapPanel>
    </StackPanel></Border></ScrollViewer></TabItem>
    <TabItem><ScrollViewer Style="{StaticResource AmpScroll}"><Border Style="{StaticResource AmpPanel}"><StackPanel>
     <TextBlock Text="{loc:Translate Text='Ajustes por trecho'}" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="{loc:Translate Text='Cada controle ajusta 16 valores da tabela. 100% mantém a referência carregada.'}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
     <ItemsControl ItemsSource="{Binding Amp.CurveControls}" ItemTemplate="{StaticResource AmpSegment}" ItemsPanel="{StaticResource AmpWrap}" MaxWidth="768" HorizontalAlignment="Left"/>
    </StackPanel></Border></ScrollViewer></TabItem>
   </TabControl>
  </Grid>
 </DockPanel>
</UserControl>
