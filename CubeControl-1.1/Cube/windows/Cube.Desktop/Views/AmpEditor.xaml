<UserControl x:Class="Cube.Desktop.Views.AmpEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization"
 xmlns:controls="clr-namespace:Cube.Desktop.Controls"
 Background="Transparent" Foreground="{DynamicResource CubeText}">
 <UserControl.Resources>
  <Style x:Key="AmpPanel" TargetType="Border">
   <Setter Property="Padding" Value="0,16,0,0"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="AmpScroll" TargetType="ScrollViewer">
   <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/></DataTrigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="AmpValue">
   <StackPanel>
    <Grid>
     <ui:Button x:Name="ValueButton" Click="EditValueClick" Appearance="Transparent" HorizontalAlignment="Center" ToolTip="{loc:Translate Text='Clique ou pressione Enter para digitar. Enter confirma; Escape cancela.'}" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" AutomationProperties.ItemStatus="{loc:Translate Value={Binding ModificationState}}">
      <StackPanel Orientation="Horizontal">
       <TextBlock x:Name="ModifiedDot" Text="●" Visibility="Hidden" Margin="0,0,4,0" Foreground="{DynamicResource CubeAmpAccent}"/>
       <TextBlock x:Name="NumberText" Text="{Binding Display}"/>
      </StackPanel>
     </ui:Button>
     <TextBox x:Name="ValueEditor" Visibility="Collapsed" MinWidth="72" MinHeight="32" Padding="4,2" HorizontalContentAlignment="Center" KeyDown="ValueEditorKeyDown" LostKeyboardFocus="ValueEditorLostFocus" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" ToolTip="{Binding RangeText}"/>
    </Grid>
    <TextBlock x:Name="ValueError" Visibility="Collapsed" Text="{loc:Translate Text='Valor inválido ou fora da faixa.'}" Foreground="{DynamicResource CubeWarning}" TextWrapping="Wrap" FontSize="{DynamicResource CubeFontSizeCaption}"/>
   </StackPanel>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding IsModified}" Value="True"><Setter TargetName="ModifiedDot" Property="Visibility" Value="Visible"/><Setter TargetName="NumberText" Property="FontWeight" Value="SemiBold"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="AmpDial">
   <StackPanel Width="148" Margin="0,4,12,12" ToolTip="{loc:Translate Value={Binding Detail}}" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <TextBlock Text="{loc:Translate Value={Binding Label}}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" MinHeight="24"/>
    <controls:Knob RestoreRequested="RestoreControlRequested" Value="{Binding Position,Mode=TwoWay}" Accent="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ItemsControl}}" Minimum="0" Maximum="1000" FineAdjustment="True" WheelSpeedMultiplier="10" Width="94" Height="94" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" AutomationProperties.ItemStatus="{loc:Translate Value={Binding ModificationState}}" ToolTip="{loc:Translate Text='Arraste ou role para ajustar. Shift permite ajuste fino. Duplo clique restaura o ajuste inicial; Backspace também.'}"/>
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AmpValue}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="AmpEqDial">
   <Grid Width="216" Margin="0,4,12,8" ToolTip="{loc:Translate Value={Binding Detail}}" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <controls:Knob RestoreRequested="RestoreControlRequested" Value="{Binding Position,Mode=TwoWay}" Accent="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ItemsControl}}" Minimum="0" Maximum="1000" FineAdjustment="True" WheelSpeedMultiplier="10" Width="78" Height="78" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" AutomationProperties.ItemStatus="{loc:Translate Value={Binding ModificationState}}" ToolTip="{loc:Translate Text='Arraste ou role para ajustar. Shift permite ajuste fino. Duplo clique restaura o ajuste inicial; Backspace também.'}"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="{loc:Translate Value={Binding Label}}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
     <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AmpValue}"/>
    </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="AmpFader">
   <StackPanel Width="144" Margin="4,4,4,12" ToolTip="{loc:Translate Value={Binding Detail}}">
    <TextBlock Text="{Binding Code}" TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource CubeFontSizeCaption}"/>
    <TextBlock Text="{loc:Translate Value={Binding Label}}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" MinHeight="40"/>
    <controls:Knob RestoreRequested="RestoreControlRequested" Value="{Binding Position,Mode=TwoWay}" Accent="{DynamicResource CubeAmpAccent}" Minimum="0" Maximum="1000" FineAdjustment="True" WheelSpeedMultiplier="11.5" IsFader="True" Width="64" Height="164" AutomationProperties.Name="{loc:Translate Value={Binding Label}}" AutomationProperties.ItemStatus="{loc:Translate Value={Binding ModificationState}}" ToolTip="{loc:Translate Text='Arraste ou role para ajustar. Shift permite ajuste fino. Duplo clique restaura o ajuste inicial; Backspace também.'}"/>
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AmpValue}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="CapacitorPanel">
   <Border Padding="20" CornerRadius="{DynamicResource CubeCardCornerRadius}">
    <Border.Style><Style TargetType="Border">
     <Setter Property="Background" Value="Transparent"/>
     <Style.Triggers><DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
      <Setter Property="Background" Value="{DynamicResource CubeInset}"/>
     </DataTrigger></Style.Triggers>
    </Style></Border.Style>
    <StackPanel>
     <TextBlock Text="{loc:Translate Value={Binding Title}}" FontSize="{DynamicResource CubeFontSizeSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource CubeFontSizeCaption}" Foreground="{DynamicResource Muted}" Margin="0,3,0,12"/>
     <WrapPanel HorizontalAlignment="Center">
      <StackPanel Width="200" Margin="0,0,8,8">
       <ComboBox ItemsSource="{Binding Profiles}" SelectedIndex="{Binding ProfileIndex,Mode=TwoWay}" HorizontalContentAlignment="Center" Padding="12,8" Background="{DynamicResource CubeCapacitorDisplay}" Foreground="{DynamicResource CubeCapacitorAccent}"
                 AutomationProperties.Name="{loc:Translate Value={Binding Title}}" ToolTip="{loc:Translate Text='Capacitâncias são referências de timbre. Escolha um perfil para ouvir.'}">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:Translate Value={Binding Label}}"/></DataTemplate></ComboBox.ItemTemplate>
       </ComboBox>
       <controls:Knob RestoreRequested="RestoreCapacitorRequested" Value="{Binding ProfileIndex,Mode=TwoWay}" Minimum="0" Maximum="5" StepSize="1" Face="{Binding SelectorFace}" Accent="{DynamicResource CubeCapacitorAccent}" Width="132" Height="132" Margin="0,10,0,6"
                      AutomationProperties.Name="{loc:Translate Value={Binding Title}}" AutomationProperties.ItemStatus="{loc:Translate Value={Binding SelectedProfile.Label}}" ToolTip="{loc:Translate Text='Gire para escolher um perfil. Home retorna a Original. Duplo clique ou Backspace restaura o original.'}"/>
       <TextBlock Text="{loc:Translate Text='Mais magro ↔ Mais gordo'}" TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource CubeFontSizeCaption}"/>
      </StackPanel>
      <StackPanel Width="160" Margin="0,8,16,8">
       <TextBlock Text="{loc:Translate Text='Intensidade'}" TextAlignment="Center" FontWeight="SemiBold"/>
       <controls:Knob RestoreRequested="RestoreCapacitorRequested" Value="{Binding Intensity,Mode=TwoWay}" Minimum="0" Maximum="100" FineAdjustment="True" Face="{Binding IntensityFace}" Accent="{DynamicResource CubeCapacitorAccent}" IsEnabled="{Binding IsActive}" Width="96" Height="96" Margin="0,16,0,4"
                      AutomationProperties.Name="{loc:Translate Text='Intensidade do perfil'}" AutomationProperties.ItemStatus="{Binding IntensityDisplay}" ToolTip="{loc:Translate Text='Dose o perfil de 0 a 100%. Shift permite ajuste fino. Duplo clique ou Backspace restaura o original.'}"/>
       <TextBlock Text="{Binding IntensityDisplay}" TextAlignment="Center" FontSize="{DynamicResource CubeFontSizeBody}" Foreground="{DynamicResource CubeCapacitorAccent}"/>
       <TextBlock Text="{loc:Translate Text='0% preserva o original'}" FontSize="{DynamicResource CubeFontSizeCaption}" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
      </StackPanel>
     </WrapPanel>
     <TextBlock Text="{loc:Translate Value={Binding SelectedProfile.Description}}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,8"/>

    </StackPanel>
   </Border>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="AmpWrap"><WrapPanel/></ItemsPanelTemplate>
 </UserControl.Resources>
 <DockPanel Margin="0,0,0,16">
  <StackPanel DockPanel.Dock="Top">
   <Grid x:Name="AmpHeader">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="{loc:Translate Text='Criador de amps'}" Style="{StaticResource CubePageTitle}"/>
     <TextBlock Text="{loc:Translate Value={Binding Amp.Name}}" FontSize="{DynamicResource CubeFontSizeSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,4,0,12">
      <TextBlock Text="{loc:Translate Value={Binding Amp.LocalState}}" Foreground="{DynamicResource CubeAmpAccent}" Margin="0,0,12,0"/>
      <TextBlock Text="{loc:Translate Value={Binding AmpSource}}" Foreground="{DynamicResource Muted}"/>
     </WrapPanel>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,12,0,0">
     <TextBlock Text="{loc:Translate Text='Modelo base'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource CubeFontSizeCaption}"/>
     <ComboBox x:Name="BaseSelector" Style="{DynamicResource {x:Type ComboBox}}" IsEnabled="{Binding CanEditAmpLocally}" SelectionChanged="BaseSelected" SelectedIndex="-1" HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=PresetActions}" Margin="0,4,0,8" AutomationProperties.Name="{loc:Translate Text='Escolha um amp base'}" ToolTip="{loc:Translate Text='Carrega um modelo para edição. Não indica o amp fisicamente ativo.'}"/>
     <WrapPanel x:Name="PresetActions" HorizontalAlignment="Left" IsEnabled="{Binding CanEditAmpLocally}">
      <ui:Button Content="{loc:Translate Text='Importar preset'}" Click="ImportClick" Margin="0,0,8,8" ToolTip="{loc:Translate Text='Carrega um preset do computador e aplica ao som atual.'}"><ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconArrowDownload24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon></ui:Button>
      <ui:Button Content="{loc:Translate Text='Exportar preset'}" Click="ExportClick" IsEnabled="{Binding Amp.Loaded}" Margin="0,0,0,8" ToolTip="{loc:Translate Text='Salva os ajustes atuais em um preset no computador.'}"><ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconArrowUpload24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon></ui:Button>
     </WrapPanel>
    </StackPanel>
    <StackPanel x:Name="GlobalControls" Grid.Column="1" Grid.Row="1" IsEnabled="{Binding CanAdjustAmp}" VerticalAlignment="Top" Margin="0,8,0,0">
     <ItemsControl ItemsSource="{Binding Amp.MainControls}" Foreground="{DynamicResource CubeAmpAccent}" ItemTemplate="{StaticResource AmpDial}" ItemsPanel="{StaticResource AmpWrap}"/>
    </StackPanel>
   </Grid>
   <TabControl x:Name="AmpSections" Style="{StaticResource CubeWorkspaceNavigation}" ItemContainerStyle="{StaticResource CubeWorkspaceTab}" Margin="0,12,0,0" SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Translate Text='Seções do amp'}">
    <TabItem Header="{loc:Translate Text='Equalização'}"/>
    <TabItem Header="{loc:Translate Text='Corpo e textura'}"/>
    <TabItem Header="{loc:Translate Text='Caráter e definição'}"/>
    <TabItem Header="{loc:Translate Text='Resposta'}" ToolTip="{loc:Translate Text='Ajustes por trecho'}"/>
   </TabControl>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock Text="{loc:Translate Value={Binding AmpSavedMessage}}" Style="{StaticResource BodyText}" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel Margin="0,0,0,8"><TextBlock Text="{loc:Translate Text='Destino ao salvar:'}" Margin="0,0,8,0" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Amp.Destination}" TextWrapping="Wrap"/></WrapPanel>
   <ui:InfoBar Template="{DynamicResource ActionInfoBarTemplate}" IsOpen="{Binding AmpPreviewActive}" IsClosable="False" Severity="Informational" Message="{loc:Translate Text='Prévia de AMP ativa na RAM. Nenhum slot foi gravado.'}" Margin="0,0,0,8"></ui:InfoBar>
   <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="AmpFeedback" Text="{loc:Translate Value={Binding AmpPreviewMessage}}" TextWrapping="Wrap" Margin="0,0,0,6"/>
   <WrapPanel>
    <ui:Button Content="{loc:Translate Text='Encerrar prévia'}" Click="RestoreClick" ToolTip="{loc:Translate Text='Volta ao som anterior à edição, sem apagar presets.'}" IsEnabled="{Binding CanRestoreAmp}" Appearance="Secondary" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconSpeakerMute24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon></ui:Button>
    <ui:Button Content="{loc:Translate Text='Salvar no pedal'}" Click="WriteClick" ToolTip="{loc:Translate Text='Grava no slot do amp selecionado após confirmação.'}" IsEnabled="{Binding CanSaveAmp}" Appearance="Primary" Margin="0,0,0,8"><ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconSave24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon></ui:Button>
   </WrapPanel>
  </StackPanel>
  <Grid IsEnabled="{Binding CanAdjustAmp}">
   <TabControl SelectedIndex="{Binding SelectedIndex,ElementName=AmpSections}" Style="{StaticResource HiddenTabs}" IsEnabled="{Binding Amp.Loaded}">
    <TabItem><ScrollViewer Style="{StaticResource AmpScroll}"><Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,12"><StackPanel>
     <TextBlock Text="{loc:Translate Text='Equalização'}" FontSize="{DynamicResource CubeFontSizeSubtitle}" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Grid x:Name="ModernEq">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="EqPlot">
       <WrapPanel Margin="0,0,0,8">
        <TextBlock Text="A ━" Foreground="{DynamicResource CubeAmpBandA}" FontWeight="SemiBold" Margin="0,0,16,0"/>
        <TextBlock Text="B ┄" Foreground="{DynamicResource CubeAmpBandB}" FontWeight="SemiBold" Margin="0,0,16,0"/>
        <TextBlock Text="{loc:Translate Text='Combinada'}" Foreground="{DynamicResource Muted}"/>
       </WrapPanel>
       <controls:AmpEqGraph x:Name="EqGraph" ToolTip="{loc:Translate Text='Arraste A ou B: horizontal altera frequência; vertical altera reforço/corte. Role sobre A ou B para ajustar Q.'}" Model="{Binding Amp}" BandABrush="{DynamicResource CubeAmpBandA}" BandBBrush="{DynamicResource CubeAmpBandB}" SelectedFilter="{Binding SelectedIndex,ElementName=EqFilter,Mode=TwoWay}" Height="320" AutomationProperties.Name="{loc:Translate Text='Equalização'}"/>
       <TextBlock Text="{loc:Translate Text='Resposta calculada dos dois filtros; não é uma medição do amp.'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource CubeFontSizeCaption}" TextWrapping="Wrap" Margin="0,4,12,8"/>
      </StackPanel>
      <StackPanel x:Name="EqControlsPanel" Grid.Column="1" Margin="12,0,0,0">
       <ComboBox x:Name="EqFilter" ToolTip="{loc:Translate Text='Escolha a banda que deseja ajustar.'}" AutomationProperties.Name="{loc:Translate Text='Banda do equalizador'}" SelectedIndex="0" Width="110" HorizontalAlignment="Left"><ComboBoxItem Content="EQ A"/><ComboBoxItem Content="EQ B"/></ComboBox>
       <TextBlock x:Name="EqSelectionStatus" Foreground="{DynamicResource Muted}" Margin="0,4,0,8">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Translate Text='Referência carregada'}"/><Style.Triggers>
         <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex,ElementName=EqFilter}" Value="0"/><Condition Binding="{Binding Amp.ChangeEqA}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="{loc:Translate Text='Banda alterada'}"/></MultiDataTrigger>
         <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex,ElementName=EqFilter}" Value="1"/><Condition Binding="{Binding Amp.ChangeEqB}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="{loc:Translate Text='Banda alterada'}"/></MultiDataTrigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <ItemsControl x:Name="SelectedEqControls" ItemTemplate="{StaticResource AmpEqDial}" ItemsPanel="{StaticResource AmpWrap}">
        <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="ItemsSource" Value="{Binding Amp.EqAControls}"/><Setter Property="Foreground" Value="{DynamicResource CubeAmpBandA}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=EqFilter}" Value="1"><Setter Property="ItemsSource" Value="{Binding Amp.EqBControls}"/><Setter Property="Foreground" Value="{DynamicResource CubeAmpBandB}"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
       </ItemsControl>
       <ui:Button Content="{loc:Translate Text='Restaurar banda'}" Click="ResetBandClick" Tag="{Binding SelectedIndex,ElementName=EqFilter}" Appearance="Transparent" HorizontalAlignment="Left">
        <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource CubeButtonStyle}"><Setter Property="IsEnabled" Value="{Binding Amp.ChangeEqA}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=EqFilter}" Value="1"><Setter Property="IsEnabled" Value="{Binding Amp.ChangeEqB}"/></DataTrigger></Style.Triggers></Style></ui:Button.Style>
       </ui:Button>
      </StackPanel>
     </Grid>

    </StackPanel></Border></ScrollViewer></TabItem>
    <TabItem><ScrollViewer Style="{StaticResource AmpScroll}"><Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,12"><StackPanel>
     <TextBlock Text="{loc:Translate Text='Descrições baseadas em escuta'}" Foreground="{DynamicResource Muted}"/>
     <TextBlock Text="{loc:Translate Text='100% mantém a referência carregada.'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource CubeFontSizeCaption}" Margin="0,4,0,12"/>
     <WrapPanel>
      <StackPanel x:Name="AFirstGroup" MaxWidth="760" Margin="0,0,24,12">
       <TextBlock Text="A01–A05" Foreground="{DynamicResource Muted}" Margin="4,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Amp.CoefficientASections[0]}" ItemTemplate="{StaticResource AmpFader}" ItemsPanel="{StaticResource AmpWrap}"/>
      </StackPanel>
      <StackPanel x:Name="ASecondGroup" MaxWidth="456" Margin="0,0,0,12">
       <TextBlock Text="{loc:Translate Text='Suavidade · A06–A08'}" FontWeight="SemiBold" Margin="4,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Amp.CoefficientASections[1]}" ItemTemplate="{StaticResource AmpFader}" ItemsPanel="{StaticResource AmpWrap}"/>
      </StackPanel>
     </WrapPanel>
    </StackPanel></Border></ScrollViewer></TabItem>
    <TabItem><ScrollViewer Style="{StaticResource AmpScroll}"><Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,12"><StackPanel>
     <TextBlock Text="{loc:Translate Text='Descrições baseadas em escuta'}" Foreground="{DynamicResource Muted}"/>
     <TextBlock Text="{loc:Translate Text='100% mantém a referência carregada.'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource CubeFontSizeCaption}" Margin="0,4,0,12"/>
     <WrapPanel>
      <StackPanel x:Name="BFirstGroup" MaxWidth="456" Margin="0,0,24,12">
       <TextBlock Text="B01–B03" Foreground="{DynamicResource Muted}" Margin="4,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Amp.CoefficientBSections[0]}" ItemTemplate="{StaticResource AmpFader}" ItemsPanel="{StaticResource AmpWrap}"/>
      </StackPanel>
      <StackPanel x:Name="BSecondGroup" MaxWidth="456" Margin="0,0,24,12">
       <TextBlock Text="{loc:Translate Text='Corpo grave · B04–B06'}" FontWeight="SemiBold" Margin="4,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Amp.CoefficientBSections[1]}" ItemTemplate="{StaticResource AmpFader}" ItemsPanel="{StaticResource AmpWrap}"/>
      </StackPanel>
      <StackPanel x:Name="BThirdGroup" MaxWidth="304" Margin="0,0,0,12">
       <TextBlock Text="{loc:Translate Text='Definição · B07–B08'}" FontWeight="SemiBold" Margin="4,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Amp.CoefficientBSections[2]}" ItemTemplate="{StaticResource AmpFader}" ItemsPanel="{StaticResource AmpWrap}"/>
      </StackPanel>
     </WrapPanel>
    </StackPanel></Border></ScrollViewer></TabItem>
    <TabItem><ScrollViewer Style="{StaticResource AmpScroll}"><Border Style="{StaticResource AmpPanel}"><StackPanel>
     <TextBlock Text="{loc:Translate Text='Resposta e capacitores'}" FontSize="{DynamicResource CubeFontSizeSubtitle}" FontWeight="SemiBold"/>
     <TextBlock Text="{loc:Translate Text='Escolha o caráter. Dose a intensidade. Encontre seu timbre.'}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16"/>
     <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
      <ItemsControl ItemsSource="{Binding Amp.CapacitorBanks}" ItemTemplate="{StaticResource CapacitorPanel}" AlternationCount="2">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate>
        <controls:AdaptivePanel FirstShare="0.5" Breakpoint="900"/>
       </ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
     </Border>
     <TextBlock Text="{loc:Translate Text='Perfis de timbre para escuta, inspirados em capacitores. Original preserva o modelo carregado.'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource CubeFontSizeCaption}" TextWrapping="Wrap"/>
    </StackPanel></Border></ScrollViewer></TabItem>
   </TabControl>
  </Grid>
 </DockPanel>
</UserControl>
