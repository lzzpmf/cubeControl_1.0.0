<UserControl x:Class="Cube.Desktop.Views.ChorusEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization">
 <Expander Header="{loc:Translate Text='Criador de chorus · experimental'}" Margin="0,16,0,0">
  <StackPanel Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Stretch">
   <TextBlock Text="{loc:Translate Text='Controles internos em prévia temporária. Validação sonora pendente.'}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <WrapPanel>
    <ui:Button Content="{loc:Translate Text='Ler chorus ativo'}" Click="ReadClick" IsEnabled="{Binding CanStartChorus}" Margin="0,0,8,8"/>
    <ui:Button Content="{loc:Translate Text='Restaurar chorus'}" Click="RestoreClick" IsEnabled="{Binding CanRestoreChorus}" Margin="0,0,8,8"/>
   </WrapPanel>
   <StackPanel IsEnabled="{Binding CanEditChorus}">
    <TextBlock Text="{loc:Translate Text='Profundidade (% do original)'}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Chorus.Depth,StringFormat={}{0:0}}"/><Slider Minimum="0" Maximum="100" Value="{Binding Chorus.Depth,Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Profundidade (% do original)'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Velocidade (Hz estimados)'}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Chorus.Speed,StringFormat={}{0:0.000}}"/><Slider Minimum="0.384" Maximum="3.024" Value="{Binding Chorus.Speed,Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Velocidade (Hz estimados)'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Mistura do ramo processado (% do original)'}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Chorus.Mix,StringFormat={}{0:0}}"/><Slider Minimum="0" Maximum="100" Value="{Binding Chorus.Mix,Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Mistura do ramo processado (% do original)'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='100% mantém a mistura original; o ramo processado também contém som direto.'}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
    <TextBlock Text="{loc:Translate Text='Realimentação experimental (%)'}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Chorus.Feedback,StringFormat={}{0:0.0}}"/><Slider Minimum="0" Maximum="10" Value="{Binding Chorus.Feedback,Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Realimentação experimental (%)'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Ganho do ramo atrasado (% do original)'}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Chorus.WetGain,StringFormat={}{0:0}}"/><Slider Minimum="50" Maximum="100" Value="{Binding Chorus.WetGain,Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Ganho do ramo atrasado (% do original)'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Ganho do ramo combinado (% do original)'}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Chorus.CombinedGain,StringFormat={}{0:0}}"/><Slider Minimum="50" Maximum="100" Value="{Binding Chorus.CombinedGain,Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Ganho do ramo combinado (% do original)'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Forma de onda'}" Margin="0,10,0,4"/>
    <ComboBox SelectedIndex="{Binding Chorus.Waveform,Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Forma de onda do chorus'}" HorizontalAlignment="Left" MinWidth="180">
     <ComboBoxItem Content="{loc:Translate Text='Original'}"/>
     <ComboBoxItem Content="{loc:Translate Text='Triangular'}"/>
    </ComboBox>
   </StackPanel>
   <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanUseChorusFiles}">
    <ui:Button Content="{loc:Translate Text='Importar chorus'}" Click="ImportClick" Margin="0,0,8,8"/>
    <ui:Button Content="{loc:Translate Text='Exportar chorus'}" Click="ExportClick" IsEnabled="{Binding Chorus.Loaded}" Margin="0,0,8,8"/>
    <ui:Button Content="{loc:Translate Text='Aplicar ajustes'}" Click="ApplyClick" IsEnabled="{Binding CanApplyChorus}" Margin="0,0,8,8"/>
   </WrapPanel>
   <TextBlock Text="{loc:Translate Value={Binding Chorus.Message}}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Expander>
</UserControl>
