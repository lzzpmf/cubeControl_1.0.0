<UserControl x:Class="Cube.Desktop.Views.ReverbEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:graph="clr-namespace:Cube.Desktop.Controls"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization">
 <Expander Header="{loc:Translate Text='Criador de reverb · experimental'}" Margin="0,16,0,0">
  <StackPanel Margin="0,12,0,0" MaxWidth="900" HorizontalAlignment="Stretch">
   <TextBlock Text="{loc:Translate Text='Controles internos em prévia temporária. Validação sonora pendente.'}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <WrapPanel>
    <ui:Button Content="{loc:Translate Text='Ler reverb ativo'}" Click="ReadClick" IsEnabled="{Binding CanStartReverb}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24"/></ui:Button.Icon></ui:Button>
    <ui:Button Content="{loc:Translate Text='Restaurar reverb'}" Click="RestoreClick" IsEnabled="{Binding CanRestoreReverb}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUndo24"/></ui:Button.Icon></ui:Button>
   </WrapPanel>
   <TextBlock Text="{loc:Translate Text='Ative o reverb e desligue a modulação antes de ler. Os ganhos direto e reverberado são independentes.'}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBlock Text="{loc:Translate Value={Binding ReverbGraphState}}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
   <graph:EffectGraphEditor EffectKind="Reverb" DataContext="{Binding Reverb}" IsEnabled="{Binding DataContext.CanEditReverb,RelativeSource={RelativeSource AncestorType=UserControl}}"/>

   <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanUseReverbFiles}">
    <ui:Button Content="{loc:Translate Text='Importar reverb'}" Click="ImportClick" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24"/></ui:Button.Icon></ui:Button>
    <ui:Button Content="{loc:Translate Text='Exportar reverb'}" Click="ExportClick" IsEnabled="{Binding Reverb.Loaded}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="Save24"/></ui:Button.Icon></ui:Button>
    <ui:Button Content="{loc:Translate Text='Aplicar ajustes'}" Click="ApplyClick" IsEnabled="{Binding CanApplyReverb}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="Checkmark24"/></ui:Button.Icon></ui:Button>
   </WrapPanel>
   <TextBlock Text="{loc:Translate Value={Binding Reverb.Message}}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Expander>
</UserControl>
