<UserControl x:Class="Cube.Desktop.Views.PhaserEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:graph="clr-namespace:Cube.Desktop.Controls"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization">
  <StackPanel Margin="0" MaxWidth="900" HorizontalAlignment="Stretch">
   <WrapPanel>
    <ui:Button Content="{loc:Translate Text='Restaurar phaser'}" Click="RestoreClick" IsEnabled="{Binding CanRestorePhaser}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUndo24"/></ui:Button.Icon></ui:Button>
   </WrapPanel>
   <TextBlock Text="{loc:Translate Text='Chorus e Phaser compartilham um bloco. Ative o efeito escolhido no preset físico antes de ler.'}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBlock Text="{loc:Translate Value={Binding PhaserGraphState}}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
   <graph:EffectGraphEditor EffectKind="Phaser" Accent="{DynamicResource AccentTextFillColorPrimaryBrush}" DataContext="{Binding Phaser}" IsEnabled="{Binding DataContext.CanEditPhaser,RelativeSource={RelativeSource AncestorType=UserControl}}"/>

   <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanUsePhaserFiles}">
    <ui:Button Content="{loc:Translate Text='Importar phaser'}" Click="ImportClick" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24"/></ui:Button.Icon></ui:Button>
    <ui:Button Content="{loc:Translate Text='Exportar phaser'}" Click="ExportClick" IsEnabled="{Binding Phaser.Loaded}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="Save24"/></ui:Button.Icon></ui:Button>
   </WrapPanel>
   <TextBlock Text="{loc:Translate Value={Binding Phaser.Message}}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
