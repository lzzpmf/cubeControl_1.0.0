<UserControl x:Class="Cube.Desktop.Views.PhaserEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization">
 <Expander Header="{loc:Translate Text='Criador de phaser · experimental'}" Margin="0,16,0,0">
  <StackPanel Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left">
   <TextBlock Text="{loc:Translate Text='Controles internos em prévia temporária. Validação sonora pendente.'}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <WrapPanel>
    <ui:Button Content="{loc:Translate Text='Ler phaser ativo'}" Click="ReadClick" IsEnabled="{Binding CanStartPhaser}" Margin="0,0,8,8"/>
    <ui:Button Content="{loc:Translate Text='Restaurar phaser'}" Click="RestoreClick" IsEnabled="{Binding CanRestorePhaser}" Margin="0,0,8,8"/>
   </WrapPanel>
   <StackPanel IsEnabled="{Binding CanEditPhaser}">
    <TextBlock Text="{loc:Translate Text='Velocidade (Hz estimados)'}"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Phaser.Speed,StringFormat={}{0:0.00}}"/><Slider Minimum="0.48" Maximum="6.24" TickFrequency="0.01" Value="{Binding Phaser.Speed,Mode=TwoWay}" AutomationProperties.Name="{loc:Translate Text='Velocidade do phaser'}" MinWidth="260"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Limite inferior da varredura (Hz estimados)'}" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Phaser.Lower,StringFormat={}{0:0}}"/><Slider Minimum="300" Maximum="{Binding Phaser.Upper}" Value="{Binding Phaser.Lower,Mode=TwoWay}" TickFrequency="10" AutomationProperties.Name="{loc:Translate Text='Limite inferior da varredura'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Limite superior da varredura (Hz estimados)'}" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Phaser.Upper,StringFormat={}{0:0}}"/><Slider Minimum="{Binding Phaser.Lower}" Maximum="3000" Value="{Binding Phaser.Upper,Mode=TwoWay}" TickFrequency="10" AutomationProperties.Name="{loc:Translate Text='Limite superior da varredura'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Nível de saída (% do original)'}" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Phaser.Level,StringFormat={}{0:0}%}"/><Slider Minimum="0" Maximum="100" Value="{Binding Phaser.Level,Mode=TwoWay}" TickFrequency="1" AutomationProperties.Name="{loc:Translate Text='Nível de saída do phaser'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Seções de filtro'}" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Phaser.Sections,StringFormat={}{0:0}}"/><Slider Minimum="1" Maximum="3" Value="{Binding Phaser.Sections,Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{loc:Translate Text='Seções de filtro do phaser'}"/></DockPanel>
   </StackPanel>
   <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanUsePhaserFiles}">
    <ui:Button Content="{loc:Translate Text='Importar phaser'}" Click="ImportClick" Margin="0,0,8,8"/>
    <ui:Button Content="{loc:Translate Text='Exportar phaser'}" Click="ExportClick" IsEnabled="{Binding Phaser.Loaded}" Margin="0,0,8,8"/>
    <ui:Button Content="{loc:Translate Text='Aplicar ajustes'}" Click="ApplyClick" IsEnabled="{Binding CanRestorePhaser}" Margin="0,0,8,8"/>
   </WrapPanel>
   <TextBlock Text="{loc:Translate Value={Binding Phaser.Message}}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Expander>
</UserControl>
