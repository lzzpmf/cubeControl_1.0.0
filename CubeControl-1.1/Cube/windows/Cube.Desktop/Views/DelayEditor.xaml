<UserControl x:Class="Cube.Desktop.Views.DelayEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization">
 <Expander Header="{loc:Translate Text='Criador de delay · experimental'}" Margin="0,16,0,0">
  <StackPanel Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left">
   <TextBlock Text="{loc:Translate Text='Controles internos em prévia temporária. Validação sonora pendente.'}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <WrapPanel>
    <ui:Button Content="{loc:Translate Text='Ler delay ativo'}" Click="ReadClick" IsEnabled="{Binding CanStartDelay}" Margin="0,0,8,8"/>
    <ui:Button Content="{loc:Translate Text='Restaurar delay'}" Click="RestoreClick" IsEnabled="{Binding CanRestoreDelay}" Margin="0,0,8,8"/>
   </WrapPanel>
   <TextBlock Text="{loc:Translate Text='Ative a seção delay/modulação e desligue chorus/phaser antes de ler. Velocidade relativa ao original, dependente do tempo; zero congela a fase.'}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <StackPanel IsEnabled="{Binding CanEditDelay}">
    <TextBlock Text="{loc:Translate Text='Tempo (amostras internas)'}" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Delay.TimeSamples,StringFormat={}{0:0}}"/><Slider Minimum="2400" Maximum="16350" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Delay.TimeSamples,Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="{loc:Translate Text='Tempo (amostras internas)'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Realimentação (%)'}" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Delay.Feedback,StringFormat={}{0:0.###}}"/><Slider Minimum="0" Maximum="99.21875" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Delay.Feedback,Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="{loc:Translate Text='Realimentação (%)'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Profundidade da modulação (% do original)'}" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Delay.Depth,StringFormat={}{0:0}}"/><Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Delay.Depth,Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="{loc:Translate Text='Profundidade da modulação (% do original)'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Velocidade da modulação (% do original)'}" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Delay.Rate,StringFormat={}{0:0}}"/><Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Delay.Rate,Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="{loc:Translate Text='Velocidade da modulação (% do original)'}"/></DockPanel>
    <TextBlock Text="{loc:Translate Text='Mistura interna (50 = direto e eco integrais)'}" Margin="0,10,0,0"/>
    <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding Delay.Mix,StringFormat={}{0:0.###}}"/><Slider Minimum="0" Maximum="92.1875" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Delay.Mix,Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="{loc:Translate Text='Mistura interna (50 = direto e eco integrais)'}"/></DockPanel>
   </StackPanel>
   <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanUseDelayFiles}">
    <ui:Button Content="{loc:Translate Text='Importar delay'}" Click="ImportClick" Margin="0,0,8,8"/>
    <ui:Button Content="{loc:Translate Text='Exportar delay'}" Click="ExportClick" IsEnabled="{Binding Delay.Loaded}" Margin="0,0,8,8"/>
    <ui:Button Content="{loc:Translate Text='Aplicar ajustes'}" Click="ApplyClick" IsEnabled="{Binding CanApplyDelay}" Margin="0,0,8,8"/>
   </WrapPanel>
   <TextBlock Text="{loc:Translate Value={Binding Delay.Message}}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Expander>
</UserControl>
