<ui:FluentWindow x:Class="Cube.Desktop.Views.DocumentationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization"
 Title="{loc:Translate Text='Documentação'}" Width="1120" Height="820" MinWidth="400" MinHeight="360"
 Background="{DynamicResource CubeCanvas}" Foreground="{DynamicResource CubeText}"
 FontFamily="{DynamicResource CubeUiFont}" FontSize="{DynamicResource CubeFontSizeBody}" Icon="{DynamicResource CubeWindowIcon}"
 WindowStartupLocation="CenterOwner" SizeChanged="WindowSizeChanged" ExtendsContentIntoTitleBar="True" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ui:TitleBar Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"><ui:TitleBar.Icon><ui:ImageIcon Source="{DynamicResource CubeAppIcon}"/></ui:TitleBar.Icon></ui:TitleBar>
 <Grid x:Name="Root" Grid.Row="1" Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel x:Name="Header" Margin="0,0,0,16">
   <TextBlock Text="{loc:Translate Text='Documentação'}" Style="{StaticResource TitleText}"/>
   <TextBlock Text="{loc:Translate Text='Guias do cubeControl e manuais do pedal, disponíveis offline.'}" Style="{StaticResource HelpText}" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="320"/><ColumnDefinition x:Name="ReaderColumn" Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="Library" Style="{StaticResource Card}" Padding="16" Margin="0,0,16,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <ui:TextBox x:Name="SearchBox" Style="{StaticResource CubeSearchTextBoxStyle}" PlaceholderText="{loc:Translate Text='Buscar documentação'}" TextChanged="FilterChanged" AutomationProperties.Name="{loc:Translate Text='Buscar documentação'}" ToolTip="{loc:Translate Text='Busque por título, resumo ou palavra-chave.'}"><ui:TextBox.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconSearch24}" FontSize="{DynamicResource CubeIconSizeAction}" Width="20" Height="20"/></ui:TextBox.Icon></ui:TextBox>
     <ComboBox x:Name="CategoryBox" Grid.Row="1" Margin="0,12,0,12" MinHeight="40" DisplayMemberPath="Label" SelectionChanged="CategoryChanged" AutomationProperties.Name="{loc:Translate Text='Categoria de documentação'}"/>
     <TextBlock x:Name="ResultsStatus" Grid.Row="2" Style="{StaticResource HelpText}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
     <ListBox x:Name="DocumentsList" Grid.Row="3" SelectionChanged="DocumentSelected" ItemContainerStyle="{StaticResource SelectionTile}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Translate Text='Documentos'}">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel>
         <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Description}" Style="{StaticResource SelectionSecondaryText}" Margin="0,4,0,0"/>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <Border x:Name="Reading" Grid.Column="1" Style="{StaticResource Card}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,12">
      <ui:Button x:Name="BackButton" Content="{loc:Translate Text='Voltar aos documentos'}" Click="BackClick" Margin="0,0,12,8"/>
      <ui:Button x:Name="PdfButton" Content="{loc:Translate Text='Abrir PDF'}" Click="PdfClick" Visibility="Collapsed" Margin="0,0,0,8"><ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconOpen24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon></ui:Button>
     </WrapPanel>
     <ComboBox x:Name="ContentsBox" Grid.Row="1" Margin="0,0,0,12" DisplayMemberPath="Title" SelectionChanged="HeadingSelected" AutomationProperties.Name="{loc:Translate Text='Sumário do documento'}" Visibility="Collapsed"/>
     <TextBlock x:Name="ReadingStatus" Grid.Row="2" Style="{StaticResource HelpText}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
     <RichTextBox x:Name="Reader" Grid.Row="3" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Padding="0" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Translate Text='Conteúdo do documento'}"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
 </Grid>
</ui:FluentWindow>
