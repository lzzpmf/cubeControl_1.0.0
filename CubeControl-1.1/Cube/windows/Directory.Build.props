<Project>
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(LOCALAPPDATA)/CubeControl-BuildCache</ArtifactsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;$(MSBuildThisFileDirectory)../../../_old/**</DefaultItemExcludes>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
