<Window x:Class="Cube.WinUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Cube.WinUI.Controls" Title="CubeControl">
 <Grid x:Name="Root" Background="{ThemeResource StudioBackground}">
  <NavigationView x:Name="Navigation" PaneTitle="CubeControl" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
    SelectionChanged="SelectionChanged" PaneDisplayMode="Top" AutomationProperties.Name="Áreas do CubeControl">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Pedaleira" Tag="pedal" Icon="Audio" />
    <NavigationViewItem Content="IRs" Tag="ir" Icon="Library" />
    <NavigationViewItem Content="Backing tracks" Tag="backing" Icon="MusicInfo" />
    <NavigationViewItem Content="Criador de amps" Tag="amps" Icon="Edit" />
    <NavigationViewItem Content="Dispositivo e ajuda" Tag="device" Icon="Help" />
   </NavigationView.MenuItems>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid x:Name="SessionBar" Padding="16,8" ColumnSpacing="16" Background="{ThemeResource StudioPanel}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="Brand" Text="CUBE / CONTROL" FontWeight="Bold" VerticalAlignment="Center"/>
     <TextBlock x:Name="SessionStatus" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="Status" AutomationProperties.LiveSetting="Polite"/>
     <ComboBox Grid.Column="2" x:Name="ActivePreset" ItemsSource="{Binding Presets}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" DisplayMemberPath="Name" MinWidth="90" AutomationProperties.Name="Preset ativo"/>
     <StackPanel x:Name="SessionCommands" Grid.Column="3" Orientation="Horizontal" Spacing="6">
      <Button Command="{Binding Connect}" Content="Conectar" x:Name="SessionConnect" AutomationProperties.Name="Conectar pedal" />
      <Button Command="{Binding Disconnect}" Content="Desconectar" x:Name="SessionDisconnect" AutomationProperties.Name="Desconectar pedal" />
     </StackPanel>
    </Grid>
    <Frame x:Name="ContentFrame" Grid.Row="1" />
    <Grid x:Name="PlaybackBar" Grid.Row="2" Padding="12" ColumnSpacing="12" Background="{ThemeResource StudioPanel}">
     <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBlock x:Name="PlaybackTime" Text="{Binding TimeLabel}" VerticalAlignment="Center" AutomationProperties.Name="Tempo da sessão" />
     <controls:TransportButton Style="{StaticResource TransportButtonStyle}" x:Name="PlaybackPlay" Grid.Column="1" Label="{Binding PlayLabel}" IsPlaying="{Binding IsPlaying}" />
     <controls:TransportButton Style="{StaticResource TransportButtonStyle}" x:Name="PlaybackStop" Grid.Column="2" Label="Parar áudio" IsStop="True" />
    </Grid>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
