<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="StudioBackground" Color="#181C20"/>
   <SolidColorBrush x:Key="StudioPanel" Color="#22282D"/>
   <SolidColorBrush x:Key="StudioEdge" Color="#414A51"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="StudioBackground" Color="#E4E7E8"/>
   <SolidColorBrush x:Key="StudioPanel" Color="#F5F6F4"/>
   <SolidColorBrush x:Key="StudioEdge" Color="#A5AEB3"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="StudioBackground" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="StudioPanel" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="StudioEdge" Color="{ThemeResource SystemColorWindowTextColor}"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="StudioPanelStyle" TargetType="Border">
  <Setter Property="Background" Value="{ThemeResource StudioPanel}"/>
  <Setter Property="BorderBrush" Value="{ThemeResource StudioEdge}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="6"/>
  <Setter Property="Padding" Value="16"/>
 </Style>
 <Style x:Key="SignalStageStyle" TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="MinHeight" Value="80"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="RadioButton">
     <Grid Background="Transparent">
      <VisualStateManager.VisualStateGroups>
       <VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal"/>
        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Face.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/></VisualState.Setters></VisualState>
        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Face.Opacity" Value="0.75"/></VisualState.Setters></VisualState>
        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Face.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
       </VisualStateGroup>
       <VisualStateGroup x:Name="CheckStates">
        <VisualState x:Name="Unchecked"/>
        <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Selection.Visibility" Value="Visible"/><Setter Target="Face.BorderBrush" Value="{ThemeResource SystemControlHighlightAccentBrush}"/></VisualState.Setters></VisualState>
       </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border x:Name="Face" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource StudioEdge}" BorderThickness="1,1,1,3" CornerRadius="5" Padding="10,8">
       <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <Border x:Name="Selection" Visibility="Collapsed" Height="3" Background="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Bottom" Margin="8,0,8,3"/>
     </Grid>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
  <Setter Property="CornerRadius" Value="4"/>
  <Setter Property="Padding" Value="12,7"/>
  <Setter Property="MinHeight" Value="34"/>
  <Setter Property="BorderThickness" Value="1,1,1,2"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
 </Style>
 <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
  <Setter Property="MinWidth" Value="100"/>
  <Setter Property="MinHeight" Value="38"/>
  <Setter Property="CornerRadius" Value="5"/>
  <Setter Property="BorderThickness" Value="1,1,1,3"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
  <Setter Property="MinHeight" Value="38"/>
  <Setter Property="CornerRadius" Value="4"/>
  <Setter Property="BorderThickness" Value="1,1,1,2"/>
 </Style>
</ResourceDictionary>
