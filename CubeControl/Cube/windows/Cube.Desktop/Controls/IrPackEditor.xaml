<UserControl x:Class="Cube.Desktop.Controls.IrPackEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Cube.Desktop.Controls"
 xmlns:loc="clr-namespace:Cube.Desktop.Localization">
 <UserControl.Resources>
  <Style TargetType="local:MicrophoneFader">
   <Setter Property="Focusable" Value="True"/>
   <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:MicrophoneFader">
    <Grid Background="Transparent">
     <Border Height="2" Margin="20,0" Background="{DynamicResource CubeBorder}" VerticalAlignment="Center"/>
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="40" Height="40" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Image Source="{Binding MicrophoneImage,RelativeSource={RelativeSource AncestorType=local:MicrophoneFader}}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PackNotice" TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer x:Name="PackBodyScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="{loc:Translate Text='Packs de IRs'}" Style="{StaticResource SectionTitle}"/>
  <TextBlock Text="{loc:Translate Text='Escolha um pack ou monte até oito IRs. Revise a seleção e a distância antes de aplicar.'}" Style="{StaticResource HelpText}" Margin="0,4,0,8"/>
  <TextBlock Text="{loc:Translate Text='1 · Escolher pack'}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
  <local:AdaptivePanel FirstShare="0.5" Breakpoint="560">
   <Grid HorizontalAlignment="Stretch" Margin="0,0,16,8">
   <ComboBox x:Name="PackSelector" ItemsSource="{Binding Owner.IrPackGroups}" SelectedItem="{Binding SelectedCatalogPack, Mode=OneWay}" SelectionChanged="PackSelectionChanged" IsEnabled="{Binding Owner.CanChooseIr}" MinWidth="0" AutomationProperties.Name="{loc:Translate Text='Pack de IRs'}">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock">
     <Setter Property="Text" Value="{loc:Translate Value={Binding Name}}"/><Setter Property="ToolTip" Value="{loc:Translate Value={Binding Name}}"/>
     <Style.Triggers><DataTrigger Binding="{Binding Group}" Value="Meus packs"><Setter Property="Text" Value="{Binding Name}"/><Setter Property="ToolTip" Value="{Binding Name}"/></DataTrigger></Style.Triggers>
    </Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate>
    <ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Translate Value={Binding Name}}" Style="{StaticResource BodyStrongText}" Margin="8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle>
   </ComboBox>
   <TextBlock Text="{loc:Translate Text='Montagem atual'}" Style="{StaticResource BodyText}" Margin="14,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IsDraftSelection,Converter={StaticResource Visible}}"/>
   </Grid>
   <WrapPanel HorizontalAlignment="Right">
   <ui:Button Content="{loc:Translate Text='Importar'}" Click="ImportClick" IsEnabled="{Binding Owner.CanChooseIr}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Exportar'}" Click="ExportClick" IsEnabled="{Binding CanExport}" Margin="0,0,8,8"/>
   <ui:Button Content="{loc:Translate Text='Ações do pack'}" Click="OpenMenuClick" Appearance="Transparent" Margin="0,0,0,8" Visibility="{Binding CanDelete,Converter={StaticResource Visible}}" IsEnabled="{Binding Owner.CanChooseIr}">
    <ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconMoreHorizontal24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon>
    <ui:Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
     <MenuItem Header="{loc:Translate Text='Excluir pack'}" Command="{Binding DeletePack}"/>
    </ContextMenu></ui:Button.ContextMenu>
   </ui:Button>
   </WrapPanel>
  </local:AdaptivePanel>
  <TextBlock Text="{loc:Translate Value={Binding DisplayTitle}}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding PackSummary}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
  <TextBlock  Margin="0,4,0,8"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PackNotice}">
   <Setter Property="Text" Value="{Binding Description}"/><Setter Property="ToolTip" Value="{Binding Description}"/>
   <Style.Triggers><DataTrigger Binding="{Binding ReadOnly}" Value="True"><Setter Property="Text" Value="{loc:Translate Value={Binding Description}}"/><Setter Property="ToolTip" Value="{loc:Translate Value={Binding Description}}"/></DataTrigger></Style.Triggers>
  </Style></TextBlock.Style></TextBlock>
  <StackPanel Visibility="{Binding HasBasis,Converter={StaticResource Visible}}" Margin="0,0,0,8">
   <TextBlock Text="{loc:Translate Text='Baseado em:'}" Style="{StaticResource CaptionText}"/>
   <TextBlock Text="{Binding BasedOnName}" Style="{StaticResource PackNotice}"/>
  </StackPanel>
  <ui:InfoBar x:Name="PackCreationNotice" Severity="Warning" IsClosable="False" IsOpen="{Binding HasDraftNotice}" Visibility="{Binding HasDraftNotice,Converter={StaticResource Visible}}" Title="{loc:Translate Value={Binding DraftNoticeTitle}}" Message="{loc:Translate Value={Binding DraftNotice}}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{loc:Translate Text='2 · Montar ou visualizar'}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
    <ItemsControl MaxWidth="{DynamicResource CubeIrGridMaxWidth}" ItemsSource="{Binding Slots}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:IrPackGridPanel MinimumCardWidth="240"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}" x:Name="SlotCard" CornerRadius="{DynamicResource CubeCardCornerRadius}" Padding="12,8" Focusable="True" AllowDrop="True"
       Loaded="SlotLoaded" PreviewKeyDown="SlotKeyDown" PreviewMouseLeftButtonDown="SlotMouseDown" PreviewMouseMove="SlotMouseMove" PreviewMouseLeftButtonUp="SlotMouseUp" ToolTip="{loc:Translate Value={Binding PreviewHint}}"

       AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{loc:Translate Value={Binding PreviewHint}}">
       <Border.Style><Style TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CubeItemRest}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CubeSurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CubeSurfaceBorderThickness}"/>
        <Style.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CubeItemHover}"/></Trigger>
         <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource CubeSelected}"/></Trigger>
         <DataTrigger Binding="{Binding IsPreviewing}" Value="True"><Setter Property="Background" Value="{DynamicResource CubeSelected}"/></DataTrigger>
         <DataTrigger Binding="{Binding CanPreview}" Value="True"><Setter Property="Cursor" Value="Hand"/></DataTrigger>
        </Style.Triggers>
       </Style></Border.Style>
       <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
        <MenuItem Header="{loc:Translate Text='Usar neste slot'}" Command="{Binding UseIr}"/>
        <MenuItem Header="{loc:Translate Text='Remover IR'}" Command="{Binding Remove}" InputGestureText="Delete"/>
        <Separator/>
        <MenuItem Header="{loc:Translate Text='Mover para o slot anterior'}" Command="{Binding MoveUp}"/>
        <MenuItem Header="{loc:Translate Text='Mover para o próximo slot'}" Command="{Binding MoveDown}"/>
       </ContextMenu></Border.ContextMenu>
       <Grid>
        <StackPanel>
         <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionText}" MinHeight="24" TextWrapping="Wrap" Margin="0,0,44,0" VerticalAlignment="Center"/>
         <StackPanel x:Name="SlotContent">
         <local:GearArt Kind="cab" Image="{Binding Image}" Accent="{DynamicResource CubeAccent}" Height="112" Margin="0,2,0,4" ToolTip="{loc:Translate Value={Binding ImageHint}}" AutomationProperties.HelpText="{loc:Translate Value={Binding ImageHint}}"/>
         <StackPanel Visibility="{Binding IsPreviewSending,Converter={StaticResource Visible}}" Margin="0,0,0,8">
          <ProgressBar Style="{StaticResource InfiniteProgressBar}" AutomationProperties.Name="{loc:Translate Value={Binding PreviewSendingText}}" AutomationProperties.HelpText="{Binding Title}"/>
          <TextBlock Text="{loc:Translate Value={Binding PreviewSendingText}}" Style="{StaticResource HelpText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
         </StackPanel>
         <TextBlock Text="{loc:Translate Value={Binding Name}}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource CubeText}" TextAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding Name}"/>
         <TextBlock Text="{Binding CaptureSummary}" Style="{StaticResource PackNotice}" TextWrapping="Wrap" Margin="0,4,0,0"/>
         <StackPanel Margin="0,4,0,0" HorizontalAlignment="Stretch">
          <Grid MaxWidth="220" Height="40" HorizontalAlignment="Stretch">
           <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
           <ui:SymbolIcon Symbol="{StaticResource CubeIconSpeaker124}" FontSize="20" Width="20" Height="20" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" Focusable="False" ToolTip="{loc:Translate Text='Menos volume'}" AutomationProperties.Name="{loc:Translate Text='Menos volume'}"/>
          <local:MicrophoneFader Grid.Column="1" x:Name="SlotVolumeFader" Value="{Binding DistanceValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="99" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" Orientation="Horizontal" Height="40" MaxWidth="180" HorizontalAlignment="Stretch" IsEnabled="{Binding CanSetDistance}" ToolTip="{loc:Translate Text='O movimento ajusta o volume do IR; não altera a distância física da captura.'}" AutomationProperties.Name="{loc:Translate Text='Volume'}" AutomationProperties.HelpText="{Binding Title}"/>
           <ui:SymbolIcon Symbol="{StaticResource CubeIconSpeaker224}" FontSize="20" Width="20" Height="20" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" Focusable="False" ToolTip="{loc:Translate Text='Mais volume'}" AutomationProperties.Name="{loc:Translate Text='Mais volume'}"/>
          </Grid>
          <TextBlock Text="{loc:Translate Value={Binding PreviewStatus}}" Style="{StaticResource PackNotice}" TextWrapping="Wrap" Margin="0,4,0,0"/>
         </StackPanel>
         <TextBlock Text="{loc:Translate Value={Binding Problem}}" Style="{StaticResource PackNotice}"  ToolTip="{Binding Problem}"/>
         </StackPanel>
        </StackPanel>
        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding Remove}" Appearance="Transparent" Width="40" Height="40" Padding="0" AutomationProperties.Name="{loc:Translate Text='Remover IR'}" AutomationProperties.HelpText="{Binding Title}" ToolTip="{loc:Translate Text='Remover IR'}">
         <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource CubeIconButtonStyle}">
          <Setter Property="Visibility" Value="Hidden"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsMouseOver,ElementName=SlotCard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
          </Style.Triggers>
         </Style></ui:Button.Style>
         <ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconDelete24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon>
        </ui:Button>


       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{loc:Translate Text='Arraste um IR para um slot. Arraste os cartões para trocar suas posições.'}" Style="{StaticResource HelpText}" Margin="0,12,0,8"/>
    <TextBlock Text="{loc:Translate Text='Ajuste a distância nos cartões ou na revisão antes de aplicar.'}" Style="{StaticResource HelpText}" Margin="0,0,0,16"/>
</StackPanel></ScrollViewer>
 <StackPanel Grid.Row="1">  <WrapPanel x:Name="PackActions" Margin="0,12,0,4" HorizontalAlignment="Right">
   <WrapPanel Margin="0,0,16,8">
    <ui:Button x:Name="ReviewPackButton" Content="{loc:Translate Text='Aplicar'}" Command="{Binding Owner.ApplyIrPack}" Appearance="Primary" Margin="0,0,8,8" ToolTip="{loc:Translate Text='Aplica os IRs preenchidos e seus volumes nos slots do pedal.'}"><ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconArrowReset24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon></ui:Button>
    <ui:Button x:Name="RestorePackButton" Content="{loc:Translate Text='Restaurar IRs originais'}" Command="{Binding Owner.RestoreOriginalIrs}" Margin="0,0,0,8" ToolTip="{loc:Translate Text='Disponível quando os arquivos originais BFI/BFIN estão instalados.'}" ToolTipService.ShowOnDisabled="True"/>
   </WrapPanel>
   <WrapPanel Margin="0,0,0,8">
    <ui:Button Content="{loc:Translate Text='Salvar pack'}" Command="{Binding SavePack}" Margin="0,0,8,8"><ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconSave24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon></ui:Button>
    <ui:Button Content="{loc:Translate Text='Descartar alterações'}" Command="{Binding DiscardChanges}" Visibility="{Binding Dirty,Converter={StaticResource Visible}}" Margin="0,0,0,8"/>
   </WrapPanel>
  </WrapPanel>

  <TextBlock Text="{loc:Translate Value={Binding Owner.PackCatalogProblems}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{loc:Translate Value={Binding Problems}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{loc:Translate Value={Binding Message}}" Style="{StaticResource PackNotice}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,12"/>
</StackPanel>
 </Grid>
</UserControl>
