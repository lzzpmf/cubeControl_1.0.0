<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Cube.Desktop.Controls" xmlns:loc="clr-namespace:Cube.Desktop.Localization" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
<CornerRadius x:Key="CubeCardCornerRadius">4</CornerRadius>
<CornerRadius x:Key="CubeControlCornerRadius">4</CornerRadius>
<CornerRadius x:Key="CubeCardLeftCornerRadius">4,0,0,4</CornerRadius>
<CornerRadius x:Key="CubeCardTopCornerRadius">4,4,0,0</CornerRadius>
<CornerRadius x:Key="CubeCardBottomCornerRadius">0,0,4,4</CornerRadius>
<Color x:Key="CubeComboField.Dark">#333333</Color>
<Color x:Key="CubeComboField.Light">#FAFAFA</Color>
<Color x:Key="CubeComboFieldHover.Dark">#3A3A3A</Color>
<Color x:Key="CubeComboFieldHover.Light">#E8E8E8</Color>
<!-- Dropdowns and menus specialize the general selection palette. -->
<CornerRadius x:Key="CubePopupCornerRadius">8</CornerRadius>
<Thickness x:Key="CubePopupBorderThickness">1</Thickness>
<Thickness x:Key="CubePopupItemMargin">6,2,6,2</Thickness>
<Thickness x:Key="CubePopupItemPadding">10,8,10,8</Thickness>
<sys:Double x:Key="CubePopupItemMinHeight">40</sys:Double>
<Color x:Key="CubePopupSurface.Dark">#292929</Color>
<Color x:Key="CubePopupSurface.Light">#FAFAFA</Color>
<Color x:Key="CubePopupHover.Dark">#3A3A3A</Color>
<Color x:Key="CubePopupHover.Light">#E8E8E8</Color>
<Color x:Key="CubePopupSelected.Dark">#383838</Color>
<Color x:Key="CubePopupSelected.Light">#E4E4E4</Color>
<Color x:Key="CubePopupBorder.Dark">#404040</Color>
<Color x:Key="CubePopupBorder.Light">#D6D6D6</Color>
<!-- Semantic aliases refreshed by ThemeService after WPF UI changes theme. -->
<sys:String x:Key="CubePalette.CubeCanvas">ApplicationBackgroundBrush</sys:String>
<sys:String x:Key="CubePalette.CubeText">TextFillColorPrimaryBrush</sys:String>
<sys:String x:Key="CubePalette.CubeCard">CardBackgroundFillColorDefaultBrush</sys:String>
<sys:String x:Key="CubePalette.CubeFloatingSurface">SolidBackgroundFillColorSecondaryBrush</sys:String>
<sys:String x:Key="CubePalette.CubeInset">LayerFillColorDefaultBrush</sys:String>
<sys:String x:Key="CubePalette.CubeWell">ControlFillColorInputActiveBrush</sys:String>
<sys:String x:Key="CubePalette.CubeBorder">ControlStrokeColorDefaultBrush</sys:String>
<sys:String x:Key="CubePalette.CubeSelected">CubeSelectedBrush</sys:String>
<!-- Base surface colors: do not promote the library's white/black overlays to opaque fills. -->
<Color x:Key="CubeCard.Dark">#2B2B2B</Color>
<Color x:Key="CubeCard.Light">#FFFFFF</Color>
<Color x:Key="CubeInset.Dark">#303030</Color>
<Color x:Key="CubeInset.Light">#F3F3F3</Color>
<Color x:Key="CubeWell.Dark">#202020</Color>
<Color x:Key="CubeWell.Light">#FFFFFF</Color>
<Color x:Key="CubeItemRest.Dark">#292929</Color>
<Color x:Key="CubeItemRest.Light">#FAFAFA</Color>
<Color x:Key="CubeItemHover.Dark">#3A3A3A</Color>
<Color x:Key="CubeItemHover.Light">#E8E8E8</Color>
<Color x:Key="CubeSelectedBrush.Dark">#555555</Color>
<Color x:Key="CubeSelectedBrush.Light">#D0D0D0</Color>
<sys:String x:Key="CubePalette.CubeSelectedText">TextFillColorPrimaryBrush</sys:String>
<sys:String x:Key="CubePalette.CubeFocus">AccentFillColorDefaultBrush</sys:String>
<sys:String x:Key="CubePalette.CubeAccent">AccentFillColorDefaultBrush</sys:String>
<sys:String x:Key="CubePalette.Muted">TextFillColorSecondaryBrush</sys:String>
<sys:String x:Key="CubePalette.CubeDisabledText">TextFillColorDisabledBrush</sys:String>
<sys:String x:Key="CubePalette.CubeWarning">SystemFillColorCautionBrush</sys:String>
<!-- Instrument colors adapt to the current theme; they do not indicate operation status. -->
<Color x:Key="CubeAmpAccent.Dark">#8DB9AC</Color>
<Color x:Key="CubeAmpAccent.Light">#226E59</Color>
<Color x:Key="CubeAmpBandA.Dark">#FFA293</Color>
<Color x:Key="CubeAmpBandA.Light">#A33D30</Color>
<Color x:Key="CubeAmpBandB.Dark">#73C6DE</Color>
<Color x:Key="CubeAmpBandB.Light">#236B80</Color>
<Color x:Key="CubeCapacitorAccent.Dark">#F0BE72</Color>
<Color x:Key="CubeCapacitorAccent.Light">#805216</Color>
<Color x:Key="CubeCapacitorDisplay.Dark">#24211C</Color>
<Color x:Key="CubeCapacitorDisplay.Light">#FFF8ED</Color>
<!-- Functional colors retain the identity of music controls and graphs. -->
<Color x:Key="BackingCard.Dark">#292D31</Color>
<Color x:Key="BackingCard.Light">#FFFFFF</Color>
<Color x:Key="BackingBorder.Dark">#4C545C</Color>
<Color x:Key="BackingBorder.Light">#BBC3CB</Color>
<Color x:Key="BackingSecondary.Dark">#D4DAE0</Color>
<Color x:Key="BackingSecondary.Light">#3C4650</Color>
<Color x:Key="BackingPlayhead.Dark">#FFD280</Color>
<Color x:Key="BackingPlayhead.Light">#815000</Color>
<Color x:Key="BackingPlayed.Dark">#80B8A8</Color>
<Color x:Key="BackingPlayed.Light">#226E59</Color>
<Color x:Key="BackingFuture.Dark">#82ACD2</Color>
<Color x:Key="BackingFuture.Light">#2D638B</Color>
<Color x:Key="CubePhaserGraph.Dark">#D9A071</Color>
<Color x:Key="CubePhaserGraph.Light">#965622</Color>
<Color x:Key="CubePurple.Dark">#B4A4D6</Color>
<Color x:Key="CubePurple.Light">#67508F</Color>
<Color x:Key="CubeKnobBase.Dark">#202020</Color>
<Color x:Key="CubeKnobBase.Light">#DCE3E8</Color>
<Color x:Key="CubeKnobTop.Dark">#555555</Color>
<Color x:Key="CubeKnobTop.Light">#FFFFFF</Color>
<Color x:Key="CubeKnobBottom.Dark">#292929</Color>
<Color x:Key="CubeKnobBottom.Light">#C6D0D8</Color>
<Color x:Key="CubeKnobTrack.Dark">#666666</Color>
<Color x:Key="CubeKnobTrack.Light">#8798A3</Color>
<SolidColorBrush x:Key="CubeSelectionIndicator" Color="{DynamicResource SystemAccentColor}"/>
<SolidColorBrush x:Key="BackingMuteActive" Color="#D97926"/>
<SolidColorBrush x:Key="BackingSoloActive" Color="#B58A00"/>
</ResourceDictionary>
