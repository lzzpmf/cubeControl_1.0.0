<!-- Adapted for cubeControl: borderless surfaces; native interaction parts retained. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="clr-namespace:Cube.Desktop.Controls"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui">

    <Style x:Key="CubeUiContextMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource CubeText}" />
        <Setter Property="Foreground" Value="{DynamicResource CubeText}" />
        <Setter Property="Background" Value="{DynamicResource CubePopupSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CubePopupBorder}" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Popup.PopupAnimation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <controls:EffectThicknessDecorator Thickness="30">
                        <Border
                            x:Name="Border" motion:SurfaceMotion.Enabled="True"
                            Padding="0,3,0,3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{DynamicResource CubePopupBorderThickness}"
                            CornerRadius="{DynamicResource CubePopupCornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="20"
                                    Direction="270"
                                    Opacity="{DynamicResource CubePopupShadowOpacity}"
                                    ShadowDepth="10"
                                    Color="#202020" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <controls:DynamicScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
                            <StackPanel
                                ClipToBounds="True"
                                IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                Orientation="Vertical" />
                            </controls:DynamicScrollViewer>
                        </Border>
                    </controls:EffectThicknessDecorator>
                    <ControlTemplate.Triggers>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource CubeUiContextMenu}" TargetType="{x:Type ContextMenu}" />

</ResourceDictionary>
