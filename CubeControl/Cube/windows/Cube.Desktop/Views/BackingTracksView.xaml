<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Cube.Desktop.Controls" xmlns:loc="clr-namespace:Cube.Desktop.Localization" x:Class="Cube.Desktop.Views.BackingTracksView" DataContext="{Binding BackingTracks,RelativeSource={RelativeSource AncestorType=Window}}">
  <ScrollViewer x:Name="BackingTracksScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Style="{StaticResource Card}" Margin="12">
      <StackPanel>
        <TextBlock Text="YouTube Downloader" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
        <WrapPanel Margin="0,8,0,12">
          <ComboBox Width="260" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name" AutomationProperties.Name="{loc:Translate Text='Saída de áudio'}"/>
          <ui:Button Content="{loc:Translate Text='Atualizar saídas'}" Command="{Binding RefreshOutputs}" Margin="8,0"/>
          <TextBlock Text="{loc:Translate Text='Volume'}" VerticalAlignment="Center"/>
          <Slider Width="140" Minimum="0" Maximum="100" Value="{Binding Volume}" AutomationProperties.Name="{loc:Translate Text='Volume'}"/>
          <CheckBox Content="{loc:Translate Text='Silenciar'}" IsChecked="{Binding IsMuted}" VerticalAlignment="Center"/>
        </WrapPanel>
        <TextBlock Text="{loc:Translate Value={Binding Status}}" Style="{StaticResource HelpText}" TextWrapping="Wrap"/>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{loc:Translate Text='Buscar faixas'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
        </Grid>
        <Grid Margin="0,0,0,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Row="1" Content="{loc:Translate Text='Prévia ao passar o mouse'}" IsChecked="{Binding PreviewOnHover}" Margin="0,0,0,8"/>
          <ui:AutoSuggestBox x:Name="BackingYouTubeSearch" Style="{StaticResource CubeSearchAutoSuggestBoxStyle}" Text="{Binding YouTubeQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Translate Text='Buscar faixas'}" ToolTip="{loc:Translate Text='Buscar faixas'}" Margin="0" AutomationProperties.Name="{loc:Translate Text='Buscar faixas'}">
            <ui:AutoSuggestBox.Icon>
              <ui:SymbolIcon Symbol="{StaticResource CubeIconSearch24}" FontSize="{DynamicResource CubeIconSizeAction}" Width="20" Height="20" VerticalAlignment="Center"/>
            </ui:AutoSuggestBox.Icon>
          </ui:AutoSuggestBox>
          <ToggleButton x:Name="BackingTrackSearchToggle" Grid.Column="1" IsChecked="{Binding AppendBackingTrack,Mode=TwoWay}" Width="40" Height="40" MinHeight="40" Padding="0" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{loc:Translate Text='Acrescentar backing track ao termo da busca'}" AutomationProperties.Name="{loc:Translate Text='Acrescentar backing track ao termo da busca'}">
            <ToggleButton.Style>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Setter Property="AutomationProperties.ItemStatus" Value="{loc:Translate Text='Desligado'}"/>
                <Style.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CubeSelected}"/>
                    <Setter Property="Foreground" Value="{DynamicResource CubeSelectedText}"/>
                    <Setter Property="AutomationProperties.ItemStatus" Value="{loc:Translate Text='Ligado'}"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ToggleButton.Style>
            <Grid Width="24" Height="24">
              <ui:SymbolIcon Symbol="{StaticResource CubeIconHeadphonesSoundWave24}" FontSize="{DynamicResource CubeIconSizeAction}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border Background="{DynamicResource CubeAccent}" CornerRadius="5" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding IsChecked,ElementName=BackingTrackSearchToggle,Converter={StaticResource Visible}}">
                <ui:SymbolIcon Symbol="{StaticResource CubeIconCheckmark24}" FontSize="8" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
              </Border>
            </Grid>
          </ToggleButton>
        </Grid>
        <TextBlock Text="{loc:Translate Text='Passe o mouse ou clique para pré-ouvir até 30 s'}" Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,8">
          <TextBlock Text="{loc:Translate Value={Binding YouTubeDownloadFolderLabel}}" ToolTip="{Binding YouTubeDownloadFolder}" Style="{StaticResource HelpText}" MaxWidth="240" TextTrimming="None" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,4"/>
          <ui:Button Content="{loc:Translate Text='Alterar pasta'}" Command="{Binding ChangeYouTubeDownloadFolder}" Margin="0,0,0,4"/>
        </WrapPanel>
        <local:LiveStatusText Text="{loc:Translate Value={Binding YouTubeFolderStatus}}" Style="{StaticResource HelpText}" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{loc:Translate Value={Binding YouTubeStatus}}" Style="{StaticResource HelpText}" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar Style="{StaticResource InfiniteProgressBar}" Visibility="{Binding YouTubeSearching,Converter={StaticResource Visible}}"/>
        <ScrollViewer x:Name="BackingYouTubeScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowYouTube,Converter={StaticResource Visible}}">
          <ItemsControl x:Name="YouTubeMosaic" ItemsSource="{Binding PresentedYouTubeResults}" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <local:YouTubeResultCard Model="{Binding DataContext,RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
