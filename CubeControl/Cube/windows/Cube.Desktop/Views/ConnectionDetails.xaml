<UserControl x:Class="Cube.Desktop.Views.ConnectionDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Cube.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <StackPanel><TextBlock x:Name="InputPortLabel" Text="{loc:Translate Text='Entrada USB-MIDI'}" Margin="0,0,0,8" Style="{StaticResource BodyText}"/><ComboBox x:Name="InputPort" AutomationProperties.LabeledBy="{Binding ElementName=InputPortLabel}" AutomationProperties.Name="{loc:Translate Text='Entrada USB-MIDI'}" ItemsSource="{Binding Connection.Inputs}" SelectedItem="{Binding Connection.Input}" IsEnabled="{Binding CanConnect}"/><TextBlock x:Name="OutputPortLabel" Text="{loc:Translate Text='Saída USB-MIDI'}" Margin="0,18,0,8" Style="{StaticResource BodyText}"/><ComboBox x:Name="OutputPort" AutomationProperties.LabeledBy="{Binding ElementName=OutputPortLabel}" AutomationProperties.Name="{loc:Translate Text='Saída USB-MIDI'}" ItemsSource="{Binding Connection.Outputs}" SelectedItem="{Binding Connection.Output}" IsEnabled="{Binding CanConnect}"/><WrapPanel Margin="0,22,0,0"><ui:Button Content="{loc:Translate Text='Buscar USB'}" Command="{Binding RefreshPorts}"><ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconSearch24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon></ui:Button><ui:Button Content="{loc:Translate Text='Conectar'}" Command="{Binding Connect}"><ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconPlugConnected24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon></ui:Button><ui:Button Content="{loc:Translate Text='Desconectar'}" Command="{Binding Disconnect}"><ui:Button.Icon><ui:SymbolIcon Symbol="{StaticResource CubeIconPlugDisconnected24}" FontSize="{DynamicResource CubeIconSizeAction}"/></ui:Button.Icon></ui:Button></WrapPanel><TextBlock Text="{loc:Translate Value={Binding Status}}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,18,0,0" Style="{StaticResource BodyText}"/></StackPanel>
</UserControl>
