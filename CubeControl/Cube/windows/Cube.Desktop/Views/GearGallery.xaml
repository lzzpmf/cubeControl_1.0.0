<UserControl x:Class="Cube.Desktop.Views.GearGallery" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Cube.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Cube.Desktop.Controls">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="{loc:Translate Text='Dê um clique duplo no equipamento para aplicar ao preset em edição, ou selecione e use Aplicar seleção.'}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Style="{StaticResource BodyText}"/>
   <ListBox x:Name="Filter" SelectionChanged="FilterChanged" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,12,0,0" HorizontalAlignment="Left" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Translate Text='Categoria'}">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem" BasedOn="{StaticResource CubeSelectionButtonStyle}">
      <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,4"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="72"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
     </Style>
    </ListBox.ItemContainerStyle>
   </ListBox>
  </StackPanel>
  <ListBox x:Name="Items" Grid.IsSharedSizeScope="True" AutomationProperties.Name="{loc:Translate Text='Equipamentos'}" MouseDoubleClick="ApplyDoubleClick" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectionTile}"><Setter Property="AutomationProperties.Name" Value="{loc:Translate Value={Binding Name}}"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Width="190" Margin="0,0,0,10" ToolTip="{loc:Translate Value={Binding Description}}"><local:GearArt Kind="{Binding Kind}" Accent="{Binding Color}" Image="{Binding Image}" Height="135" Margin="6,6,6,4"/><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="EquipmentName"/></Grid.RowDefinitions><TextBlock Text="{loc:Translate Value={Binding Name}}" TextWrapping="Wrap" Margin="0,10,0,6" Style="{StaticResource BodyText}"/></Grid><StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="{loc:Translate Text='Este amp ser? gravado no pedal, substituindo o amp do slot selecionado ap?s confirma??o.'}" AutomationProperties.HelpText="{loc:Translate Text='Este amp ser? gravado no pedal, substituindo o amp do slot selecionado ap?s confirma??o.'}">
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RequiresUpload}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <TextBlock Text="{loc:Translate Text='Gravar no pedal'}" Style="{StaticResource SelectionSecondaryText}"/>
   </StackPanel><TextBlock Text="{loc:Translate Value={Binding Subtitle}}" Style="{StaticResource SelectionSecondaryText}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </Grid>
</UserControl>
