<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/accent"/>
            <corners android:radius="4dp"/>
            <gradient
                android:startColor="#000000"
                android:endColor="@color/accent"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="130dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/dominantHueEnable"/>
            <corners android:radius="4dp"/>
            <gradient
                android:startColor="#000000"
                android:endColor="@color/dominantHueEnable"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="130dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/accent"/>
            <corners android:radius="4dp"/>
            <gradient
                android:startColor="#000000"
                android:endColor="@color/accent"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="130dp"/>
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/accent"/>
            <corners android:radius="4dp"/>
            <gradient
                android:startColor="#000000"
                android:endColor="@color/accent"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="130dp"/>
        </shape>
    </item>
</selector>
