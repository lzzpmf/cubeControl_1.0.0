<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/background"
    android:padding="@dimen/padding_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.cubeSuite.customControl.ButtonIconView
        android:textSize="@dimen/big_text"
        android:id="@+id/back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back"
        style="@style/labelButton"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/trs_interface"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:src="@drawable/trs_interface2"
        android:contentDescription="@string/undefined"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:id="@+id/expressionPedal"
            android:background="@drawable/bg_accent"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:src="@drawable/expression_pedal"
            android:layout_weight="1"
            android:contentDescription="@string/undefined"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/trsMidi"
            android:background="@drawable/bg_click_effect"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:src="@drawable/trs_midi"
            android:layout_weight="1"
            android:contentDescription="@string/undefined"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <TextView
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Polarity Reversal"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/polarity_but"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:trackTint="@color/gary"/>
    </LinearLayout>
</LinearLayout>
