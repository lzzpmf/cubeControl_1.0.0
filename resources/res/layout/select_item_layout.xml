<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/background"
    android:padding="@dimen/padding_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/clickContent"
            android:background="@drawable/btn_dominant"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_default"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/dominantHue"
                android:gravity="center_vertical"
                android:id="@+id/tvTitle"
                android:padding="9dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/undefined"
                android:layout_weight="1"/>
            <com.cubeSuite.customControl.TextIconView
                android:textColor="@color/dominantHue"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/angleRight"
                android:layout_weight="6"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="7">
            <com.cubeSuite.customControl.ButtonIconView
                android:layout_gravity="center"
                android:id="@+id/btnInfo"
                android:text="@string/infoIcon"
                style="@style/iconBtn"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/medium_text"
        android:textColor="@color/dominantHue"
        android:id="@+id/tvInfo"
        android:visibility="gone"
        android:text="@string/undefined"
        android:layout_marginStart="@dimen/margin_default"
        android:layout_marginEnd="@dimen/margin_default"
        style="@style/generalText"/>
</LinearLayout>
