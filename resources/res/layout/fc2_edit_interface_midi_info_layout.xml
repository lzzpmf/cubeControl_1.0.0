<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/background"
    android:padding="@dimen/padding_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/dominantHue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editMidi"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.cubeSuite.customControl.ButtonIconView
                android:textSize="@dimen/big_text"
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                style="@style/labelButton"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textColor="@color/dominantHue"
        android:id="@+id/tvMidiInfo"
        android:padding="@dimen/padding_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/undefined"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_default"
        android:layout_marginBottom="@dimen/margin_default">
        <TextView
            android:textColor="@color/dominantHue"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/channel"
            android:layout_weight="5"/>
        <Button
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/channel"
            android:layout_width="match_parent"
            android:text="@string/step"
            android:layout_weight="1"
            style="@style/textBtn"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_default"
        android:layout_marginBottom="@dimen/margin_default">
        <TextView
            android:textColor="@color/dominantHue"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvIType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/data1"
            android:layout_weight="5"/>
        <Button
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/numType"
            android:layout_width="match_parent"
            android:text="@string/data1"
            android:layout_weight="1"
            style="@style/textBtn"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_default"
        android:layout_marginBottom="@dimen/margin_default">
        <TextView
            android:textColor="@color/dominantHue"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvIData1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/data2Min"
            android:layout_weight="5"/>
        <Button
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/data1"
            android:layout_width="match_parent"
            android:text="@string/data1"
            android:layout_weight="1"
            style="@style/textBtn"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_default"
        android:layout_marginBottom="@dimen/margin_default">
        <TextView
            android:textColor="@color/dominantHue"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvIData2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/data2Max"
            android:layout_weight="5"/>
        <Button
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/data2"
            android:layout_width="match_parent"
            android:text="@string/data2"
            android:layout_weight="1"
            style="@style/textBtn"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_default"
            android:text="@string/cancel"
            style="@style/textBtn"/>
        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_default"
            android:text="@string/save"
            style="@style/textBtn"/>
    </LinearLayout>
    <com.cubeSuite.customControl.NumKeyPadView
        android:id="@+id/numKeyPad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
