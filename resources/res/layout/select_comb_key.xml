<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/transparency"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_hollow_fillet_dominant_hue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_left"
        android:paddingEnd="@dimen/padding_right">
        <com.cubeSuite.customControl.TextIconView
            android:textSize="@dimen/big_text"
            android:textColor="@color/accent"
            android:gravity="center_horizontal"
            android:id="@+id/title"
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/undefined"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="80dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/dominantHue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/combo1"
                android:layout_centerVertical="true"/>
            <androidx.appcompat.widget.AppCompatSpinner
                android:entries="@array/comb_csa"
                android:id="@+id/comb1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="80dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/dominantHue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/combo2"
                android:layout_centerVertical="true"/>
            <androidx.appcompat.widget.AppCompatSpinner
                android:entries="@array/comb_csa"
                android:id="@+id/comb2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="80dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/dominantHue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/combo3"
                android:layout_centerVertical="true"/>
            <androidx.appcompat.widget.AppCompatSpinner
                android:entries="@array/comb_csa"
                android:id="@+id/comb3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="10dp">
            <Button
                android:id="@+id/close"
                android:text="@string/close"
                style="@style/dialogButton"/>
        </LinearLayout>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/dominantHue"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:text="@string/KeyCombinationError"/>
    </LinearLayout>
</LinearLayout>
