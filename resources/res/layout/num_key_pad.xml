<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/background"
    android:padding="@dimen/padding_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/dominantHue"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.cubeSuite.customControl.ButtonIconView
            android:textSize="@dimen/super_big_text"
            android:layout_gravity="center"
            android:id="@+id/close"
            android:text="@string/down"
            style="@style/numKeyBtn"/>
        <Button
            android:textSize="@dimen/super_big_text"
            android:id="@+id/one"
            android:text="1"
            style="@style/numKeyBtn"/>
        <Button
            android:textSize="@dimen/super_big_text"
            android:id="@+id/two"
            android:text="2"
            style="@style/numKeyBtn"/>
        <Button
            android:textSize="@dimen/super_big_text"
            android:id="@+id/three"
            android:text="3"
            style="@style/numKeyBtn"/>
        <com.cubeSuite.customControl.ButtonIconView
            android:textSize="@dimen/super_big_text"
            android:id="@+id/delete"
            android:text="@string/removeStr"
            style="@style/numKeyBtn"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="@dimen/super_big_text"
            android:id="@+id/four"
            android:text="4"
            style="@style/numKeyBtn"/>
        <Button
            android:textSize="@dimen/super_big_text"
            android:id="@+id/five"
            android:text="5"
            style="@style/numKeyBtn"/>
        <Button
            android:textSize="@dimen/super_big_text"
            android:id="@+id/six"
            android:text="6"
            style="@style/numKeyBtn"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="@dimen/super_big_text"
            android:id="@+id/seven"
            android:text="7"
            style="@style/numKeyBtn"/>
        <Button
            android:textSize="@dimen/super_big_text"
            android:id="@+id/eight"
            android:text="8"
            style="@style/numKeyBtn"/>
        <Button
            android:textSize="@dimen/super_big_text"
            android:id="@+id/nine"
            android:text="9"
            style="@style/numKeyBtn"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="@dimen/small_text"
            android:layout_gravity="center"
            android:visibility="invisible"
            style="@style/numKeyBtn"/>
        <Button
            android:textSize="@dimen/super_big_text"
            android:id="@+id/zero"
            android:text="0"
            style="@style/numKeyBtn"/>
        <Button
            android:textSize="@dimen/small_text"
            android:layout_gravity="center"
            android:visibility="invisible"
            style="@style/numKeyBtn"/>
    </LinearLayout>
</LinearLayout>
