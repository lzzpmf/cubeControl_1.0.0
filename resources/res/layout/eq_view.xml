<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/eq_view_0"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.cubeSuite.customControl.EQPic
        android:id="@+id/eqPic"
        android:layout_width="match_parent"
        android:layout_height="300px"/>
    <RelativeLayout
        android:background="@drawable/irbox_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="5dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <TextView
            android:textColor="@color/dominantHue"
            android:id="@+id/enable_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enable_eq"
            android:layout_centerVertical="true"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/enable_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/switch_thum"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/enable_tv"
            app:track="@drawable/switch_track"/>
        <Button
            android:textColor="@color/dominantHue"
            android:id="@+id/reset_but"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:text="Reset"
            android:layout_centerVertical="true"
            android:textAllCaps="false"
            android:layout_alignParentEnd="true"
            style="@style/IRBoxBtn"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@drawable/irbox_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="5dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <TextView
            android:textColor="@color/dominantHue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/peakIndex"
            android:layout_centerVertical="true"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/peak_spinner"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:popupBackground="@color/black"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/irbox_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="5dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <ImageView
            android:id="@+id/hz_minus"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ir_minus"/>
        <TextView
            android:textSize="@dimen/small_text"
            android:textColor="@color/dominantHue"
            android:gravity="center"
            android:id="@+id/hz_text"
            android:layout_width="45dp"
            android:layout_height="wrap_content"/>
        <SeekBar
            android:id="@+id/hz"
            android:layout_width="0dp"
            android:layout_weight="1"
            style="@style/generalSeekBar"/>
        <ImageView
            android:id="@+id/hz_add"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ir_add"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/db_container"
        android:background="@drawable/irbox_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="5dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <ImageView
            android:id="@+id/db_minus"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ir_minus"/>
        <TextView
            android:textSize="@dimen/small_text"
            android:textColor="@color/dominantHue"
            android:gravity="center"
            android:id="@+id/db_text"
            android:layout_width="45dp"
            android:layout_height="wrap_content"/>
        <SeekBar
            android:id="@+id/db"
            android:layout_width="0dp"
            android:layout_weight="1"
            style="@style/generalSeekBar"/>
        <ImageView
            android:id="@+id/db_add"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ir_add"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/q_container"
        android:background="@drawable/irbox_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="5dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <ImageView
            android:id="@+id/q_minus"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ir_minus"/>
        <TextView
            android:textSize="@dimen/small_text"
            android:textColor="@color/dominantHue"
            android:gravity="center"
            android:id="@+id/q_text"
            android:layout_width="45dp"
            android:layout_height="wrap_content"/>
        <SeekBar
            android:id="@+id/q"
            android:layout_width="0dp"
            android:layout_weight="1"
            style="@style/generalSeekBar"/>
        <ImageView
            android:id="@+id/q_add"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ir_add"/>
    </LinearLayout>
</LinearLayout>
