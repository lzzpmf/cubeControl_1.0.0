<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/background"
    android:padding="@dimen/padding_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:src="@drawable/ble_pad_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.cubeSuite.customControl.ButtonIconView
            android:id="@+id/trsMidi"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="@string/toggle"
            android:layout_marginEnd="50dp"
            style="@style/iconBtn"/>
        <ImageButton
            android:id="@+id/updatePedalParam"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/pedal"
            android:scaleType="centerCrop"
            style="@style/iconBtn"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvModelExplain"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:layout_marginTop="@dimen/margin_default"
        android:layout_marginBottom="18dp"
        android:text="@string/programSwitchA1Explain"
        style="@style/descriptorText"/>
    <com.contrarywind.view.WheelView
        android:id="@+id/modeSelect"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintBottom_toTopOf="@+id/customKeypadContainer"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvModelExplain"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="18dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/customKeypadModeView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <Button
                    android:id="@+id/customKeypadKey1"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchA"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/customKeypadKey2"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchB"
                    style="@style/customModeBtn"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <Button
                    android:id="@+id/customKeypadKey3"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchC"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/customKeypadKey4"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchD"
                    style="@style/customModeBtn"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/newCustomKeyboardView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <androidx.appcompat.widget.AppCompatSpinner
                    android:entries="@array/fc2_preset_arr"
                    android:id="@+id/custom_key_spinner"
                    android:background="@drawable/spinner_selector"
                    style="@style/newSpinnerStyle"/>
                <Button
                    android:id="@+id/keyB"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchB"
                    style="@style/customModeBtn"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <Button
                    android:id="@+id/keyC"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchC"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/keyD"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchD"
                    style="@style/customModeBtn"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/advancedCustomKeypadContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <Button
                    android:id="@+id/footSwitchA"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchA"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/footSwitchB"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchB"
                    style="@style/customModeBtn"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <Button
                    android:id="@+id/footSwitchC"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchC"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/footSwitchD"
                    android:layout_margin="10dp"
                    android:text="@string/footSwitchD"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/padInterface"
                    android:visibility="gone"
                    android:layout_margin="10dp"
                    android:text="@string/padInterface"
                    style="@style/customModeBtn"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/customKeypadContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="35dp">
                <com.cubeSuite.customControl.ButtonIconView
                    android:id="@+id/midiChannelMinus"
                    android:text="@string/minus"
                    style="@style/iconBtn"/>
                <TextView
                    android:textColor="@color/dominantHue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sendMidiChannel"
                    android:layout_marginStart="3dp"/>
                <TextView
                    android:textColor="@color/dominantHue"
                    android:id="@+id/sendMidiChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginEnd="3dp"/>
                <com.cubeSuite.customControl.ButtonIconView
                    android:id="@+id/midiChannelPlus"
                    android:text="@string/plus"
                    style="@style/iconBtn"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="7dp">
                    <Button
                        android:id="@+id/customKeypad1"
                        android:text="@string/undefined"
                        style="@style/customModeBtn"/>
                    <TextView
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/footSwitchA"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="7dp">
                    <Button
                        android:id="@+id/customKeypad2"
                        android:text="@string/undefined"
                        style="@style/customModeBtn"/>
                    <TextView
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/footSwitchB"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="7dp">
                    <Button
                        android:id="@+id/customKeypad3"
                        android:text="@string/undefined"
                        style="@style/customModeBtn"/>
                    <TextView
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/footSwitchC"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="7dp">
                    <Button
                        android:id="@+id/customKeypad4"
                        android:text="@string/undefined"
                        style="@style/customModeBtn"/>
                    <TextView
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/footSwitchD"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="7dp">
                    <Button
                        android:id="@+id/customKeypad5"
                        android:text="@string/undefined"
                        style="@style/customModeBtn"/>
                    <TextView
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pedal"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
