<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:tag="layout/ir_box_contorl_fragment_0"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/irbox_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="5dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <TextView
            android:textColor="@color/dominantHue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Function"
            android:layout_centerVertical="true"/>
        <Button
            android:textColor="@color/dominantHue"
            android:id="@+id/syn_but"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:text="Syn"
            android:layout_centerVertical="true"
            android:textAllCaps="false"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/save_but"
            style="@style/IRBoxBtn"/>
        <Button
            android:textColor="@color/dominantHue"
            android:id="@+id/save_but"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:text="Save"
            android:layout_centerVertical="true"
            android:textAllCaps="false"
            android:layout_alignParentEnd="true"
            style="@style/IRBoxBtn"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:background="@drawable/irbox_bg"
        android:padding="@dimen/padding_default"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <TextView
            android:textColor="@color/dominantHue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preset"
            android:layout_centerVertical="true"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/effect_spinner"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:popupBackground="@color/black"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:background="@drawable/irbox_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="5dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/type_radio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/ir_radio">
            <RadioButton
                android:textColor="@color/dominantHue"
                android:gravity="center"
                android:id="@+id/ir_radio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/irEdit"
                android:layout_weight="1"
                android:buttonTint="@color/dominantHue"/>
            <RadioButton
                android:textColor="@color/dominantHue"
                android:gravity="center"
                android:id="@+id/eq_radio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/eqEdit"
                android:layout_weight="1"
                android:buttonTint="@color/dominantHue"/>
        </RadioGroup>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ir_edit"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/irbox_bg"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="5dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">
                <RelativeLayout
                    android:padding="@dimen/padding_default"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/dominantHue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enableIr"
                        android:layout_centerVertical="true"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_ir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thum"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:track="@drawable/switch_track"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ir_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:background="@drawable/irbox_bg"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="5dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">
                    <TextView
                        android:textColor="@color/dominantHue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/irVolume"/>
                    <TextView
                        android:textColor="@color/dominantHue"
                        android:gravity="center"
                        android:id="@+id/ir_vol_text"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:id="@+id/vol_minus"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ir_minus"/>
                    <SeekBar
                        android:id="@+id/irVolumeSeek"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/generalSeekBar"/>
                    <ImageView
                        android:id="@+id/vol_add"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ir_add"/>
                </LinearLayout>
                <Button
                    android:textColor="@color/dominantHue"
                    android:id="@+id/open_file_but"
                    android:background="@color/transparency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/openIrFile"
                    android:layout_marginStart="15dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ir_rv"
                    android:background="@drawable/rv_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/edit_eq_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:padding="@dimen/padding_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/dominantHue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_eq"
                    android:layout_centerVertical="true"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_eq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/switch_thum"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:track="@drawable/switch_track"/>
            </RelativeLayout>
            <com.cubeSuite.customControl.EqView
                android:id="@+id/eq_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
