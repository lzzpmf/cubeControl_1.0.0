<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/main"
    android:background="@color/background"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:src="@drawable/looper_drum"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/showMakeDrum"
                android:layout_height="30dp"
                android:layout_margin="@dimen/margin_default"
                android:text="@string/makDrum"
                style="@style/generalBtn"/>
            <Button
                android:id="@+id/resetFactory"
                android:layout_height="30dp"
                android:layout_margin="@dimen/margin_default"
                android:text="@string/resetFactory"
                style="@style/generalBtn"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/copyAllDrum"
                android:layout_height="30dp"
                android:layout_margin="@dimen/margin_default"
                android:text="@string/copyAllDrum"
                style="@style/generalBtn"/>
            <Button
                android:id="@+id/pasteAllDrum"
                android:layout_height="30dp"
                android:layout_margin="@dimen/margin_default"
                android:text="@string/pasteAllDrum"
                style="@style/generalBtn"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/dominantHue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/volume"/>
                <TextView
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/white"
                    android:id="@+id/volumeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="9dp"
                android:max="127"
                android:progressDrawable="@drawable/seek_bar_background"
                android:minHeight="9dp"
                android:thumb="@drawable/seek_bar_thumb"
                android:splitTrack="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/dominantHue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sst"/>
                <TextView
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/white"
                    android:id="@+id/gateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="9dp"
                android:max="127"
                android:progressDrawable="@drawable/seek_bar_background"
                android:minHeight="9dp"
                android:thumb="@drawable/seek_bar_thumb"
                android:splitTrack="false"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
