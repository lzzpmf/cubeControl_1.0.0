<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_click_effect"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:layout_weight="0.4">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="center"
            android:id="@+id/effect_unit_img"
            android:padding="@dimen/padding_default"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:contentDescription="@string/undefined"/>
        <TextView
            android:textSize="@dimen/medium_text"
            android:textColor="@color/disable"
            android:gravity="center"
            android:id="@+id/needPair"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/undefined"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/medium_text"
        android:textColor="@color/dominantHue"
        android:gravity="center_horizontal"
        android:id="@+id/effect_unit_text"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TextView"/>
</LinearLayout>
