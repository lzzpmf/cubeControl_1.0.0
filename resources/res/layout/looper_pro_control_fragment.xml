<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_gradual"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/padding_left"
    android:paddingEnd="@dimen/padding_right">
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="220dp"
        android:src="@drawable/looper_pro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/halving1"
        android:background="@drawable/halving_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/halving1">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/dominantHue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/volume"/>
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/white"
                android:id="@+id/volumeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
        </LinearLayout>
        <SeekBar
            android:id="@+id/volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="9dp"
            android:max="127"
            android:progressDrawable="@drawable/seek_bar_background"
            android:minHeight="9dp"
            android:thumb="@drawable/seek_bar_thumb"
            android:splitTrack="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="7dp"
        app:layout_constraintBottom_toTopOf="@+id/customKeypadContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.281"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/dominantHue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sst"/>
            <TextView
                android:textSize="@dimen/big_text"
                android:textColor="@color/white"
                android:id="@+id/gateValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
        </LinearLayout>
        <SeekBar
            android:id="@+id/gate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="9dp"
            android:max="127"
            android:progressDrawable="@drawable/seek_bar_background"
            android:minHeight="9dp"
            android:thumb="@drawable/seek_bar_thumb"
            android:splitTrack="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/customKeypadContainer"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="70dp">
            <com.cubeSuite.customControl.ButtonIconView
                android:id="@+id/on"
                android:text="@string/onIcon"
                android:layout_marginEnd="@dimen/big_ico_margin"
                style="@style/bigIconBtn"/>
            <com.cubeSuite.customControl.ButtonIconView
                android:id="@+id/next"
                android:text="@string/nextIcon"
                android:layout_marginStart="@dimen/big_ico_margin"
                style="@style/bigIconBtn"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="70dp">
            <com.cubeSuite.customControl.ButtonIconView
                android:id="@+id/stop"
                android:text="@string/stopIcon"
                android:layout_marginEnd="@dimen/big_ico_margin"
                style="@style/bigIconBtn"/>
            <com.cubeSuite.customControl.ButtonIconView
                android:id="@+id/syncGate"
                android:text="@string/syncGateIcon"
                android:layout_marginStart="@dimen/big_ico_margin"
                style="@style/bigIconBtn"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
