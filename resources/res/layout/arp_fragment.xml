<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/arp_fragment_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/margin_default">
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/mode"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/arpMode"
            android:id="@+id/mode"
            android:tag="binding_1"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/octive"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/Arr1234"
            android:id="@+id/octive"
            android:tag="binding_2"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:layout_gravity="center"
            android:text="@string/gate"
            style="@style/midikeyboardItemText"/>
        <EditText
            android:id="@+id/gate"
            android:tag="binding_3"
            android:hint="@string/_0_100"
            style="@style/numInputStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:layout_gravity="center"
            android:text="@string/swing"
            style="@style/midikeyboardItemText"/>
        <EditText
            android:id="@+id/swing"
            android:tag="binding_4"
            android:hint="@string/_0_75"
            style="@style/numInputStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/latch"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/latch"
            android:tag="binding_5"
            style="@style/switchStyle.external"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/time"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.AppCompatSpinner
            android:entries="@array/ArrTime"
            android:id="@+id/time"
            android:tag="binding_6"
            style="@style/meSpinnerStyle"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:text="@string/sync"
            style="@style/midikeyboardItemText"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sync"
            android:tag="binding_7"
            style="@style/switchStyle.external"/>
    </LinearLayout>
    <LinearLayout style="@style/linearStyle">
        <TextView
            android:layout_gravity="center"
            android:text="@string/tempo"
            style="@style/midikeyboardItemText"/>
        <EditText
            android:id="@+id/tempo"
            android:tag="binding_8"
            android:hint="@string/_0_300"
            style="@style/numInputStyle"/>
    </LinearLayout>
</LinearLayout>
