<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/background"
    android:padding="@dimen/padding_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="@dimen/text_16sp"
            android:textColor="@color/dominantHue"
            android:id="@+id/foot_ctrl_import"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/import_file"
            android:textAllCaps="false"
            android:layout_marginEnd="5dp"
            style="@style/IRBoxBtn"/>
        <Button
            android:textSize="@dimen/text_16sp"
            android:textColor="@color/dominantHue"
            android:id="@+id/foot_ctrl_export"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/export_file"
            android:textAllCaps="false"
            android:layout_marginEnd="5dp"
            style="@style/IRBoxBtn"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:src="@drawable/foot_ctrl_plus"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.cubeSuite.customControl.ButtonIconView
            android:id="@+id/trsMidi"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="@string/toggle"
            android:layout_marginEnd="50dp"
            style="@style/iconBtn"/>
        <ImageButton
            android:id="@+id/updatePedalParam"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/pedal"
            android:scaleType="centerCrop"
            style="@style/iconBtn"/>
    </LinearLayout>
    <TextView
        android:id="@+id/mode_explain_tv"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:layout_marginTop="@dimen/margin_default"
        android:layout_marginBottom="18dp"
        android:text="@string/programSwitchA1Explain"
        style="@style/descriptorText"/>
    <com.contrarywind.view.WheelView
        android:id="@+id/modeSelect"
        android:layout_width="match_parent"
        android:layout_height="200dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="18dp">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/maxGroupCountContainer31"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max Group Count"
                    android:layout_marginEnd="10dp"/>
                <LinearLayout
                    android:background="@color/dominantHue"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/maxGroupCountSpinner31"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bank Midi"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/midiSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/switch_thumb_colors"
                    app:trackTint="@color/switch_track_colors"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/pcdispContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pc display"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/pcdispSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/switch_thumb_colors"
                    app:trackTint="@color/switch_track_colors"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/customKeyboardView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <Button
                    android:id="@+id/keyA"
                    android:text="@string/footSwitchA"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/keyB"
                    android:text="@string/footSwitchB"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    style="@style/customModeBtn"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <Button
                    android:id="@+id/keyC"
                    android:text="@string/footSwitchC"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/keyD"
                    android:text="@string/footSwitchD"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    style="@style/customModeBtn"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:background="@color/dominantHue"
                android:layout_width="100dp"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/custom_key_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/advancedCustomMode1View"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/maxGroupCountContainer15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max Group Count"
                    android:layout_marginEnd="10dp"/>
                <LinearLayout
                    android:background="@color/dominantHue"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/maxGroupCountSpinner15"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <Button
                    android:id="@+id/advancedCustomMode1But1"
                    android:text="@string/footSwitchA"
                    android:layout_marginEnd="10dp"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/advancedCustomMode1But2"
                    android:text="@string/footSwitchB"
                    style="@style/customModeBtn"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/advancedCustomMode1But3"
                    android:text="@string/footSwitchC"
                    android:layout_marginEnd="10dp"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/advancedCustomMode1But4"
                    android:text="@string/footSwitchD"
                    style="@style/customModeBtn"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Group"
                    android:layout_marginEnd="10dp"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:background="@color/dominantHue"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/advancedCustomMode1Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mixKeyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <Button
                    android:id="@+id/advancedCustomMode2But1"
                    android:text="@string/footSwitchA"
                    android:layout_marginEnd="10dp"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/advancedCustomMode2But2"
                    android:text="@string/footSwitchB"
                    style="@style/customModeBtn"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/advancedCustomMode2But3"
                    android:text="@string/footSwitchC"
                    android:layout_marginEnd="10dp"
                    style="@style/customModeBtn"/>
                <Button
                    android:id="@+id/advancedCustomMode2But4"
                    android:text="@string/footSwitchD"
                    style="@style/customModeBtn"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Group"
                    android:layout_marginEnd="10dp"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:background="@color/dominantHue"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/mixKeyModeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/customControlView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.cubeSuite.customControl.ButtonIconView
                    android:id="@+id/midiChannelMinus"
                    android:text="@string/minus"
                    style="@style/iconBtn"/>
                <TextView
                    android:textColor="@color/dominantHue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sendMidiChannel"
                    android:layout_marginStart="3dp"/>
                <TextView
                    android:textColor="@color/dominantHue"
                    android:id="@+id/sendMidiChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginEnd="3dp"/>
                <com.cubeSuite.customControl.ButtonIconView
                    android:id="@+id/midiChannelPlus"
                    android:text="@string/plus"
                    style="@style/iconBtn"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp">
                    <Button
                        android:id="@+id/customControlBut1"
                        android:text="@string/undefined"
                        style="@style/customModeBtn"/>
                    <TextView
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/footSwitchA"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp">
                    <Button
                        android:id="@+id/customControlBut2"
                        android:text="@string/undefined"
                        style="@style/customModeBtn"/>
                    <TextView
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/footSwitchB"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp">
                    <Button
                        android:id="@+id/customControlBut3"
                        android:text="@string/undefined"
                        style="@style/customModeBtn"/>
                    <TextView
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/footSwitchC"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp">
                    <Button
                        android:id="@+id/customControlBut4"
                        android:text="@string/undefined"
                        style="@style/customModeBtn"/>
                    <TextView
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/footSwitchD"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp">
                    <Button
                        android:id="@+id/customControlBut5"
                        android:text="@string/undefined"
                        style="@style/customModeBtn"/>
                    <TextView
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pedal"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
